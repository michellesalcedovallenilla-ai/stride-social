---
// "Our services" ticker heading + numbered accordion. Copy lives in src/content/data/services.json.
import { getCollection } from 'astro:content';
import Marquee from '../ui/Marquee.astro';

export interface Props {
  heading?: string;
}

const { heading = 'our Services' } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.id.localeCompare(b.id));
---

<section class="services">
  <div class="services__list">
    <div class="services__ticker">
      <Marquee duration={35} gap="2.5rem">
        <h2 class="services__ticker-text">{heading}</h2>
        <span class="services__ticker-text" aria-hidden="true">{heading}</span>
      </Marquee>
    </div>
    {services.map(({ id, data }) => (
      <div class="service" data-accordion>
        <button class="service__top" type="button" aria-expanded="false" aria-controls={`service-${id}`} data-accordion-toggle>
          <span class="service__grid">
            <span class="service__number">
              <span>[&nbsp;</span>
              <span class="service__number-clip">
                <span class="service__number-text">{id}</span>
                <span class="service__number-text service__number-text--next" aria-hidden="true">{id}</span>
              </span>
              <span>&nbsp;]</span>
            </span>
            <span class="service__title">{data.title}</span>
            <span class="service__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M8 0v16M0 8h16" stroke="currentColor" stroke-width="2" fill="none"></path></svg>
            </span>
          </span>
        </button>
        <div class="service__panel" id={`service-${id}`} role="region" data-accordion-panel>
          <div class="service__panel-inner">
          <div class="service__grid service__grid--panel">
            <div class="service__label">Overview</div>
            <div class="service__intro">
              <p class="service__description" set:html={data.description} />
              <ul class="service__bullets">
                {data.bullets.map((b) => (
                  <li>
                    <span class="service__bullet" aria-hidden="true"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .services {
    position: relative;
    z-index: 1;
    padding-top: 2vh;
    font-family: var(--font-sans);
    color: var(--color-navy);
    background-color: var(--color-smoke-2);
  }

  .services__list {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid #e6e6e612;
  }

  .services__ticker {
    display: flex;
    padding-top: 1vw;
    padding-bottom: 2vw;
    overflow: hidden;
    border-top: 1px solid #e6e6e612;
  }

  .services__ticker-text {
    flex: none;
    font-family: var(--font-sans);
    font-size: 10rem;
    font-weight: 900;
    line-height: 0.9;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .service {
    border-top: 1px solid var(--color-line);
  }

  .service__top {
    display: block;
    width: 100%;
    padding: 3.5rem 2.5rem;
    text-align: left;
    background-color: #e6e6e600;
    transition: background-color 0.2s linear;
  }

  .service__top:hover,
  .service.is-open .service__top {
    background-color: var(--color-line);
  }

  .service__grid {
    display: grid;
    grid-template-columns: 1fr 4fr 2rem;
    align-items: start;
    gap: 1rem;
  }

  .service__number,
  .service__label,
  .service__bullets {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-strong);
  }

  .service__number {
    display: flex;
    align-items: center;
    white-space: pre;
  }

  .service__number-clip {
    position: relative;
    display: flex;
    overflow: hidden;
    padding: 1px 0;
  }

  .service__number-text {
    transition: transform 0.35s var(--ease-out);
  }

  .service__number-text--next {
    position: absolute;
    top: 100%;
  }

  .service__top:hover .service__number-text {
    transform: translateY(-100%);
  }

  .service__title {
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 0.8;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .service__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    justify-self: center;
    color: var(--color-navy);
    transition: transform 0.4s var(--ease-out);
  }

  .service.is-open .service__icon {
    transform: rotate(135deg);
  }

  .service__panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.5s var(--ease-out);
  }

  .service.is-open .service__panel {
    grid-template-rows: 1fr;
  }

  .service__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .service__grid--panel {
    padding: 2rem 2.5rem 5rem;
  }

  .service__intro {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2.5rem;
  }

  .service__description {
    max-width: 36rem;
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--color-navy-mute);
  }

  .service__bullets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .service__bullets li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0;
  }

  .service__bullet {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 100rem;
    background-color: var(--accent);
  }

  @media screen and (max-width: 991px) {
    .services__ticker {
      padding-top: 2vw;
      padding-bottom: 3vw;
    }

    .service__top {
      padding: 2.75rem 1.625rem;
    }

    .service__grid {
      grid-template-columns: 1fr 2rem;
    }

    .service__grid--panel {
      padding-inline: 1.625rem;
    }

    .service__number {
      grid-column: 1 / -1;
    }

    .service__title {
      font-size: 2.8rem;
      line-height: 0.9;
    }

    .service__intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .services__ticker {
      padding-top: 3vw;
      padding-bottom: 4vw;
    }

    .services__ticker-text {
      font-size: 7rem;
    }

    .service__top {
      padding: 2rem 1rem;
    }

    .service__grid--panel {
      padding: 1.5rem 1rem 3.25rem;
    }

    .service__title {
      font-size: 2.5rem;
    }

    .service__description {
      font-size: 1.2rem;
    }

    .service__bullets {
      padding-top: 0.5rem;
    }
  }

  @media screen and (max-width: 479px) {
    .services__ticker-text {
      font-size: 5rem;
    }

    .service__title {
      font-size: 1.6rem;
      line-height: 1;
    }

    .service__description {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-accordion-toggle]');
    toggle?.addEventListener('click', () => {
      const open = !item.classList.contains('is-open');
      item.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
  });
</script>
