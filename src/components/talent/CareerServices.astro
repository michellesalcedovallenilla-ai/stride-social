---
// Stride Talent C3 "YOUR CAREER. OUR COMMITMENT.": a magazine spread. The heading stays put on
// the left while the eight management services scroll past on the right as numbered entries,
// each with one plain sentence. Two candid images of managers with creators are awaited (Q18):
// preview shows labelled frames between the entries, production leaves them out.
import Eyebrow from '../core/Eyebrow.astro';
import DraftTag from '../core/DraftTag.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';

export interface Props {
  copy: { status: 'approved' | 'draft'; eyebrow?: string; headline?: string; items?: { label: string; copy?: string }[] };
}

const { copy } = Astro.props;
const items = copy.items ?? [];
// Candid frames sit after the 3rd and 6th entries.
const frameAfter = new Set([2, 5]);
---

<section class="career" aria-labelledby="career-title">
  <div class="career__inner container-wide">
    <header class="career__head">
      <Eyebrow tone="light">{copy.eyebrow}</Eyebrow>
      <h2 class="career__title" id="career-title" data-reveal-lines>{copy.headline}</h2>
      <DraftTag status={copy.status} />
    </header>

    <ol class="career__list" role="list">
      {items.map((item, i) => (
        <>
          <li class="career__item" data-reveal="rise">
            <span class="career__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="career__name">{item.label}</h3>
            <p class="career__copy">{item.copy}</p>
          </li>
          {isPreview && frameAfter.has(i) && (
            <li class="career__frame" aria-hidden="true">
              <PlaceholderNotice variant="block" label="Awaiting photography">
                <p>A candid photo of a talent manager working with a creator (Q18).</p>
              </PlaceholderNotice>
            </li>
          )}
        </>
      ))}
    </ol>
  </div>
</section>

<style>
  .career {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--white);
    color: var(--navy-900);
  }

  .career__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8) var(--gutter);
    align-items: start;
  }

  .career__head {
    grid-column: 1 / 6;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    position: sticky;
    top: calc(var(--header-h) + var(--division-bar-h) + var(--space-7));
    container-type: inline-size;
  }

  .career__title {
    font-family: var(--font-display);
    font-size: min(11cqi, 6.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.88;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .career__list {
    grid-column: 7 / -1;
    border-top: 1px solid var(--navy-900);
  }

  .career__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line);
  }

  .career__n {
    grid-row: 1 / 3;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    line-height: 2;
    color: var(--accent-ink);
  }

  .career__name {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 2.125rem);
    font-weight: 800;
    font-stretch: 110%;
    line-height: 1.05;
  }

  .career__copy {
    max-width: 46ch;
    color: var(--navy-700);
  }

  .career__frame {
    display: grid;
    align-content: end;
    aspect-ratio: 3 / 2;
    margin: var(--space-6) 0;
    padding: var(--space-4);
    background: var(--peach);
  }

  @media (max-width: 1023px) {
    .career__head,
    .career__list {
      grid-column: 1 / -1;
    }

    .career__head {
      position: static;
    }

    .career__title {
      font-size: min(11cqi, 5rem);
    }
  }
</style>
