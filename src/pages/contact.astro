---
// Contact hub (brief §7: separate paths for brands, established creators, emerging creators and general
// enquiries): a conversation that points you to the right team (group/ContactChat), then the general form.
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import ContactChat from '@/components/group/ContactChat.astro';
import FormStage from '@/components/experience/FormStage.astro';
import GeneralForm from '@/components/group/GeneralForm.astro';
import { careersEmail, enquiryEmail } from '@/config/forms';
import { site, socials } from '@/config/site';

const s = (await getEntry('pages', 'contact'))?.data.sections;
if (!s) throw new Error('Missing src/content/pages/contact.yaml');
const msg = (key: string) => s.general.items?.find((i) => i.key === key)?.label ?? '';
const details = [
  { label: 'Email', links: [{ label: enquiryEmail, href: `mailto:${enquiryEmail}` }] },
  { label: 'Careers', links: [{ label: careersEmail, href: `mailto:${careersEmail}` }] },
  { label: 'Phone', links: [{ label: site.phone.label.replace(/^Office - /, ''), href: site.phone.href }] },
  { label: 'Social', links: socials.map((so) => ({ label: so.label, href: so.href, external: true })) },
];
---

<SiteLayout title="Contact | Stride" description={s.hero.body} headerOverlay>
  <ContactChat copy={s.hero} routes={s.routes.items ?? []} details={details} crumbs={[{ label: 'Contact' }]} />
  <div id="general">
    <FormStage tone="group" look="frost" steps={false} level="h2" eyebrow={s.general.eyebrow} headline={s.general.headline ?? ''} status={s.general.status}>
      <GeneralForm tone="dark" messages={{ success: msg('success'), error: msg('error'), unavailable: msg('unavailable'), consent: msg('consent') }} />
    </FormStage>
  </div>
</SiteLayout>
