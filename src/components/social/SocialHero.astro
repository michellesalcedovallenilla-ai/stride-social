---
// Stride Social B1 (docs/phase-2/05-wireframes.md): navy hero, headline left, a staggered strip of
// three vertical campaign clips right. Phones show one clip full-bleed under the headline.
// Clips play only while the hero is on screen; one control pauses them all (src/scripts/system/clip-strip.ts).
import Button from '../core/Button.astro';
import Eyebrow from '../core/Eyebrow.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';

export interface Props {
  eyebrow?: string;
  lines: string[];
  body: string;
  actions: { label: string; href: string }[];
  clips: { mp4: string; webm?: string; poster: string; label: string }[];
  interim?: boolean;
}

const { eyebrow, lines, body, actions, clips, interim = false } = Astro.props;
---

<section class="s-hero" aria-labelledby="s-hero-title" data-clip-strip>
  <div class="s-hero__strip" aria-hidden="true">
    {clips.slice(0, 3).map((clip, i) => (
      <div class={`s-hero__clip s-hero__clip--${i + 1}`}>
        <video muted loop playsinline preload={i === 0 ? 'auto' : 'none'} poster={clip.poster} aria-label={clip.label}>
          {clip.webm && <source src={clip.webm} type="video/webm" />}
          <source src={clip.mp4} type="video/mp4" />
        </video>
      </div>
    ))}
  </div>
  <div class="s-hero__scrim" aria-hidden="true"></div>
  {interim && <PlaceholderNotice label="Interim footage" class="s-hero__interim">— awaiting the campaign reel</PlaceholderNotice>}

  <div class="s-hero__content container-wide">
    {eyebrow && <Eyebrow tone="dark">{eyebrow}</Eyebrow>}
    <h1 class="s-hero__title" id="s-hero-title" data-reveal-lines="load">
      {lines.map((line, i) => (
        <span class="reveal-line" style={`--line: ${i}`}><span class="reveal-line__inner">{line}</span></span>
      ))}
    </h1>
    <div class="s-hero__aside" data-reveal="load" style="--reveal-delay: 0.45s">
      <p class="s-hero__body">{body}</p>
      <div class="s-hero__actions">
        {actions.map((a, i) => (
          <Button href={a.href} variant={i === 0 ? 'primary' : 'secondary'} tone="dark">{a.label}</Button>
        ))}
      </div>
    </div>
  </div>

  <button class="s-hero__toggle" type="button" data-strip-toggle aria-label="Pause background videos">
    <svg class="s-hero__icon s-hero__icon--pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor"></path></svg>
    <svg class="s-hero__icon s-hero__icon--play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor"></path></svg>
  </button>
</section>

<style>
  .s-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 680px;
    height: 100svh;
    max-height: 1080px;
    overflow: hidden;
    background: var(--navy-900);
    color: var(--white);
  }

  /* Three tall clips on the right, staggered. No transform animation here: Chromium can paint a
     playing video above the fixed header when an ancestor animates its transform. */
  .s-hero__strip {
    position: absolute;
    top: 0;
    right: var(--margin);
    bottom: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    width: min(40vw, 660px);
  }

  .s-hero__clip {
    position: relative;
    align-self: start;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--navy-700);
  }

  .s-hero__clip--1 { margin-top: 22vh; }
  .s-hero__clip--2 { margin-top: 12vh; }
  .s-hero__clip--3 { margin-top: 34vh; }

  .s-hero__clip video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .s-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, var(--navy-900) 0%, rgb(6 20 43 / 0.85) 38%, rgb(6 20 43 / 0.1) 70%),
      linear-gradient(to top, rgb(6 20 43 / 0.9) 0%, rgb(6 20 43 / 0) 40%);
    pointer-events: none;
  }

  .s-hero :global(.s-hero__interim) {
    top: calc(var(--header-h) + var(--division-bar-h) + var(--space-3));
  }

  .s-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-6);
    padding-bottom: calc(var(--space-9) + 8px);
  }

  .s-hero__title {
    max-width: 9.5ch;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 7.4vw, 8.5rem);
    font-weight: 850;
    font-stretch: 118%;
    line-height: 0.86;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  /* The last line is the promise: set it in the division accent. */
  .s-hero__title .reveal-line:last-child {
    color: var(--accent);
  }

  .s-hero__aside {
    display: grid;
    gap: var(--space-6);
    max-width: 520px;
  }

  .s-hero__body {
    font-size: var(--type-lead);
    line-height: 1.4;
    color: rgb(255 255 255 / 0.88);
  }

  .s-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .s-hero__toggle {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background: rgb(6 20 43 / 0.35);
    color: var(--white);
    backdrop-filter: blur(6px);
  }

  .s-hero__icon {
    width: 14px;
    height: 14px;
  }

  .s-hero__icon--play,
  .s-hero.is-paused .s-hero__icon--pause {
    display: none;
  }

  .s-hero.is-paused .s-hero__icon--play {
    display: block;
  }

  @media (max-width: 1023px) {
    .s-hero__strip {
      width: 62vw;
      opacity: 0.75;
    }
  }

  /* Phones: one clip fills the hero, the headline sits on a bottom scrim. */
  @media (max-width: 767px) {
    .s-hero {
      min-height: 640px;
      max-height: none;
    }

    .s-hero__strip {
      inset: 0;
      display: block;
      width: auto;
      opacity: 1;
    }

    .s-hero__clip {
      position: absolute;
      inset: 0;
      align-self: stretch;
      margin: 0;
      aspect-ratio: auto;
    }

    .s-hero__clip--2,
    .s-hero__clip--3 {
      display: none;
    }

    .s-hero__scrim {
      background: linear-gradient(to top, rgb(6 20 43 / 0.95) 0%, rgb(6 20 43 / 0.7) 45%, rgb(6 20 43 / 0.2) 75%, rgb(6 20 43 / 0.35) 100%);
    }

    .s-hero__content {
      gap: var(--space-5);
      padding-bottom: calc(var(--space-8) + 12px);
    }

    .s-hero__title {
      font-stretch: 112%;
      font-size: min(13vw, 5rem);
    }
  }

  @media (max-width: 479px) {
    .s-hero__title {
      font-stretch: 100%;
      font-size: 12.4vw;
    }

    .s-hero__actions > :global(*) {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  import { initClipStrips } from '@/scripts/system/clip-strip';
  initClipStrips();
</script>
