---
// Creator roster: every published creator on a wall you can move (experience/Wall), with live name search
// and category filters kept in the URL (/talent/roster?category=beauty&q=amy). Only published creators
// appear (src/lib/roster.ts); each tile opens the creator's profile.
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Wall from '@/components/experience/Wall.astro';
import EnquiryClose from '@/components/social/EnquiryClose.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { getRoster } from '@/lib/roster';
import { routes } from '@/lib/routes';
import { isPreview } from '@/lib/env';
import Tray from '@/components/experience/Tray.astro';

const roster = await getRoster();
const allCategories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const labels = Object.fromEntries(allCategories.map((c) => [c.id, c.data.label]));
const talent = (await getEntry('pages', 'talent'))?.data.sections;
const copy = talent?.rosterPage;
if (!talent || !copy) throw new Error('Missing rosterPage in src/content/pages/talent.yaml');
const interim = roster.some((c) => c.data.consent.status !== 'confirmed');

const idsOf = (c: (typeof roster)[number]) => [...new Set([c.data.mainCategory?.id, ...c.data.categories.map((x) => x.id)].filter((x): x is string => !!x))];
const groups = [
  {
    key: 'category',
    label: 'Category',
    options: allCategories.map((c) => ({ id: c.id, label: c.data.label, n: roster.filter((r) => idsOf(r).includes(c.id)).length })).filter((o) => o.n > 0),
  },
];
const items = roster.map((c) => ({
  key: c.id,
  name: c.data.name,
  meta: c.data.mainCategory ? labels[c.data.mainCategory.id] : undefined,
  image: c.data.portrait,
  href: routes.creator(c.id),
  filters: { category: idsOf(c).join(' ') },
}));
---

<SiteLayout title="Creator roster | Stride Talent" description={copy.body} division="talent" look="deep" headerOverlay>
  <Wall items={items} groups={groups} copy={copy} noun="creator|creators" tone="talent" look="deep" keep search crumbs={[{ label: 'Stride Talent', href: '/talent' }, { label: 'Roster' }]} />
  {isPreview && interim && <PlaceholderNotice variant="inline" label="Interim profiles">— from the previous site; consent, countries and categories to be confirmed (Q9, Q10)</PlaceholderNotice>}
  <EnquiryClose headline={talent.apply.headline ?? ''} label={talent.hero.items?.[1]?.label ?? 'Apply For Management'} href={talent.hero.items?.[1]?.href ?? '/talent/apply'} tone="talent" look="deep" />
  <Tray list="creators" />
</SiteLayout>
