---
// "Don't just take our word for it": case summary + CTA over a navy grid of results, beside a
// sticky full-height photo (stacks under the numbers on tablets and phones).
import Button from '@/components/ui/Button.astro';

export interface Props {
  heading: string;
  body: string;
  cta: { label: string; href: string };
  statsLabel: string;
  stats: { value: string; label: string; note: string }[];
  image: { src: string; alt: string };
}

const { heading, body, cta, statsLabel, stats, image } = Astro.props;
---

<section class="proof">
  <div class="proof__grid">
    <div class="proof__side">
      <div class="proof__content">
        <div class="proof__title">
          <h2 class="proof__heading">{heading}</h2>
          <p class="proof__body">{body}</p>
          <div class="proof__cta">
            <Button href={cta.href} variant="dark">{cta.label}</Button>
          </div>
        </div>
        <div class="proof__subtitle">
          <span>{statsLabel}</span>
          <img src="/assets/site/77259a99-boston-corner-right-down.svg" alt="" width="13" height="13" loading="lazy" />
        </div>
      </div>
      <div class="proof__stats">
        {stats.map((s) => (
          <div class="proof__stat">
            <p class="proof__value">{s.value}</p>
            <div class="proof__stack">
              <p class="proof__label">{s.label}</p>
              <p class="proof__note">{s.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="proof__image">
      <img class="cover-image" src={image.src} alt={image.alt} loading="lazy" decoding="async" />
      <span class="proof__overlay" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .proof {
    position: relative;
    z-index: 1;
    padding-bottom: 8rem;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
    background-color: var(--color-smoke);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .proof__side {
    overflow: clip;
  }

  .proof__content {
    padding: 4rem 45px 0;
  }

  .proof__title {
    max-width: 30rem;
    margin-bottom: 1rem;
  }

  .proof__heading {
    margin-bottom: 3rem;
    font-family: var(--font-alt);
    font-size: 4rem;
    font-weight: 400;
    line-height: 0.89;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .proof__body {
    /* the live page follows the copy with an empty paragraph (one line of space) */
    padding-bottom: 1.4em;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .proof__cta {
    display: flex;
  }

  .proof__subtitle {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-top: 25%;
    padding-bottom: 1.1rem;
    font-size: 1rem;
    line-height: 20px;
    color: var(--color-text);
  }

  .proof__subtitle img {
    width: 0.8rem;
    height: 0.8rem;
  }

  .proof__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: -1px;
    margin-left: -1px;
  }

  .proof__stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 4rem;
    padding: 3.5rem 2rem 3.5rem 3.5vw;
    outline: 1px solid #eeeeee1a;
    outline-offset: -0.5px;
    font-family: var(--font-sans);
    color: #fff;
    background-color: #1a1f3a;
  }

  .proof__value {
    font-size: 2.5rem;
    line-height: 1;
  }

  .proof__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    max-width: 16rem;
  }

  .proof__label,
  .proof__note {
    font-size: 1.2rem;
    line-height: 20px;
  }

  .proof__label {
    font-weight: 500;
  }

  .proof__note {
    color: #ffffff85;
  }

  .proof__image {
    position: sticky;
    top: 0;
    z-index: 5;
    max-height: 100vh;
    overflow: hidden;
  }

  .proof__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: #0000001a;
  }

  @media screen and (max-width: 991px) {
    .proof__grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .proof__subtitle {
      padding-top: 6rem;
    }

    .proof__stat {
      padding: 2.25rem 1.5rem;
    }

    .proof__image {
      position: relative;
      min-height: 100vw;
    }
  }

  @media screen and (max-width: 767px) {
    .proof {
      border-top-style: none;
    }

    .proof__content {
      padding: 3rem 1rem 0;
    }

    .proof__title {
      max-width: 25rem;
    }

    .proof__subtitle {
      padding-top: 4rem;
    }

    .proof__stats {
      grid-template-columns: 1fr;
    }

    .proof__stat {
      gap: 2.25rem;
      padding: 2rem 1.25rem;
    }

    .proof__image {
      min-height: 80vw;
    }
  }

  @media screen and (max-width: 479px) {
    .proof__grid {
      gap: 0;
    }

    .proof__heading {
      font-size: 2.5rem;
    }

    .proof__body {
      font-size: 1rem;
      color: var(--color-navy-mute);
    }

    .proof__stat {
      gap: 1.5rem;
    }

    .proof__value {
      font-size: 2rem;
    }

    .proof__note {
      font-size: 1rem;
    }
  }
</style>
