---
// Edge-to-edge grid of case study cards (3 / 1 columns) labelled with the strategy used.
// Card image and name come from the caseStudies collection.
import { getCollection } from 'astro:content';
import TalentCard from '@/components/cards/TalentCard.astro';

export interface Props {
  items: { slug: string; strategy: string }[];
}

const { items } = Astro.props;
const bySlug = new Map((await getCollection('caseStudies')).map((c) => [c.id, c.data]));
const cards = items.flatMap((item) => {
  const data = bySlug.get(item.slug);
  return data ? [{ ...item, title: data.title, image: data.cardImage }] : [];
});
---

<div class="case-grid">
  {cards.map((c) => (
    <div class="case-grid__cell">
      <TalentCard href={`/case-studies/${c.slug}`} image={c.image} name={c.title} tag={c.strategy} headingLevel="h3" />
    </div>
  ))}
</div>

<style>
  .case-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background-color: var(--color-smoke-2);
  }

  /* The live cards are 6px taller than wide (inline-block baseline gap filled by the image). */
  .case-grid__cell {
    display: flex;
    overflow: hidden;
  }

  .case-grid__cell::before {
    content: '';
    padding-top: calc(100% + 6px);
  }

  .case-grid__cell :global(.talent-card) {
    flex: 1;
    aspect-ratio: auto;
  }

  @media screen and (max-width: 767px) {
    .case-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
