---
// Label/value list with ice-blue square markers (stats on About, case studies, creators…).
export interface Props {
  rows: { label: string; value: string; href?: string }[];
  /** Draw a rule under the last row too. */
  closed?: boolean;
  /** Hide the square marker. */
  plain?: boolean;
  class?: string;
}

const { rows, closed = false, plain = false, class: className, ...rest } = Astro.props;
---

<dl class:list={['info-rows', className, { 'info-rows--closed': closed }]} {...rest}>
  {rows.map((r) => (
    <div class="info-rows__item">
      <dt class="info-rows__label">
        {!plain && <span class="info-rows__marker" aria-hidden="true"></span>}
        <span>{r.label}</span>
      </dt>
      <dd class="info-rows__value">{r.href ? <a href={r.href} target="_blank" rel="noopener">{r.value}</a> : r.value}</dd>
    </div>
  ))}
  <slot />
</dl>

<style>
  .info-rows {
    width: 100%;
    margin: 0;
  }

  .info-rows__item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 2rem 0;
    border-top: 1px solid var(--color-navy-20);
  }

  .info-rows--closed .info-rows__item:last-child {
    border-bottom: 1px solid var(--color-navy-20);
  }

  .info-rows__label {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .info-rows__marker {
    width: 12px;
    height: 12px;
    background-color: var(--accent);
  }

  .info-rows__label,
  .info-rows__value {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    line-height: 20px;
  }

  .info-rows__label {
    color: var(--color-navy-mute);
  }

  .info-rows__value {
    margin: 0;
    color: var(--color-navy);
  }

  @media screen and (max-width: 479px) {
    .info-rows__item {
      align-items: center;
    }

    .info-rows__label {
      gap: 10px;
      margin-right: 6px;
      font-size: 0.8rem;
    }

    .info-rows__value {
      white-space: nowrap;
      font-size: 0.8rem;
    }
  }
</style>
