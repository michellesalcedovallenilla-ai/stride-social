---
// Case study mosaic with mixed tile sizes, shared by the Our Work archive and the "related work"
// rows on service pages. Each tile carries its industry and service ids so the archive filter
// (src/scripts/system/archive-filter.ts) can show and hide tiles without a page load.
// Result figures appear only when verified; otherwise the tile lists the services.
import type { CollectionEntry } from 'astro:content';
import { getEntries, getEntry } from 'astro:content';
import { routes } from '@/lib/routes';

export interface Props {
  items: CollectionEntry<'work'>[];
  /** Heading level for tile names. */
  nameLevel?: 'h2' | 'h3';
  /** Tiles shown before "Load more" (archive only; applied by the filter script, so without JS every tile shows). */
  pageSize?: number;
}

const { items, nameLevel = 'h3', pageSize } = Astro.props;
const Name = nameLevel;
const tiles = await Promise.all(
  items.map(async (w) => {
    const client = await getEntry(w.data.client);
    const services = await getEntries(w.data.services);
    const verified = w.data.results.find((r) => r.status === 'verified');
    return {
      id: w.id,
      title: client?.data.name ?? w.data.title,
      image: w.data.card,
      services: services.map((s) => s.data.name).join(' · '),
      serviceIds: w.data.services.map((s) => s.id).join(' '),
      industryIds: w.data.industries.map((i) => i.id).join(' '),
      result: verified ? `${verified.value} ${verified.label.toLowerCase()}` : undefined,
    };
  }),
);
// Size rhythm repeats every six tiles so neighbours never match.
const sizes = ['l', 's', 's', 'm', 'm', 'w'];
---

<ul class="wgrid" role="list" data-archive-grid data-page-size={pageSize} data-sizes={sizes.join(' ')} data-size-prefix="wtile--">
  {tiles.map((t, i) => (
    <li class={`wtile wtile--${sizes[i % sizes.length]}`} data-filter-industry={t.industryIds} data-filter-service={t.serviceIds}>
      <a class="wtile__link" href={routes.caseStudy(t.id)}>
        <span class="wtile__media">
          <img src={t.image.src} alt="" sizes="(max-width: 599px) 100vw, (max-width: 1023px) 50vw, 45vw" loading="lazy" decoding="async" />
        </span>
        <span class="wtile__info">
          <span class="wtile__meta">{t.services}</span>
          <Name class="wtile__name">{t.title}</Name>
          {t.result && <span class="wtile__result">{t.result}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .wgrid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--gutter);
  }

  .wtile--l { grid-column: span 4; grid-row: span 2; }
  .wtile--s { grid-column: span 2; }
  .wtile--m { grid-column: span 3; }
  .wtile--w { grid-column: span 6; }

  .wtile[hidden] {
    display: none;
  }

  .wtile__link {
    position: relative;
    display: block;
    height: 100%;
    min-height: clamp(220px, 20vw, 340px);
    overflow: hidden;
    background: var(--navy-700);
    color: var(--white);
  }

  .wtile--w .wtile__link {
    min-height: clamp(260px, 26vw, 440px);
  }

  .wtile__media,
  .wtile__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wtile__media img {
    max-width: none;
    object-fit: cover;
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .wtile__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(6 20 43 / 0.85), rgb(6 20 43 / 0) 60%);
  }

  .wtile__info {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    left: var(--space-5);
    z-index: 1;
    display: grid;
    gap: var(--space-2);
  }

  .wtile__meta {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .wtile__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .wtile--l .wtile__name,
  .wtile--w .wtile__name {
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .wtile__result {
    font-size: var(--type-small);
    color: rgb(255 255 255 / 0.85);
  }

  .wtile__link:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 1023px) {
    .wgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wtile--l,
    .wtile--s,
    .wtile--m {
      grid-column: span 1;
      grid-row: auto;
    }

    .wtile--w {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 599px) {
    .wgrid {
      grid-template-columns: minmax(0, 1fr);
    }

    .wtile--w {
      grid-column: auto;
    }

    .wtile__link {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .wtile--w .wtile__link {
      min-height: 0;
    }
  }
</style>
