---
// Article template (docs/phase-2/05-wireframes.md §E): hero (category, title, standfirst, date,
// author) · cover · body (tables scroll on phones) · aside image · share links · related articles.
// Structured data: Article. Body HTML is the migrated article (trusted repository content),
// rendered through core/Prose.
import SiteLayout from '@/layouts/SiteLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import Prose from '@/components/core/Prose.astro';
import { categoryLabels, formatDate, getArticles, normaliseHeadings, realAside, type Article } from '@/lib/insights';
import { routes } from '@/lib/routes';
import { rewriteLegacyLinks } from '@/lib/legacy-links';
import { site } from '@/config/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, articles } }));
}

const { article, articles } = Astro.props as { article: Article; articles: Article[] };
const d = article.data;
// Bodies are migrated HTML: headings are renumbered so the outline never skips a level, and links
// to the previous site's URLs point straight at the new pages.
const body = rewriteLegacyLinks(normaliseHeadings((article.body ?? '').replace(/<!--[\s\S]*?-->/g, '')));
const aside = realAside(article);
const related = articles.filter((a) => a.id !== article.id && a.data.category === d.category).slice(0, 3);
const url = new URL(routes.article(article.id), site.url).href;
const share = [
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { label: 'X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}` },
  { label: 'Email', href: `mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(url)}` },
];
const author = d.authorName;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.standfirst,
    image: new URL(d.cover.src, site.url).href,
    ...(d.date ? { datePublished: d.date.toISOString().slice(0, 10) } : {}),
    ...(author ? { author: { '@type': 'Person', name: author } } : {}),
    publisher: { '@type': 'Organization', name: 'Stride Social', url: site.url },
  },
];
---

<SiteLayout title={d.seo?.title ?? `${d.title} | Stride Insights`} description={d.seo?.description ?? d.standfirst} ogImage={d.cover.src} ogType="article" jsonLd={jsonLd}>
  <article class="article">
    <header class="article__head container-wide">
      <Breadcrumbs items={[{ label: 'Insights', href: '/insights' }, { label: categoryLabels[d.category], href: routes.insightsFiltered(d.category) }]} tone="light" />
      <div class="article__titles">
        <p class="article__meta">{categoryLabels[d.category]}{d.date && <> · <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></>}</p>
        <h1 class="article__title">{d.title}</h1>
        <p class="article__standfirst">{d.standfirst}</p>
        {author && <p class="article__author">By {author}</p>}
      </div>
    </header>

    <figure class="article__cover container-wide">
      <img src={d.cover.src} alt={d.cover.alt} fetchpriority="high" decoding="async" />
    </figure>

    <div class="article__body container-wide">
      <aside class="article__side">
        <p class="article__side-label">Share</p>
        <ul class="article__share" role="list">
          {share.map((s) => (
            <li><a href={s.href} target={s.label === 'Email' ? undefined : '_blank'} rel="noopener">{s.label}{s.label !== 'Email' && <span class="visually-hidden"> (opens in a new tab)</span>}</a></li>
          ))}
        </ul>
      </aside>
      <Prose class="article__prose" html={body} />
      {aside && (
        <figure class="article__aside">
          <img src={aside.src} alt={aside.alt} loading="lazy" />
        </figure>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <div class="container-wide">
        <h2 class="related__label" id="related-title">More in {categoryLabels[d.category]}</h2>
        <ul class="related__grid" role="list">
          {related.map((a) => (
            <li>
              <a class="related__link" href={routes.article(a.id)}>
                <span class="related__media"><img src={a.data.cover.src} alt="" sizes="(max-width: 1023px) 100vw, 30vw" loading="lazy" /></span>
                <span class="related__meta">{formatDate(a.data.date)}</span>
                <span class="related__title">{a.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</SiteLayout>

<style>
  .article,
  .related {
    position: relative;
    z-index: 1;
    background: var(--paper);
    color: var(--navy-900);
  }

  .article__head {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-8);
  }

  .article__titles {
    display: grid;
    gap: var(--space-5);
    max-width: 980px;
  }

  .article__meta,
  .article__author,
  .article__side-label,
  .related__label,
  .related__meta {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .article__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 5rem);
    font-weight: 850;
    font-stretch: 108%;
    line-height: 0.98;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
  }

  .article__standfirst {
    max-width: 52ch;
    font-size: var(--type-lead);
    line-height: 1.45;
    color: var(--navy-700);
  }

  .article__cover {
    margin-block: 0;
  }

  .article__cover img {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  .article__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--gutter);
    padding-block: var(--space-9) var(--section-pad);
  }

  .article__side {
    grid-column: 1 / 3;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
  }

  .article__share {
    display: grid;
    gap: var(--space-2);
  }

  .article__share a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article__body > :global(.article__prose) {
    grid-column: 3 / 10;
    min-width: 0;
  }

  .article__aside {
    grid-column: 10 / -1;
    margin: 0;
    align-self: start;
  }

  .related {
    padding-block: var(--space-9) var(--section-pad);
    border-top: 1px solid var(--line);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    margin-top: var(--space-6);
  }

  .related__link {
    display: grid;
    gap: var(--space-3);
  }

  .related__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .related__media img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .related__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.15;
  }

  @media (max-width: 1023px) {
    .article__side,
    .article__body > :global(.article__prose),
    .article__aside {
      grid-column: 1 / -1;
    }

    .article__side {
      position: static;
      grid-row: 2;
    }

    .article__share {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .article__aside {
      max-width: 520px;
    }

    .related__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .article__cover img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
