---
// Homepage section A1 (docs/phase-2/05-wireframes.md): near full-screen montage, headline
// bottom-left with the story text beside it, and the three businesses as numbered tabs along the
// bottom. The footage is always in a black-and-white navy duotone. The hero is interactive
// (src/scripts/system/hero-worlds.ts): choosing a business (hover or focus; on touch screens it
// cycles) wipes its footage in with a triangle from the Stride mark, tints the duotone in its
// colour and tells its story beside the headline; scrolling away folds the footage into a rounded
// frame.
// With `intro`, the page opens on the Stride lockup animation first (home/IntroReveal.astro), on
// every device and every visit: it covers the whole screen and scrolling stays locked until it
// ends or is skipped, while the montage loads behind it; then it fades away to the montage as the
// headline, copy and tabs reveal (src/scripts/system/hero-intro.ts).
import Media from '../core/Media.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import IntroReveal from './IntroReveal.astro';

type VideoSource = { mp4: string; webm?: string; poster: string };
type Division = 'social' | 'talent' | 'education';

export interface Props {
  headline: string[];
  description: string;
  /** One tab per business; `image` or `video` is the footage shown while it is active. */
  routes: {
    label: string;
    href: string;
    division: Division;
    audience: string;
    copy: string;
    image?: { src: string; alt: string; position?: string };
    video?: VideoSource;
  }[];
  video: VideoSource & { label: string; mobile?: VideoSource };
  intro?: { words: { label: string; division?: Division }[] };
  interim?: boolean;
}

const { headline, description, routes, video, intro, interim = false } = Astro.props;
const shortName = (label: string) => label.replace(/^Stride\s+/, '');
---

<section class:list={['hero', { 'hero--intro': intro }]} aria-labelledby="hero-title" data-hero data-hero-intro={intro ? '' : undefined}>
  <div class="hero__stage" data-hero-stage>
    <Media video={video} priority={!intro} controlsPosition="bottom-right" class="hero__media" />
    {routes.map((r) => (
      <div class:list={['hero__world', `hero__world--${r.division}`]} data-world={r.division} aria-hidden="true">
        {r.video ? (
          <video class="hero__world-el" muted loop playsinline preload="none" poster={r.video.poster}>
            {r.video.webm && <source src={r.video.webm} type="video/webm" />}
            <source src={r.video.mp4} type="video/mp4" />
          </video>
        ) : r.image ? (
          <img
            class="hero__world-el"
            src={r.image.src}
            alt=""
            loading="lazy"
            decoding="async"
            sizes="100vw"
            style={r.image.position ? `object-position: ${r.image.position}` : undefined}
          />
        ) : null}
      </div>
    ))}
  </div>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__tint" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>
  {interim && <PlaceholderNotice label="Interim footage" class="hero__interim">— awaiting approved montage</PlaceholderNotice>}
  <div class="hero__scrim" aria-hidden="true"></div>

  {intro && (
    <>
      <div class="hero__intro">
        <IntroReveal words={intro.words} />
        <div class="hero__intro-grain" aria-hidden="true"></div>
      </div>
      <script is:inline>
        // Decide before the page paints whether the intro plays: whenever motion is allowed. It
        // starts at the top with scrolling locked. If the intro script never starts, show the page.
        (() => {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const hero = document.querySelector('[data-hero-intro]');
          hero.classList.add('is-intro-playing');
          document.documentElement.classList.add('intro-lock');
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          scrollTo(0, 0);
          setTimeout(() => {
            if (hero.dataset.introReady) return;
            hero.classList.remove('is-intro-playing');
            document.documentElement.classList.remove('intro-lock');
            hero.dispatchEvent(new CustomEvent('hero:intro', { bubbles: true }));
          }, 3000);
        })();
      </script>
      <button class="hero__intro-toggle" type="button" data-intro-toggle>Skip intro</button>
    </>
  )}

  <div class="hero__content">
    <h1 class="hero__title" id="hero-title" data-reveal-lines="load">
      {headline.map((line, i) => (
        <span class="reveal-line" style={`--line: ${i}`}><span class="reveal-line__inner">{line}</span></span>
      ))}
    </h1>
    <!-- The group's line, or the active business's story; all share one cell, so nothing jumps. -->
    <div class="hero__story" data-reveal="load" style="--reveal-delay: 0.45s">
      <p class="hero__story-panel is-active" data-story="group">{description}</p>
      {routes.map((r) => (
        <div class:list={['hero__story-panel', `hero__story-panel--${r.division}`]} data-story={r.division}>
          <p class="hero__story-eyebrow"><span class="hero__story-swatch" aria-hidden="true"></span>{r.label} · {r.audience}</p>
          <p class="hero__story-copy">{r.copy}</p>
        </div>
      ))}
    </div>
  </div>

  <nav class="hero__worlds" aria-label="Stride businesses" data-reveal="load" style="--reveal-delay: 0.6s">
    <ul class="hero__tabs" role="list">
      {routes.map((r, i) => (
        <li class="hero__tab-item">
          <a class:list={['hero__tab', `hero__tab--${r.division}`]} href={r.href} data-world-tab={r.division}>
            <span class="hero__tab-line" aria-hidden="true"><span class="hero__tab-fill"></span></span>
            <span class="hero__tab-head">
              <span class="hero__tab-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="hero__tab-name"><span class="hero__tab-brand">Stride </span>{shortName(r.label)}</span>
              <svg class="hero__tab-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
            </span>
            <span class="hero__tab-audience">{r.audience}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<style>
  .hero {
    --hero-p: 0; /* 0 at the top of the page, 1 once the hero has scrolled away (hero-worlds.ts) */
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 640px;
    height: 100svh;
    max-height: 1040px;
    overflow: hidden;
    background: var(--navy-900);
    color: var(--white);
  }

  .hero :global(.hero__interim) {
    top: calc(var(--header-h) + var(--space-3));
  }

  /* ---------- Footage ---------- */
  /* Black-and-white duotone; as the hero scrolls away the footage folds into a rounded frame and
     drifts down a little (parallax). */
  .hero__stage {
    position: absolute;
    inset: 0;
    filter: grayscale(1) contrast(1.08);
    clip-path: inset(calc(var(--hero-p) * 5vh) calc(var(--hero-p) * 4vw) 0 round calc(var(--hero-p) * 32px));
    transform: translateY(calc(var(--hero-p) * 14%));
  }

  /* Each business's footage comes in as a triangle growing from the bottom-right corner, the shape
     of the triangles in the Stride mark, and leaves the same way. */
  .hero__world {
    position: absolute;
    inset: 0;
    clip-path: polygon(100% 100%, 100% 100%, 100% 100%);
    transition: clip-path 0.9s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .hero__world.is-active {
    clip-path: polygon(100% 100%, -100% 100%, 100% -100%);
  }

  .hero__world-el {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* Stills drift slowly while shown, so a photo still feels like footage. */
  .hero__world.is-active img.hero__world-el {
    animation: hero-drift 10s var(--ease-out) both;
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.08);
    }
  }

  /* The navy tone: a navy veil over the black and white, and a multiply layer that tints the
     highlights in the active business's colour (white, so no tint, for the group). */
  .hero__veil,
  .hero__tint,
  .hero__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero__veil {
    background: rgb(6 20 43 / 0.2);
  }

  .hero__tint {
    background: var(--white);
    mix-blend-mode: multiply;
    transition: background-color 0.8s var(--ease-out);
  }

  .hero[data-active-world='social'] .hero__tint {
    background: var(--ice);
  }

  .hero[data-active-world='talent'] .hero__tint {
    background: var(--peach);
  }

  .hero[data-active-world='education'] .hero__tint {
    background: var(--sun);
  }

  .hero__grain,
  .hero__intro-grain {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    mix-blend-mode: soft-light;
    animation: hero-grain 0.9s steps(5) infinite;
  }

  .hero__grain {
    inset: -50%;
    opacity: 0.12;
  }

  @keyframes hero-grain {
    0% { transform: translate(0, 0); }
    20% { transform: translate(-3%, 2%); }
    40% { transform: translate(2%, -3%); }
    60% { transform: translate(-2%, -1%); }
    80% { transform: translate(3%, 3%); }
    100% { transform: translate(0, 0); }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgb(6 20 43 / 0.88) 0%, rgb(6 20 43 / 0.4) 42%, rgb(6 20 43 / 0.15) 100%),
      linear-gradient(to right, rgb(6 20 43 / 0.35), transparent 60%);
    pointer-events: none;
  }

  /* ---------- Headline and story ---------- */
  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
    gap: var(--gutter);
    width: 100%;
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: 0 var(--margin) var(--space-7);
    opacity: calc(1 - var(--hero-p) * 1.2);
    transform: translateY(calc(var(--hero-p) * -90px));
  }

  .hero__title {
    grid-column: 1 / 9;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 8.6vw, 9.5rem);
    font-weight: 850;
    font-stretch: 118%;
    line-height: 0.86;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .hero__story {
    grid-column: 9 / -1;
    display: grid;
    align-items: end;
    max-width: 36ch;
    padding-bottom: 0.4rem;
  }

  .hero__story-panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out),
      visibility 0s linear 0.45s;
  }

  .hero__story-panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out) 0.15s,
      transform 0.6s var(--ease-out) 0.15s;
  }

  p.hero__story-panel,
  .hero__story-copy {
    font-size: var(--type-lead);
    line-height: 1.4;
    color: rgb(255 255 255 / 0.9);
  }

  .hero__story-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
  }

  .hero__story-swatch {
    width: 10px;
    height: 10px;
    flex: none;
    background: var(--ice);
  }

  .hero__story-panel--talent .hero__story-swatch {
    background: var(--peach);
  }

  .hero__story-panel--education .hero__story-swatch {
    background: var(--sun);
  }

  /* ---------- The three businesses ---------- */
  .hero__worlds {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: 0 var(--margin) var(--space-6);
    opacity: calc(1 - var(--hero-p) * 1.6);
  }

  .hero__tabs {
    display: flex;
    gap: var(--gutter);
  }

  /* The active tab widens and the others step back. */
  .hero__tab-item {
    flex: 1 1 0;
    min-width: 0;
    transition:
      flex-grow 0.6s var(--ease-out),
      opacity 0.4s var(--ease-out);
  }

  .hero[data-active-world] .hero__tab-item {
    opacity: 0.5;
  }

  .hero[data-active-world] .hero__tab-item:has(.is-active) {
    flex-grow: 1.5;
    opacity: 1;
  }

  .hero__tab {
    --tab-accent: var(--ice);
    display: grid;
    gap: 6px;
    padding-block: var(--space-4) var(--space-2);
    color: var(--white);
  }

  .hero__tab--talent {
    --tab-accent: var(--peach);
  }

  .hero__tab--education {
    --tab-accent: var(--sun);
  }

  .hero__tab-line {
    height: 2px;
    margin-bottom: var(--space-2);
    overflow: hidden;
    background: rgb(255 255 255 / 0.25);
  }

  .hero__tab-fill {
    display: block;
    height: 100%;
    background: var(--tab-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s var(--ease-out);
  }

  .hero__tab.is-active .hero__tab-fill {
    transform: none;
  }

  /* Touch screens: the active tab's line fills over the time it stays on screen. */
  .hero__tab.is-cycling .hero__tab-fill {
    transition: none;
    animation: hero-tab-progress var(--cycle, 5s) linear both;
  }

  @keyframes hero-tab-progress {
    from {
      transform: scaleX(0);
    }

    to {
      transform: none;
    }
  }

  .hero__tab-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
  }

  .hero__tab-index {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    color: var(--tab-accent);
  }

  .hero__tab-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero__tab-audience {
    padding-left: calc(2ch + var(--space-3));
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.72);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero__tab-arrow {
    width: 18px;
    flex: none;
    align-self: center;
    transition:
      transform 0.35s var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .hero__tab:hover .hero__tab-arrow,
  .hero__tab:focus-visible .hero__tab-arrow,
  .hero__tab.is-active .hero__tab-arrow {
    color: var(--tab-accent);
    transform: translateX(5px);
  }

  /* ---------- Intro ---------- */
  /* Covers the whole screen, header included (the consent banner, z 200, stays above), with page
     scrolling locked while it plays; then it fades out as the content reveals. Hidden and locked
     states sit under .js so the page can never stay covered without scripts. */
  .hero__intro {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--navy-900);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.9s var(--ease-out),
      visibility 0s linear 0.9s;
  }

  /* While it plays it also catches clicks, so nothing hidden underneath can be clicked. */
  :global(.js) .hero.is-intro-playing .hero__intro {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: none;
  }

  :global(html.js.intro-lock) {
    overflow: hidden;
  }

  /* A fine moving film grain over the animation. */
  .hero__intro-grain {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    opacity: 0.16;
  }

  :global(.js) .hero.is-intro-playing .hero__content,
  :global(.js) .hero.is-intro-playing .hero__worlds {
    opacity: 0;
  }

  /* The interim label belongs to the montage underneath. */
  :global(.js) .hero.is-intro-playing :global(.hero__interim) {
    visibility: hidden;
  }

  /* The montage's pause button stays for keyboard users (WCAG 2.2.2: looping video needs a way to
     pause) but is invisible until it has keyboard focus. */
  .hero :global(.media__toggle:not(:focus-visible)) {
    opacity: 0;
    pointer-events: none;
  }

  /* Hold the load reveals until the intro ends; they play from the start when it does. */
  :global(.js) .hero.is-intro-playing [data-reveal='load'],
  :global(.js) .hero.is-intro-playing .reveal-line__inner {
    animation: none;
  }

  /* "Skip intro": only while the intro plays (WCAG 2.2.2), in the screen's corner. */
  .hero__intro-toggle {
    display: none;
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 151;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 999px;
    background: rgb(6 20 43 / 0.35);
    color: var(--white);
    font-size: 0.8125rem;
    font-weight: 500;
    backdrop-filter: blur(6px);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .hero__intro-toggle:hover {
    background: rgb(6 20 43 / 0.6);
  }

  :global(.js) .hero.is-intro-playing .hero__intro-toggle {
    display: block;
  }

  @media (max-width: 1023px) {
    .hero__content {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__title,
    .hero__story {
      grid-column: 1 / -1;
    }

    .hero__title {
      font-size: clamp(3rem, 11.5vw, 7rem);
    }

    .hero__story {
      max-width: 520px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 600px;
      max-height: none;
    }

    .hero__content {
      gap: var(--space-5);
      padding-bottom: var(--space-6);
    }

    .hero__title {
      font-stretch: 112%;
      font-size: min(12vw, 5rem);
    }

    /* Tabs shrink to their names; the line on top carries the colour and the progress. */
    .hero__tabs {
      gap: var(--space-3);
    }

    .hero__tab {
      padding-block: var(--space-3) var(--space-2);
    }

    .hero__tab-brand,
    .hero__tab-index,
    .hero__tab-audience,
    .hero__tab-arrow {
      display: none;
    }

    .hero__tab-name {
      font-size: 0.9375rem;
    }
  }

  /* "CREATORS." must fit on one line down to 320px wide. */
  @media (max-width: 479px) {
    .hero__title {
      font-stretch: 100%;
      font-size: 10.6vw;
    }
  }
</style>

<script>
  import { initHeroIntro } from '@/scripts/system/hero-intro';
  import { initHeroWorlds } from '@/scripts/system/hero-worlds';
  initHeroIntro();
  initHeroWorlds();
</script>
