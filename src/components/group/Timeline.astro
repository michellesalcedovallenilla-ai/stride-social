---
// Our History: a vertical editorial timeline. Each milestone has a large year marker, a headline,
// its text and a photo slot; the current year stays pinned in the left column while its entry
// scrolls past. Only verified milestones render in production; preview also shows the previous
// site's milestones, labelled, until Stride confirms them (Q1).
import { getCollection } from 'astro:content';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';

const milestones = (await getCollection('milestones', (m) => m.data.status === 'verified' || isPreview)).sort((a, b) => a.data.order - b.data.order);
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

{milestones.length > 0 ? (
  <ol class="timeline container-wide" role="list">
    {milestones.map((m) => (
      <li class="milestone">
        <div class="milestone__year-col">
          <p class="milestone__year">{m.data.year}</p>
        </div>
        <div class="milestone__body">
          {m.data.status !== 'verified' && (
            <PlaceholderNotice variant="inline" label="To verify">— from the previous site; confirm the milestone and its details (Q1)</PlaceholderNotice>
          )}
          <h2 class="milestone__title">{m.data.title}</h2>
          <div class="milestone__text">
            {paragraphs(m.data.body).map((p) => <p>{p}</p>)}
          </div>
        </div>
        <div class="milestone__media">
          {m.data.image ? (
            <img src={m.data.image.src} alt={m.data.image.alt} loading="lazy" />
          ) : (
            isPreview && (
              <div class="milestone__frame">
                <PlaceholderNotice variant="block" label="Awaiting photography">
                  <p>A photo from {m.data.year} (Q18).</p>
                </PlaceholderNotice>
              </div>
            )
          )}
        </div>
      </li>
    ))}
  </ol>
) : (
  <p class="timeline__none container-wide">Our timeline is being put together. In the meantime, read <a href="/about">about Stride</a>.</p>
)}

<style>
  .timeline {
    position: relative;
    padding-bottom: var(--section-pad);
  }

  .milestone {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1.2fr;
    gap: var(--space-6) var(--gutter);
    padding-block: var(--space-9);
    border-top: 1px solid var(--line);
  }

  .milestone__year-col {
    position: relative;
    container-type: inline-size;
  }

  .milestone__year {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
    font-family: var(--font-display);
    font-size: min(28cqi, 8rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--navy-900);
  }

  .milestone:hover .milestone__year {
    color: var(--navy-900);
  }

  .milestone__body {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
  }

  .milestone__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 3rem);
    font-weight: 850;
    font-stretch: 112%;
    line-height: 0.95;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .milestone__text {
    display: grid;
    gap: var(--space-4);
    max-width: 58ch;
    color: var(--navy-700);
  }

  .milestone__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .milestone__frame {
    display: grid;
    align-content: end;
    aspect-ratio: 4 / 3;
    padding: var(--space-3);
    border: 1px dashed rgb(6 20 43 / 0.25);
    background: var(--white);
  }

  .timeline__none {
    padding-bottom: var(--section-pad);
    font-size: var(--type-lead);
  }

  .timeline__none a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .milestone {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--space-8);
    }

    .milestone__year {
      position: static;
      font-size: min(18cqi, 6rem);
      color: var(--navy-900);
      -webkit-text-stroke: 0;
    }

    .milestone__media {
      max-width: 520px;
    }
  }
</style>
