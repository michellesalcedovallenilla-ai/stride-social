---
// Group homepage. Stage 1 creative proof: sections A1 (hero) and A2 (Three Sides) at full
// fidelity with interim media; sections A3–A10 arrive in Stage 3 (docs/phase-2/05-wireframes.md).
import SiteLayout from '@/layouts/SiteLayout.astro';
import HeroMontage from '@/components/home/HeroMontage.astro';
import ThreeSides from '@/components/home/ThreeSides.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
---

<SiteLayout
  title="Stride Social | Influencer Advertising & Talent Agency"
  description="Stride is a global media group built around creators: Stride Social for brands, Stride Talent for creators and Stride Education for the next generation."
  headerOverlay
>
  <HeroMontage
    headline={['Built', 'around', 'creators.']}
    description="One global group. Three businesses shaping how creators build careers, how brands reach audiences, and how the next generation gets started."
    routes={[
      { label: 'Stride Social', href: '/social', division: 'social' },
      { label: 'Stride Talent', href: '/talent', division: 'talent' },
      { label: 'Stride Education', href: '/education', division: 'education' },
    ]}
    video={{
      label: 'Montage of Stride creator campaigns',
      mp4: '/assets/video/1236e597-1029-transcode.mp4',
      webm: '/assets/video/1236e597-1029-transcode.webm',
      poster: '/assets/site/1236e597-1029-poster-00001.jpg',
      mobile: {
        mp4: '/assets/video/926f3517-1029-1-transcode.mp4',
        webm: '/assets/video/926f3517-1029-1-transcode.webm',
        poster: '/assets/site/926f3517-1029-1-poster-00001.jpg',
      },
    }}
    interim
  />

  <ThreeSides
    eyebrow="Explore Stride"
    headline="Three sides of Stride."
    panels={[
      {
        division: 'social',
        audience: 'For brands',
        name: 'Social',
        copy: 'Influencer marketing, content, campaigns, and commerce.',
        cta: 'Explore Stride Social',
        href: '/social',
        image: { src: '/assets/site/f2fc912c-video1-poster-00001.jpg', alt: 'A creator filming a product campaign in her kitchen', position: '50% 30%' },
        video: {
          label: 'A creator filming a product campaign in her kitchen',
          mp4: '/assets/video/f2fc912c-video1-transcode.mp4',
          webm: '/assets/video/f2fc912c-video1-transcode.webm',
          poster: '/assets/site/f2fc912c-video1-poster-00001.jpg',
        },
        interim: true,
      },
      {
        division: 'talent',
        audience: 'For creators',
        name: 'Talent',
        copy: 'Representation, opportunities, and long-term career management.',
        cta: 'Explore Stride Talent',
        href: '/talent',
        image: { src: '/assets/cms/7a2c07a0-aq.jpg', alt: 'Black and white portrait of a Stride Talent creator', position: '50% 25%' },
        interim: true,
      },
      {
        division: 'education',
        audience: 'For the next generation',
        name: 'Education',
        copy: 'Learn the industry, develop your content, and build your creator career.',
        cta: 'Explore Stride Education',
        href: '/education',
        image: { src: '/assets/site/b9208d92-stride-social.webp', alt: 'Creators and the Stride team at an industry event', position: '50% 50%' },
        interim: true,
      },
    ]}
  />

  <section class="next" aria-label="Upcoming homepage sections">
    <PlaceholderNotice variant="block" label="Stage 3 — remaining homepage sections">
      <p>
        One group. Built for what's next · Our divisions · Our work · The people behind Stride · Beyond business ·
        Insights · Global presence · Let's make something happen. These follow the approved wireframes and need the
        client inputs listed in docs/phase-2/09-client-approval-checklist.md.
      </p>
    </PlaceholderNotice>
  </section>
</SiteLayout>

<style>
  .next {
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: var(--space-9) var(--margin);
  }
</style>
