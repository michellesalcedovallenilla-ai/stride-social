---
// Primary button/link. `accent` = ice blue on navy text, `dark` = navy, `light` = ice blue block.
export interface Props {
  href: string;
  variant?: 'accent' | 'dark' | 'light';
  class?: string;
  external?: boolean;
}

const { href, variant = 'accent', class: className, external = /^https?:/.test(href), ...rest } = Astro.props;
---

<a class:list={['button', `button--${variant}`, className]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} {...rest}>
  <slot />
</a>

<style>
  .button {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.2em 35px;
    border-radius: var(--radius-button);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s;
  }

  .button--accent {
    color: var(--on-accent);
    background-color: var(--accent);
  }

  .button--dark {
    color: var(--color-white);
    background-color: var(--color-navy);
  }

  .button--light {
    display: block;
    padding-inline: 40px;
    color: var(--on-accent);
    background-color: var(--accent);
  }

  .button--accent:hover,
  .button--light:hover {
    background-color: var(--color-smoke);
  }

  .button--dark:hover {
    color: #616161;
    background-color: #efffa6;
  }

  @media screen and (max-width: 991px) {
    .button {
      padding: 18px 40px;
    }
  }

  @media screen and (max-width: 767px) {
    .button {
      width: 100%;
      font-size: 16px;
    }

    .button--accent {
      width: auto;
    }
  }

  @media screen and (max-width: 479px) {
    .button {
      padding-inline: 25px;
    }
  }
</style>
