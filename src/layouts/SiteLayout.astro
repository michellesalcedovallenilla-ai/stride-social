---
// Phase 3 layout for every redesigned page. Sets the division theme (data-division), renders the
// new header/division bar/footer and loads the motion scripts. Phase 1 pages keep BaseLayout
// until each one is replaced.
import '@/styles/system/index.css';
import Seo from '@/components/global/Seo.astro';
import SiteHeader from '@/components/global/SiteHeader.astro';
import SiteFooter from '@/components/global/SiteFooter.astro';
import ConsentBanner from '@/components/global/ConsentBanner.astro';
import CursorBuddy from '@/components/global/CursorBuddy.astro';
import Ambient from '@/components/experience/Ambient.astro';
import { plausibleDomain } from '@/config/analytics';
import { site } from '@/config/site';
import type { DivisionKey } from '@/config/navigation';
import type { Look } from '@/lib/experience';

export interface Props {
  title: string;
  description?: string | null;
  ogImage?: string | null;
  ogType?: 'website' | 'article' | 'profile';
  division?: DivisionKey;
  /** The page opens with a full-bleed dark hero: header starts transparent with light text. */
  headerOverlay?: boolean;
  /** The colour the page opens in; it then follows its sections as it scrolls. */
  look?: Look;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, ogImage, ogType, division = 'group', headerOverlay = false, look = 'deep', jsonLd, noindex } = Astro.props;
const ink = ['deep', 'navy', 'slate'].includes(look) ? 'dark' : 'light';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';
---

<!doctype html>
<html lang="en" data-division={division} data-look={headerOverlay ? look : undefined} data-ink={headerOverlay ? ink : undefined} class={headerOverlay ? 'has-backdrop' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Safety net: if the motion scripts never start, show everything rather than hidden content.
      setTimeout(() => {
        const root = document.documentElement;
        if (!root.classList.contains('motion-ready')) root.classList.remove('js');
      }, 3000);
    </script>
    <Seo title={title} description={description} ogImage={ogImage} ogType={ogType} path={path} jsonLd={jsonLd} noindex={noindex} />
    <link rel="icon" href={site.favicon} type="image/png" />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />
    <slot name="head" />
    {/* Cookieless analytics needs no consent banner (Q14 decides which tool, if any). */}
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    {headerOverlay && <div class="backdrop" aria-hidden="true" data-backdrop><Ambient /></div>}
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader path={path} overlay={headerOverlay} />
    <main id="main" class:list={['page', { 'page--overlay': headerOverlay }]}>
      <slot />
    </main>
    <SiteFooter />
    <CursorBuddy />
    <ConsentBanner />
    <script>
      import { initSmoothScroll } from '@/scripts/system/smooth-scroll';
      import { initBackdrop } from '@/scripts/system/backdrop';
      import { initReveal } from '@/scripts/system/reveal';
      import { initRevealLines } from '@/scripts/system/reveal-lines';
      import { initParallax, initMagnetic } from '@/scripts/system/motion';
      document.documentElement.classList.add('motion-ready');
      initSmoothScroll();
      initBackdrop();
      initReveal();
      initRevealLines();
      initParallax();
      initMagnetic();
    </script>
  </body>
</html>

<style>
  .page {
    padding-top: var(--header-h);
  }

  .page--overlay {
    padding-top: 0;
  }

  /* The one background behind the whole page; its own layer, so changing colour redraws nothing else. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: rgb(var(--backdrop, var(--tone-surface)));
    transform: translateZ(0);
    pointer-events: none;
  }
</style>
