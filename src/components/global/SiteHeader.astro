---
// Site chrome: the Stride logo and the Menu button, and the radial scroll
// navigation on the left (global/EdgeNav.astro). The Menu button slides open into a horizontal
// frosted-glass bar to its left, listing the six areas; it is the expanded form of the same
// navigation (shared behaviour and active state), not a separate menu.
// Behaviour: src/scripts/system/header.ts and src/scripts/system/edge-nav.ts.
import StrideLogo from '../core/StrideLogo.astro';
import EdgeNav from './EdgeNav.astro';
import { modes, modeOf } from '@/config/navigation';

export interface Props {
  path: string;
  /** Transparent header with light text over a full-bleed dark hero. */
  overlay?: boolean;
}

const { path, overlay = false } = Astro.props;
const mode = modeOf(path);
---

<div class:list={['chrome', { 'chrome--overlay': overlay }]} data-chrome>
  <header class="header">
    <div class="header__bar">
      <a class="header__logo" href="/" aria-label="Stride home">
        <StrideLogo tone="dark" class="header__logo-mark" />
      </a>

      <div class="header__actions">
        <button class="header__menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
          <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
        </button>

        {/* The expanded navigation: one glass bar that slides open to the left of the Menu button. */}
        <nav class="menu-panel" id="site-menu" aria-label="Site menu" data-menu-panel inert>
          <ol class="menu-panel__list" role="list">
            {modes.map((m, i) => (
              <li style={`--o: ${modes.length - 1 - i}`}>
                <a
                  class:list={['menu-panel__item', { 'is-active': m.key === mode }]}
                  href={m.href}
                  data-menu-item={m.key}
                  aria-current={path !== '/' && m.key === mode ? 'page' : undefined}
                >{m.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  </header>

</div>

{/* The radial navigation, fixed on the left on every page (along the bottom on phones). */}
<EdgeNav current={mode} home={path === '/'} />

<style>
  /* ---------- Chrome container ---------- */
  .chrome {
    --chrome-ink: rgb(var(--ink));
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .chrome.is-hidden {
    transform: translateY(-100%);
  }

  /* Over the Social globe the logo stripe has the top of the screen (src/scripts/system/creator-globe.ts).
     Keyboard focus still brings the header back. */
  :global(html.is-on-globe) .chrome:not(:focus-within) {
    transform: translateY(-100%);
  }

  /* See-through all the way down, on every page on navy: no bar across what's scrolling under it. */
  .header {
    position: relative;
    color: var(--chrome-ink);
  }

  /* Only the internal pages that aren't on navy (the styleguide) need a solid bar for its white logo. */
  .chrome:not(.chrome--overlay) .header {
    background: var(--navy-900);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-h);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .header__logo {
    color: var(--chrome-ink);
  }

  .header__logo :global(.logo) {
    color: inherit;
  }

  .header__actions {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  .header__menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    min-height: 44px;
    padding: 0;
    border-radius: 999px;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }

  .header__menu-btn {
    position: relative;
    z-index: 2;
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.35);
    color: var(--chrome-ink);
    /* Glass: no fill, only what's behind it softened, so it stays clear over whatever scrolls past. */
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* No fill on hover, or when open: only its outline brightens. */
  .header__menu-btn:hover {
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.7);
  }

  /* Open: the button sits at the right end of the bar; the burger turns to a cross. */
  .header__menu-btn[aria-expanded='true'] {
    color: rgb(var(--ink));
  }

  .header__burger span {
    transition: translate 420ms var(--ease-out), rotate 420ms var(--ease-out);
  }

  .header__menu-btn[aria-expanded='true'] .header__burger span:first-child {
    translate: 0 3.25px;
    rotate: 45deg;
  }

  .header__menu-btn[aria-expanded='true'] .header__burger span:last-child {
    translate: 0 -3.25px;
    rotate: -45deg;
  }

  /* ---------- Menu bar ----------
     One horizontal glass bar attached to the Menu button: it sits around the button and reaches
     left. Closed, it is clipped to the button's own pill; opening, the clip slides open to the
     left and the six areas fade in from right to left, nearest the button first. */
  .menu-panel {
    --pad: 6px;
    --btn-w: 64px;
    position: absolute;
    top: calc(-1 * var(--pad));
    right: calc(-1 * var(--pad));
    z-index: 1;
    display: flex;
    align-items: center;
    height: calc(44px + 2 * var(--pad));
    padding: 0 calc(var(--btn-w) + var(--pad) + 10px) 0 var(--pad);
    border: 1px solid rgb(var(--hair) / 0.22);
    border-radius: 999px;
    background: linear-gradient(to bottom, rgb(255 255 255 / calc(0.16 * var(--fill-k))), rgb(255 255 255 / calc(0.07 * var(--fill-k))));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 16px 40px -20px rgb(var(--shade) / 0.45);
    backdrop-filter: blur(22px) saturate(170%) brightness(0.86);
    -webkit-backdrop-filter: blur(22px) saturate(170%) brightness(0.86);
    color: rgb(var(--ink));
    clip-path: inset(0 0 0 calc(100% - var(--btn-w) - 2 * var(--pad)) round 999px);
    opacity: 0;
    visibility: hidden;
    transition:
      clip-path 620ms var(--ease-out),
      opacity 220ms var(--ease-out),
      visibility 0s linear 620ms;
  }

  .menu-panel.is-open {
    clip-path: inset(0 round 999px);
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .menu-panel__list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* --o: order from the button outwards, so the nearest area appears first. */
  .menu-panel__list li {
    opacity: 0;
    translate: 10px 0;
    transition:
      opacity 220ms var(--ease-out),
      translate 220ms var(--ease-out);
  }

  .menu-panel.is-open .menu-panel__list li {
    opacity: 1;
    translate: 0 0;
    transition-duration: 460ms;
    transition-delay: calc(120ms + var(--o) * 40ms);
  }

  .menu-panel__item {
    display: block;
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1.2;
    white-space: nowrap;
    color: rgb(var(--ink) / 0.84);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .menu-panel__item:hover,
  .menu-panel__item:focus-visible {
    background: rgb(255 255 255 / calc(0.1 * var(--fill-k)));
    color: rgb(var(--ink));
    outline: none;
  }

  .menu-panel__item:focus-visible {
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.55);
  }

  .menu-panel__item.is-active {
    background: rgb(255 255 255 / calc(0.22 * var(--fill-k)));
    color: rgb(var(--ink));
  }

  /* Narrower desktops: a slightly tighter bar. */
  @media (max-width: 1279px) {
    .menu-panel__item {
      padding: 9px 12px;
      font-size: 0.875rem;
    }
  }

  /* Phones and tablets: there's no room for both, so the logo steps aside while the bar is open. */
  @media (max-width: 1023px) {
    .header__logo {
      transition: opacity var(--dur-base) var(--ease-out);
    }

    .chrome:has(.menu-panel.is-open) .header__logo {
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-panel__list li,
    .header__burger span {
      transition: none;
    }
  }

  .header__burger {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .header__burger span {
    height: 1.5px;
    background: currentColor;
  }

</style>

<script>
  import { initHeader } from '@/scripts/system/header';
  initHeader();
</script>
