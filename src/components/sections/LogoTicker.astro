---
// Ice-blue band of client logos scrolling continuously.
import { getCollection } from 'astro:content';
import Marquee from '../ui/Marquee.astro';

const logos = (await getCollection('clientLogos')).sort((a, b) => a.id.localeCompare(b.id));
---

<div class="logo-ticker">
  <Marquee duration={35} gap="2.5rem" class="logo-ticker__marquee">
    {logos.map(({ data }) => <img class="logo-ticker__logo" src={data.src} alt={data.alt} width="144" height="144" loading="lazy" />)}
  </Marquee>
</div>

<style>
  .logo-ticker {
    position: relative;
    display: flex;
    align-items: center;
    height: 15em;
    overflow: hidden;
    background-color: var(--accent);
  }

  .logo-ticker__logo {
    width: auto;
    height: 9rem;
    object-fit: contain;
  }

  @media screen and (max-width: 767px) {
    .logo-ticker {
      height: 11em;
    }
  }

  @media screen and (max-width: 479px) {
    .logo-ticker {
      height: auto;
    }

    .logo-ticker__logo {
      height: 7rem;
    }
  }
</style>
