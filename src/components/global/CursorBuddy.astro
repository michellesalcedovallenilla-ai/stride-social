---
// A cursor of liquid glass (desktop with a mouse), the same material as the navigation's capsule: a small bead that
// stretches with the speed of the pointer and bends what's behind it, with a fine point at its centre to aim with.
// Over anything pressable it melts into a capsule around it, and a press sends out a soft ripple. A round button at
// the right edge opens the picker: finish, size, the ripple, or back to the ordinary cursor. The choice stays on this
// device. Behaviour: src/scripts/system/cursor.ts. The words are drafts (src/content/pages/interactions.yaml).
import { interfaceCopy } from '@/lib/ui-copy';

const t = await interfaceCopy();
const finishes = ['clear', 'ice', 'steel', 'ink'] as const;
const sizes = ['small', 'medium', 'large'] as const;
---

<span class="bead" aria-hidden="true" data-bead data-finish="clear" data-size="medium"></span>
<span class="bead-point" aria-hidden="true" data-bead-point></span>

<div class="bead-pick desk-only" data-bead-pick hidden>
  <button class="bead-pick__open" type="button" aria-expanded="false" aria-controls="bead-panel" aria-label={t('cursor.open')} title={t('cursor.open')} data-bead-open>
    <span class="bead-pick__glass" data-finish="clear" data-bead-mini></span>
  </button>
  <div class="bead-pick__panel glass" id="bead-panel" role="group" aria-label={t('cursor.title')} hidden data-bead-panel>
    <p class="exp-label">{t('cursor.title')}</p>
    <div class="bead-pick__row" role="group" aria-label={t('cursor.finish')}>
      {finishes.map((f) => (
        <button class="bead-pick__choice" type="button" aria-pressed="false" aria-label={t(`cursor.finish.${f}`)} title={t(`cursor.finish.${f}`)} data-bead-set-finish={f}>
          <span class="bead-pick__glass" data-finish={f}></span>
        </button>
      ))}
    </div>
    <div class="bead-pick__row" role="group" aria-label={t('cursor.size')}>
      {sizes.map((s) => (
        <button class="bead-pick__choice" type="button" aria-pressed="false" aria-label={t(`cursor.size.${s}`)} title={t(`cursor.size.${s}`)} data-bead-set-size={s}>
          <span class="bead-pick__glass" data-finish="clear" data-size={s} data-swatch></span>
        </button>
      ))}
    </div>
    <div class="bead-pick__options">
      <button class="exp-chip" type="button" aria-pressed="true" data-bead-ripple>{t('cursor.ripple')}</button>
      <button class="exp-chip" type="button" aria-pressed="false" data-bead-off>{t('cursor.off')}</button>
    </div>
  </div>
</div>

<style>
  /* The finishes: what tints the glass. */
  [data-finish='clear'] {
    --tint: rgb(255 255 255 / 0.1);
  }

  [data-finish='ice'] {
    --tint: rgb(207 237 248 / 0.42);
  }

  [data-finish='steel'] {
    --tint: rgb(120 146 171 / 0.5);
  }

  [data-finish='ink'] {
    --tint: rgb(12 39 83 / 0.55);
  }

  /* The glass itself: a bright catch of light up on the left, a softer one low on the right, a thin bright rim and a
     hairline outside it so it shows on anything pale. */
  .bead,
  .bead-pick__glass {
    background:
      radial-gradient(circle at 33% 25%, rgb(255 255 255 / 0.85) 0 5%, rgb(255 255 255 / 0.26) 19%, transparent 44%),
      radial-gradient(circle at 70% 80%, rgb(255 255 255 / 0.3), transparent 40%),
      var(--tint);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.72),
      inset 0 -3px 6px rgb(6 20 43 / 0.14),
      0 0 0 0.5px rgb(6 20 43 / 0.3),
      0 7px 16px -5px rgb(6 20 43 / 0.45);
  }

  /* ---------- The bead ---------- */
  .bead {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9998;
    display: none;
    border-radius: var(--r, 999px);
    backdrop-filter: blur(2.5px) saturate(190%) brightness(1.1);
    -webkit-backdrop-filter: blur(2.5px) saturate(190%) brightness(1.1);
    pointer-events: none;
    will-change: transform, width, height;
    transition: opacity 180ms var(--ease-out);
  }

  /* The point to aim with, exactly on the pointer. */
  .bead-point {
    position: fixed;
    top: -2px;
    left: -2px;
    z-index: 9999;
    display: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 0.75px rgb(6 20 43 / 0.75);
    pointer-events: none;
    will-change: transform;
    transition: opacity 180ms var(--ease-out);
  }

  :global(html.has-bead) .bead,
  :global(html.has-bead) .bead-point {
    display: block;
  }

  .bead.is-away,
  .bead-point.is-away {
    opacity: 0;
  }

  /* Round a button: a capsule of clear glass, so what it wraps stays sharp. The point steps aside. */
  .bead.is-over {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.22), transparent 42%),
      var(--tint);
    backdrop-filter: saturate(150%) brightness(1.06);
    -webkit-backdrop-filter: saturate(150%) brightness(1.06);
  }

  .bead-point.is-over {
    opacity: 0;
  }

  /* The ripple: made by the script, so it's styled from outside this component. */
  :global(.bead-ripple) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9997;
    width: 16px;
    height: 16px;
    margin: -8px;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.85),
      0 0 0 0.5px rgb(6 20 43 / 0.28);
    pointer-events: none;
  }

  /* ---------- The picker ---------- */
  .bead-pick {
    position: fixed;
    top: 50%;
    right: 16px;
    z-index: 96;
    translate: 0 -50%;
  }

  .bead-pick[hidden] {
    display: none;
  }

  .bead-pick__glass {
    display: block;
    width: var(--s, 26px);
    height: var(--s, 26px);
    border-radius: 50%;
  }

  .bead-pick__glass[data-size='small'] {
    --s: 16px;
  }

  .bead-pick__glass[data-size='medium'] {
    --s: 24px;
  }

  .bead-pick__glass[data-size='large'] {
    --s: 32px;
  }

  .bead-pick__open {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(var(--panel) / 0.38);
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.24);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: scale 300ms cubic-bezier(0.2, 1.2, 0.4, 1);
  }

  .bead-pick__open:hover,
  .bead-pick__open[aria-expanded='true'] {
    scale: 1.08;
  }

  .bead-pick__open:focus-visible,
  .bead-pick__choice:focus-visible {
    outline: 2px solid rgb(var(--ink));
    outline-offset: 3px;
  }

  .bead-pick__panel {
    position: absolute;
    top: 50%;
    right: calc(100% + 12px);
    display: grid;
    gap: 10px;
    width: 232px;
    padding: 16px;
    background:
      linear-gradient(135deg, var(--navy-500), var(--navy-900));
    color: var(--white);
    transform: translateY(-50%);
    transform-origin: 100% 50%;
    animation: bead-open 280ms cubic-bezier(0.2, 1, 0.35, 1);
  }

  .bead-pick__panel .exp-label {
    color: rgb(255 255 255 / 0.8);
  }

  .bead-pick__panel[hidden] {
    display: none;
  }

  @keyframes bead-open {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  .bead-pick__row {
    display: flex;
    gap: 6px;
  }

  .bead-pick__choice {
    display: grid;
    place-items: center;
    flex: 1;
    height: 46px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
    transition:
      background-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
  }

  .bead-pick__choice:hover {
    background: rgb(255 255 255 / 0.07);
  }

  .bead-pick__choice[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.9);
  }

  .bead-pick__options {
    --ink: 255 255 255;
    --hair: 255 255 255;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .bead-pick__open,
    .bead-pick__panel {
      animation: none !important;
      transition: none;
    }
  }
</style>

<style is:global>
  /* The real pointer is hidden only while this one is on, and text fields keep theirs. */
  html.has-bead,
  html.has-bead * {
    cursor: none !important;
  }

  html.has-bead input:not([type='checkbox'], [type='radio'], [type='range']),
  html.has-bead textarea,
  html.has-bead select,
  html.has-bead [contenteditable='true'] {
    cursor: text !important;
  }
</style>

<script>
  import { initCursorBuddy } from '@/scripts/system/cursor';
  initCursorBuddy();
</script>
