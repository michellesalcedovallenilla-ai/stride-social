---
// Stride Social B2 "Trusted by brands": one refined row of monochrome logos (ice on navy) on a
// slow marquee that pauses on hover. Production shows only logos Stride has confirmed for display
// (Q5); preview builds also show the logos from the previous site, labelled. With nothing to show
// in production the section is left out.
import { getCollection } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';
import { logoFit } from '@/lib/logo-fit';

export interface Props {
  copy: { eyebrow?: string; awaiting?: string[] };
}

const { copy } = Astro.props;
const brands = await getCollection('brands', (b) => !!b.data.logo && (b.data.approval.status === 'confirmed' || (isPreview && b.data.approval.status === 'legacy')));
const interim = brands.some((b) => b.data.approval.status !== 'confirmed');
const logos = await Promise.all(
  brands.map(async (b) => ({ name: b.data.name, src: b.data.logo as string, fit: await logoFit(b.data.logo as string) })),
);
---

{logos.length > 0 && (
  <section class="logos" aria-labelledby="logos-title">
    <div class="logos__head container-wide">
      <Eyebrow tone="dark" as="div"><h2 id="logos-title" class="logos__title">{copy.eyebrow}</h2></Eyebrow>
      {interim && (
        <PlaceholderNotice variant="inline" label="Interim logos">
          — from the previous site, awaiting approval (Q5){copy.awaiting?.length ? `. Awaiting files: ${copy.awaiting.join(', ')}` : ''}
        </PlaceholderNotice>
      )}
    </div>
    <div class="logos__marquee" style={`--logo-count: ${logos.length}`}>
      {[0, 1].map((copyIndex) => (
        <ul class="logos__track" role="list" aria-hidden={copyIndex === 1 ? 'true' : undefined}>
          {logos.map((l) => (
            <li class="logos__item">
              <span class="logos__logo" role={copyIndex === 0 ? 'img' : undefined} aria-label={copyIndex === 0 ? l.name : undefined} style={`--logo: url('${l.src}'); ${l.fit}`}></span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>
)}

<style>
  .logos {
    position: relative;
    z-index: 1;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
    background: var(--navy-900);
    color: var(--white);
  }

  .logos__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-6);
  }

  .logos__title {
    font: inherit;
    letter-spacing: inherit;
  }

  .logos__marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .logos__track {
    display: flex;
    flex: none;
    animation: logos-scroll calc(var(--logo-count) * 3.2s) linear infinite;
  }

  .logos__marquee:hover .logos__track {
    animation-play-state: paused;
  }

  @keyframes logos-scroll {
    to { transform: translateX(-100%); }
  }

  .logos__item {
    flex: none;
    container-type: inline-size;
    width: clamp(120px, 11vw, 176px);
    margin-right: clamp(16px, 3vw, 48px);
  }

  /* Each source file is masked so every logo renders in the accent; src/lib/logo-fit.ts sizes the mark. */
  .logos__logo {
    display: block;
    aspect-ratio: 5 / 2;
    background: var(--accent);
    mask: var(--logo) var(--logo-pos) / var(--logo-size) no-repeat;
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .logos__marquee {
      mask-image: none;
    }

    .logos__track {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      padding-inline: var(--margin);
      animation: none;
    }

    .logos__track[aria-hidden] {
      display: none;
    }
  }
</style>
