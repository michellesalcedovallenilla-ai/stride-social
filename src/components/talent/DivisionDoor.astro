---
// A page waiting for its content (a talent division, the sponsorships archive): its name beside a frosted
// glass door, with its picture (where there is one) behind the frost. The glass clears in a soft circle
// wherever the pointer goes.
import Breadcrumbs from '../global/Breadcrumbs.astro';
import { interfaceCopy } from '@/lib/ui-copy';

export interface Props {
  name: string;
  tagline?: string | null;
  text: string[];
  image?: { src: string; alt: string } | null;
  crumbs: { label: string; href?: string }[];
  actions: { label: string; href: string }[];
  tone?: 'social' | 'talent' | 'education' | 'group';
  /** The palette colour it lives in. */
  look?: 'deep' | 'navy' | 'slate' | 'ice' | 'pale' | 'frost' | 'white';
  /** The small word above the name. */
  brand?: string;
}

const { name, tagline, text, image, crumbs, actions, tone = 'talent', look = 'navy', brand = 'Stride' } = Astro.props;
const t = await interfaceCopy();
const short = name.replace(/^Stride /, '');
const longest = Math.max(5, ...short.split(/\s+/).map((w) => w.length));
---

<section class="ddoor" aria-labelledby="ddoor-title" data-ddoor data-tone={tone} data-look={look}>
  <div class="ddoor__inner container-wide">
    <div class="ddoor__copy" data-reveal="from-left">
      <Breadcrumbs items={crumbs} tone="dark" />
      <h1 class="ddoor__name exp-title" id="ddoor-title" style={`--len: ${longest}`}><span class="exp-label">{brand}</span>{short}</h1>
      {tagline && <p class="ddoor__tagline">{tagline}</p>}
      {text.map((p) => <p class="ddoor__text">{p}</p>)}
      <div class="ddoor__actions">
        {actions.map((a, i) => (
          <a class:list={['exp-pill', { 'exp-pill--ghost': i > 0 }]} href={a.href}>
            {a.label}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
          </a>
        ))}
      </div>
    </div>

    <div class="ddoor__door on-photo" data-ddoor-door>
      {image ? <img src={image.src} alt={image.alt} sizes="(max-width: 1023px) 90vw, 44vw" fetchpriority="high" decoding="async" /> : <span class="ddoor__glow" aria-hidden="true"></span>}
      <div class="ddoor__leaf" data-ddoor-leaf>
        <span class="ddoor__frost" aria-hidden="true"></span>
        <span class="ddoor__sign exp-label" aria-hidden="true">{short}</span>
        <button class="ddoor__handle" type="button" aria-label={t('door.handle')} aria-pressed="false" title={t('door.hint')} data-ddoor-handle><span></span></button>
      </div>
      <p class="ddoor__hint exp-label desk-only" aria-hidden="true">{t('door.hint')}</p>
    </div>
  </div>
  <slot />
</section>

<style>
  .ddoor {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-6);
    overflow: hidden;
    color: rgb(var(--ink));
  }

  .ddoor__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-6) var(--gutter);
    align-items: center;
    width: 100%;
  }

  .ddoor__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    container-type: inline-size;
  }

  .ddoor__name {
    display: grid;
    gap: var(--space-2);
    font-size: min(7rem, calc(100cqi / (var(--len) * 0.84)));
  }

  .ddoor__tagline {
    font-size: var(--type-lead);
    color: rgb(var(--tone-lit));
  }

  .ddoor__text {
    max-width: 34rem;
    color: rgb(var(--ink) / 0.88);
  }

  .ddoor__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ---------- The door ---------- */
  .ddoor__door {
    position: relative;
    justify-self: center;
    width: min(100%, 28rem);
    height: min(76svh, 42rem);
    overflow: hidden;
    border-radius: 30px;
    background: var(--navy-700);
    perspective: 1600px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.26),
      0 40px 80px -30px rgb(var(--shade) / 0.85);
  }

  .ddoor__door img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: contrast(1.1) saturate(1.18) brightness(0.94);
  }

  .ddoor__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 35% 30%, rgb(var(--tone-lit) / 0.75), transparent 70%),
      radial-gradient(70% 60% at 70% 80%, rgb(var(--tone-depth) / 0.9), transparent 70%);
  }

  /* The door itself, hinged on its left edge. */
  .ddoor__leaf {
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--open, 0) * -74deg));
    transform-origin: left center;
    transition: transform 620ms cubic-bezier(0.2, 1.1, 0.3, 1);
  }

  .ddoor__door.is-turning .ddoor__leaf {
    transition: none;
  }

  .ddoor__frost {
    position: absolute;
    inset: 0;
    background: linear-gradient(165deg, rgb(255 255 255 / calc(0.2 * var(--fill-k))), rgb(255 255 255 / calc(0.06 * var(--fill-k))) 50%, rgb(255 255 255 / calc(0.12 * var(--fill-k))));
    backdrop-filter: blur(26px) saturate(150%);
    -webkit-backdrop-filter: blur(26px) saturate(150%);
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.3),
      inset 0 1px 0 rgb(255 255 255 / 0.5);
    -webkit-mask-image: radial-gradient(circle var(--clear, 0px) at var(--cx, 50%) var(--cy, 50%), transparent 72%, #000);
    mask-image: radial-gradient(circle var(--clear, 0px) at var(--cx, 50%) var(--cy, 50%), transparent 72%, #000);
  }

  .ddoor__handle {
    position: absolute;
    top: 50%;
    right: 6px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 110px;
    cursor: grab;
    touch-action: none;
    transform: translateY(-50%);
  }

  .ddoor__handle span {
    width: 8px;
    height: 72px;
    border-radius: 999px;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.4));
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.4);
    transition: scale 220ms var(--ease-out);
  }

  .ddoor__handle:hover span,
  .ddoor__door.is-turning .ddoor__handle span {
    scale: 1.25 1.08;
  }

  .ddoor__handle:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
    border-radius: 12px;
  }

  .ddoor__hint {
    position: absolute;
    bottom: 18px;
    left: 24px;
    margin-right: 60px;
    font-size: 0.625rem;
    text-shadow: 0 1px 8px rgb(6 20 43 / 0.6);
  }

  .ddoor__sign {
    position: absolute;
    top: 24px;
    left: 24px;
    color: rgb(var(--ink));
    text-shadow: 0 1px 8px rgb(var(--halo) / 0.6);
  }

  @media (max-width: 1023px) {
    .ddoor__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .ddoor__door {
      height: 44svh;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ddoor-door]').forEach((door) => {
    if (door.dataset.ready) return;
    door.dataset.ready = 'true';
    door.addEventListener(
      'pointermove',
      (e) => {
        const r = door.getBoundingClientRect();
        door.style.setProperty('--cx', `${(e.clientX - r.left).toFixed(0)}px`);
        door.style.setProperty('--cy', `${(e.clientY - r.top).toFixed(0)}px`);
        door.style.setProperty('--clear', '170px');
      },
      { passive: true },
    );
    door.addEventListener('pointerleave', () => door.style.setProperty('--clear', '0px'), { passive: true });

    // Pull the handle and the door swings open; let go and it finishes the swing, one way or the other.
    const handle = door.querySelector<HTMLButtonElement>('[data-ddoor-handle]');
    if (!handle) return;
    let open = 0;
    let startX = 0;
    let from = 0;
    let moved = false;
    let pressed = false;
    const set = (v: number) => {
      open = v;
      door.style.setProperty('--open', v.toFixed(3));
      handle.setAttribute('aria-pressed', String(v > 0.5));
    };
    handle.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      pressed = true;
      moved = false;
      startX = e.clientX;
      from = open;
      handle.setPointerCapture(e.pointerId);
    });
    handle.addEventListener('pointermove', (e) => {
      if (!pressed) return;
      const dx = startX - e.clientX;
      if (!moved && Math.abs(dx) < 4) return;
      moved = true;
      door.classList.add('is-turning');
      set(Math.min(1, Math.max(0, from + dx / (door.offsetWidth * 0.7))));
    });
    handle.addEventListener('pointerup', () => {
      if (!pressed) return;
      pressed = false;
      door.classList.remove('is-turning');
      if (moved) set(open > 0.35 ? 1 : 0);
    });
    handle.addEventListener('click', () => {
      if (moved) {
        moved = false;
        return;
      }
      set(open > 0.5 ? 0 : 1);
    });
  });
</script>
