---
// About page story: a sticky navy panel with a photo card that flips in when it scrolls into
// view, beside the founders' story and a timeline of sticky, stacking history cards.
export interface TimelineItem {
  year: string;
  title: string;
  /** Copy as HTML (line breaks kept as <br>, exactly as on the live page). */
  body: string;
}

export interface Props {
  image: { src: string; alt: string };
  story: { tag: string; heading: string; body: string };
  timelineTag: string;
  timelineHeading: string;
  timeline: TimelineItem[];
}

const { image, story, timelineTag, timelineHeading, timeline } = Astro.props;
---

<section class="about-story">
  <div class="about-story__block">
    <div class="about-story__grid">
      <div class="about-story__aside">
        <div class="about-story__panel" data-reveal>
          <div class="about-story__card">
            <div class="about-story__card-item">
              <div class="about-story__card-image">
                <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="about-story__list">
        <div class="about-story__intro">
          <div class="about-story__who">
            <div class="about-story__tag-wrap about-story__tag-wrap--heading">
              <div class="title-tag"><span class="title-tag__square" aria-hidden="true"></span><span class="title-tag__text">{story.tag}</span></div>
            </div>
            <h2 class="about-story__xl about-story__xl--who" data-split="letters-slide-up">{story.heading}</h2>
            <div class="about-story__paragraph">
              <p class="about-story__text" set:html={story.body} />
              <div class="about-story__spacer"></div>
            </div>
          </div>
          <div class="about-story__tag-wrap">
            <div class="title-tag"><span class="title-tag__square" aria-hidden="true"></span><span class="title-tag__text">{timelineTag}</span></div>
          </div>
          <div class="about-story__top">
            <h2 class="about-story__xl" data-split="letters-slide-up">{timelineHeading}</h2>
          </div>
        </div>

        {timeline.map((item) => (
          <article class="history-item">
            <div class="history-item__intro">
              <div class="history-item__title">
                <div class="history-item__year">
                  <div class="title-tag"><span class="title-tag__square" aria-hidden="true"></span><span class="title-tag__text">{item.year}</span></div>
                </div>
                <h3 class="history-item__heading">{item.title}</h3>
              </div>
              <p class="about-story__text" set:html={item.body} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-story {
    position: relative;
    z-index: 1;
  }

  .about-story__block {
    position: relative;
    z-index: 10;
    padding-top: 4rem;
    padding-bottom: 4.5rem;
    background-color: var(--color-smoke);
  }

  .about-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    row-gap: 16px;
    margin-top: -1rem;
    padding-left: 45px;
  }

  /* ---- Sticky photo panel ---- */
  .about-story__aside {
    position: sticky;
    top: 0;
    align-self: start;
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: 100vh;
    padding-block: 1rem;
  }

  .about-story__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  .about-story__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 70%;
    height: 100%;
  }

  .about-story__card-item {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .about-story__card-image {
    position: relative;
    width: 100%;
    padding-top: 81%;
    overflow: hidden;
  }

  .about-story__card-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* Flip-in when the panel scrolls into view (Webflow IX2 on the original). */
  :global(.js) .about-story__panel .about-story__card {
    opacity: 0;
    transform: translate3d(0, 85%, 0);
    transition:
      opacity 0.35s ease-out,
      transform 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.js) .about-story__panel .about-story__card-item {
    transform: scale3d(0.65, 0.65, 1) rotateY(180deg) rotateZ(25deg);
    transition: transform 1.8s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }

  :global(.js) .about-story__panel.is-revealed .about-story__card {
    opacity: 1;
    transform: none;
  }

  :global(.js) .about-story__panel.is-revealed .about-story__card-item {
    transform: none;
  }

  /* ---- Story + timeline column ---- */
  .about-story__list {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    padding: 5rem 0 4rem 4.5rem;
  }

  .about-story__intro {
    margin-bottom: 5.5rem;
  }

  .about-story__who {
    display: flex;
    flex-direction: column;
    max-width: 36rem;
  }

  .about-story__tag-wrap {
    padding-bottom: 3rem;
  }

  .title-tag {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .title-tag__square {
    width: 0.7rem;
    height: 0.7rem;
    background-color: var(--accent);
  }

  .title-tag__text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 20px;
    text-transform: uppercase;
  }

  .about-story__xl {
    font-family: var(--font-sans);
    font-size: 3.6rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    color: inherit;
  }

  .about-story__xl--who {
    margin-bottom: 3rem;
  }

  .about-story__paragraph {
    max-width: 30rem;
    padding-bottom: 2rem;
  }

  .about-story__text {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .about-story__spacer {
    height: 8rem;
  }

  .about-story__top {
    max-width: 30rem;
  }

  /* ---- Stacking history cards ---- */
  .history-item {
    position: sticky;
    top: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 6rem;
    border-top: 1px solid var(--color-line);
    background-color: var(--color-smoke);
  }

  .history-item__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
    max-width: 34rem;
  }

  .history-item__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .history-item__year {
    margin-bottom: 3rem;
  }

  .history-item__heading {
    font-family: var(--font-sans);
    font-size: 3rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.09rem;
    text-transform: uppercase;
  }

  @media screen and (max-width: 991px) {
    .about-story__grid {
      grid-template-columns: 1fr;
    }

    .about-story__aside {
      position: relative;
    }

    .about-story__panel {
      padding-block: 2rem;
    }

    .about-story__card {
      width: 70%;
    }

    .about-story__list {
      padding: 2rem 0 2rem 2rem;
    }

    .about-story__top {
      max-width: 25rem;
    }

    .history-item {
      padding-block: 3rem;
    }
  }

  @media screen and (max-width: 767px) {
    .about-story__block {
      padding-inline: 22px;
    }

    .about-story__grid {
      row-gap: 0;
      padding-left: 0;
    }

    .about-story__list {
      padding: 1.25rem 0 1.5rem;
    }

    .about-story__top {
      max-width: 20rem;
    }

    .about-story__xl {
      font-size: 2.8rem;
    }

    .history-item__heading {
      font-size: 1.5rem;
    }
  }

  @media screen and (max-width: 479px) {
    .about-story__block {
      padding-inline: 15px;
    }

    .about-story__card-item {
      width: 90%;
    }

    .title-tag {
      gap: 1rem;
    }

    .about-story__xl {
      font-size: 2.2rem;
      color: var(--color-navy);
    }

    .history-item__heading {
      font-size: 1.8rem;
      line-height: 1.3;
      color: var(--color-navy);
    }

    .about-story__text {
      font-size: 1rem;
      color: var(--color-navy-mute);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .about-story__panel .about-story__card,
    :global(.js) .about-story__panel .about-story__card-item {
      opacity: 1;
      transform: none;
    }
  }
</style>

