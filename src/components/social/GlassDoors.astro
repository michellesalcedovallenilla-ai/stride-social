---
// The services index: seven tall glass doors across the screen. A door opens wider under the pointer or
// keyboard focus, its frost clearing to show the service's picture, its name turning from the spine to
// the front, with what's behind it. The first stands open until you touch another. Choosing one goes to its
// page. CSS only; on small screens they stack.
import { getCollection } from 'astro:content';
import { routes } from '@/lib/routes';
import { pad } from '@/lib/experience';
import { interfaceCopy } from '@/lib/ui-copy';
const t = await interfaceCopy();

const services = (await getCollection('services')).sort((a, b) => a.data.number - b.data.number);
---

<ol class="doors" role="list" data-tone="social">
  {services.map((s) => (
    <li class="door on-photo">
      <a class="door__link" href={routes.service(s.id)}>
        {s.data.hero && <img class="door__image" src={s.data.hero.src} alt="" sizes="60vw" loading="lazy" decoding="async" />}
        <span class="door__frost" aria-hidden="true"></span>
        <span class="door__number">{pad(s.data.number)}</span>
        <span class="door__spine" aria-hidden="true">{s.data.name}</span>
        <span class="door__front">
          <h2 class="door__name exp-title">{s.data.name}</h2>
          <span class="door__line">{s.data.descriptor}</span>
          {s.data.deliverables.length > 0 && (
            <ol class="door__list" role="list">
              {s.data.deliverables.slice(0, 5).map((d, i) => <li><span aria-hidden="true">{pad(i + 1)}</span>{d}</li>)}
            </ol>
          )}
        </span>
        <span class="door__knob" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
        </span>
      </a>
      <button class="door__keep exp-pill exp-pill--ghost desk-only" type="button" aria-pressed="false" data-keep="brief" data-keep-id={s.id} data-keep-label={s.data.name} data-keep-group={s.id}>
        <span class="keep-off">{t('door.add')}</span><span class="keep-on">{t('door.added')}</span>
      </button>
    </li>
  ))}
</ol>

<style>
  .doors {
    position: relative;
    z-index: 1;
    display: flex;
    gap: clamp(8px, 0.8vw, 14px);
    height: 100%;
    min-height: 420px;
  }

  .door {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 720ms cubic-bezier(0.2, 1, 0.3, 1);
  }

  /* Open: under the pointer, in focus, or the first while none is. */
  .door:hover,
  .door:focus-within,
  .doors:not(:hover, :focus-within) .door:first-child {
    flex-grow: 4.6;
  }

  .door__link {
    position: relative;
    isolation: isolate;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 26px;
    color: rgb(var(--ink));
    background: var(--navy-700);
    box-shadow: 0 30px 60px -34px rgb(var(--shade) / 0.7);
  }

  .door__link:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 3px;
  }

  .door__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: contrast(1.1) saturate(1.18) brightness(0.94);
    transform: scale(1.08);
    transition: transform 900ms cubic-bezier(0.2, 1, 0.3, 1);
  }

  /* The frost: thick on a closed door, clearing as it opens. */
  .door__frost {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(165deg, rgb(120 146 171 / 0.3), rgb(12 39 83 / 0.72) 60%, rgb(6 20 43 / 0.84));
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow:
      inset 0 0 0 1px rgb(var(--hair) / 0.2),
      inset 0 1px 0 rgb(255 255 255 / 0.4);
    transition:
      background-color 500ms var(--ease-out),
      box-shadow 500ms var(--ease-out),
      backdrop-filter 500ms var(--ease-out);
  }

  .door:hover .door__image,
  .door:focus-within .door__image,
  .doors:not(:hover, :focus-within) .door:first-child .door__image {
    transform: none;
  }

  .door:hover .door__frost,
  .door:focus-within .door__frost,
  .doors:not(:hover, :focus-within) .door:first-child .door__frost {
    background: linear-gradient(to right, rgb(6 20 43 / 0.88), rgb(6 20 43 / 0.48) 55%, rgb(6 20 43 / 0.18));
    backdrop-filter: blur(0) saturate(100%);
    -webkit-backdrop-filter: blur(0) saturate(100%);
    box-shadow:
      inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.95),
      0 0 30px -4px rgb(var(--tone-glow) / 0.6);
  }

  .door__number {
    position: absolute;
    top: 20px;
    left: 20px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    color: rgb(var(--tone-lit));
  }

  /* The name on the spine of a closed door. */
  .door__spine {
    position: absolute;
    bottom: 22px;
    left: 50%;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 1.25vw, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
    transition: opacity 260ms var(--ease-out);
  }

  /* What's on the front of an open one. */
  .door__front {
    position: absolute;
    right: 24px;
    bottom: 24px;
    left: 24px;
    display: grid;
    gap: var(--space-3);
    min-width: min(24rem, 40vw);
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 240ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .door:hover .door__spine,
  .door:focus-within .door__spine,
  .doors:not(:hover, :focus-within) .door:first-child .door__spine {
    opacity: 0;
  }

  .door:hover .door__front,
  .door:focus-within .door__front,
  .doors:not(:hover, :focus-within) .door:first-child .door__front {
    opacity: 1;
    transform: none;
    transition-delay: 180ms;
  }

  .door__name {
    font-size: clamp(1.5rem, 2.5vw, 2.75rem);
  }

  .door__line {
    max-width: 28rem;
    font-size: var(--type-lead);
    line-height: 1.32;
    color: rgb(var(--ink) / 0.92);
  }

  .door__list {
    display: grid;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--ink) / 0.76);
  }

  .door__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
  }

  .door__list span {
    color: rgb(var(--tone-lit));
  }

  .door__knob {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 240ms var(--ease-out),
      transform 420ms cubic-bezier(0.2, 1.6, 0.35, 1);
  }

  .door__knob svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .door:hover .door__knob,
  .door:focus-within .door__knob,
  .doors:not(:hover, :focus-within) .door:first-child .door__knob {
    opacity: 1;
    transform: none;
    transition-delay: 180ms;
  }

  /* ---------- Small screens: stacked, each already open ---------- */
  @media (max-width: 1023px) {
    .doors {
      flex-direction: column;
      height: auto;
    }

    .door {
      flex: none;
    }

    .door__link {
      min-height: 300px;
    }

    .door__spine {
      display: none;
    }

    .door__front {
      opacity: 1;
      transform: none;
      min-width: 0;
    }

    .door__knob {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .door,
    .door__image,
    .door__frost,
    .door__spine,
    .door__front,
    .door__knob {
      transition: none;
    }
  }

  /* Adding a service to the brief, on an open door. */
  .door {
    position: relative;
  }

  .door__keep {
    position: absolute;
    top: 14px;
    left: 62px;
    z-index: 2;
    min-height: 34px;
    padding: 4px 14px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 240ms var(--ease-out),
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }

  .door__keep[aria-pressed='true'] {
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .door:hover .door__keep,
  .door:focus-within .door__keep,
  .doors:not(:hover, :focus-within) .door:first-child .door__keep {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 180ms;
  }
</style>
