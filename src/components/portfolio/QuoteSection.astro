---
// Centered client quote under the case study body.
export interface Props {
  quote: string;
}

const { quote } = Astro.props;
---

<section class="case-quote">
  <figure class="case-quote__wrapper">
    <p class="case-quote__mark" aria-hidden="true">"</p>
    <blockquote class="case-quote__text">
      <p data-split="letters-slide-up">{quote}</p>
    </blockquote>
  </figure>
</section>

<style>
  .case-quote {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 4rem 45px;
    background-color: var(--color-smoke-2);
  }

  .case-quote__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 60vw;
    margin: 0;
    padding: 4rem 0;
  }

  .case-quote__mark,
  .case-quote__text {
    font-family: var(--font-sans);
    text-align: center;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .case-quote__mark {
    font-size: 6em;
    font-weight: 700;
    line-height: 1;
  }

  .case-quote__text {
    margin: 0;
    font-size: 3.3em;
    font-weight: 200;
    line-height: 1.1;
  }

  @media screen and (max-width: 991px) {
    .case-quote__wrapper {
      max-width: 90vw;
    }
  }

  @media screen and (max-width: 479px) {
    .case-quote {
      padding-left: 25px;
      padding-right: 25px;
    }

    .case-quote__wrapper {
      max-width: 100vw;
    }

    .case-quote__text {
      font-size: 30px;
    }
  }
</style>
