---
// Homepage A3 "ONE GROUP. BUILT FOR WHAT'S NEXT.": split screen, photograph bleeding to the
// left edge, story on paper to the right.
import Media from '../core/Media.astro';
import Eyebrow from '../core/Eyebrow.astro';
import Button from '../core/Button.astro';
import DraftTag from '../core/DraftTag.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';

export interface Props {
  copy: { status: 'approved' | 'draft'; eyebrow?: string; headline?: string; body?: string; cta?: { label: string; href: string } };
  image: { src: string; alt: string; position?: string };
  interim?: boolean;
}

const { copy, image, interim = false } = Astro.props;
const paragraphs = (copy.body ?? '').split(/\n\s*\n/).filter(Boolean);
---

<section class="group" aria-labelledby="group-title">
  <div class="group__visual" data-reveal="rise">
    <Media image={image} position={image.position} class="group__media" />
    {interim && <PlaceholderNotice label="Interim image" />}
  </div>
  <div class="group__text">
    <Eyebrow>{copy.eyebrow}</Eyebrow>
    <h2 class="group__title" id="group-title" data-reveal-lines>{copy.headline}</h2>
    <DraftTag status={copy.status} />
    <div class="group__body" data-reveal="rise" style="--reveal-delay: 0.15s">
      {paragraphs.map((p, i) => <p class:list={{ 'group__lead': i === 0 }}>{p}</p>)}
    </div>
    {copy.cta && (
      <div data-reveal="rise" style="--reveal-delay: 0.25s">
        <Button href={copy.cta.href} variant="text">{copy.cta.label}</Button>
      </div>
    )}
  </div>
</section>

<style>
  .group {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(100vh, 920px);
    background: var(--paper);
  }

  .group__visual {
    position: relative;
    min-height: 520px;
    overflow: hidden;
  }

  .group__visual :global(.media__el) {
    filter: saturate(0.9) contrast(1.04);
  }

  .group__text {
    display: grid;
    align-content: center;
    gap: var(--space-6);
    padding: var(--section-pad) var(--margin) var(--section-pad) clamp(var(--space-7), 6vw, var(--space-10));
    max-width: 760px;
  }

  .group__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5.25rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .group__body {
    display: grid;
    gap: var(--space-4);
    max-width: 52ch;
    color: var(--slate);
  }

  .group__lead {
    font-size: var(--type-lead);
    line-height: 1.4;
    color: var(--navy-900);
  }

  @media (max-width: 1023px) {
    .group {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .group__visual {
      aspect-ratio: 4 / 5;
      min-height: 0;
      max-height: 80svh;
    }

    .group__text {
      padding: var(--space-8) var(--margin) var(--space-9);
    }
  }
</style>
