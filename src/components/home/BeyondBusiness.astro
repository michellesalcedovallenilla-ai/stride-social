---
// Homepage A7 "Beyond business": a photo story of approved sponsorships. Hidden until at least
// one confirmed entry exists; preview builds show a labelled placeholder instead (no stock
// imagery, brief §3.7).
import { getCollection } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import Button from '../core/Button.astro';
import DraftTag from '../core/DraftTag.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';

export interface Props {
  copy: { status: 'approved' | 'draft'; eyebrow?: string; headline?: string; body?: string; cta?: { label: string; href: string } };
}

const { copy } = Astro.props;
const entries = (await getCollection('sponsorships', (s) => s.data.approval.status === 'confirmed')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year,
);
const [lead, ...rest] = entries;
---

{lead ? (
  <section class="beyond" aria-labelledby="beyond-title">
    <div class="beyond__lead">
      <img src={lead.data.images[0].src} alt={lead.data.images[0].alt} loading="lazy" decoding="async" />
      <div class="beyond__overlay">
        <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
        <h2 class="beyond__title" id="beyond-title" data-reveal-lines>{copy.headline}</h2>
        {copy.body && <p class="beyond__body">{copy.body}</p>}
        <DraftTag status={copy.status} />
      </div>
    </div>
    {rest.length > 0 && (
      <ul class="beyond__rail" role="list" tabindex="0" aria-label="Sponsorships">
        {rest.slice(0, 6).map((s) => (
          <li class="beyond__item">
            <img src={s.data.images[0].src} alt={s.data.images[0].alt} loading="lazy" decoding="async" />
            <p class="beyond__partner">{s.data.partner} · {s.data.year}</p>
            <p>{s.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
    {copy.cta && <div class="beyond__cta"><Button href={copy.cta.href} variant="text">{copy.cta.label}</Button></div>}
  </section>
) : (
  isPreview && (
    <section class="beyond beyond--empty" aria-labelledby="beyond-title">
      <div class="beyond__empty">
        <Eyebrow>{copy.eyebrow}</Eyebrow>
        <h2 class="beyond__title beyond__title--dark" id="beyond-title">{copy.headline}</h2>
        <PlaceholderNotice variant="block" label="Hidden in production until content exists">
          <p>
            Sponsorships, creator partnerships, community projects and local sports sponsorships go here as soon as Stride supplies
            them (Q12): one Markdown file per entry in src/content/sponsorships. This section is not rendered on the live site while
            it is empty.
          </p>
        </PlaceholderNotice>
      </div>
    </section>
  )
)}

<style>
  .beyond {
    position: relative;
    z-index: 1;
    background: var(--paper);
  }

  .beyond__lead {
    position: relative;
    min-height: min(90vh, 860px);
    overflow: hidden;
    color: var(--white);
  }

  .beyond__lead img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .beyond__overlay {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-9) var(--margin) var(--space-8);
    background: linear-gradient(to top, rgb(6 20 43 / 0.85), transparent);
  }

  .beyond__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .beyond__body {
    max-width: 48ch;
    font-size: var(--type-lead);
  }

  .beyond__rail {
    display: flex;
    gap: var(--gutter);
    padding: var(--space-7) var(--margin);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .beyond__item {
    flex: 0 0 min(80vw, 360px);
    display: grid;
    gap: var(--space-2);
    scroll-snap-align: start;
  }

  .beyond__item img {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
  }

  .beyond__partner {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    text-transform: uppercase;
    color: var(--slate);
  }

  .beyond__cta {
    padding: 0 var(--margin) var(--space-8);
  }

  .beyond__empty {
    display: grid;
    gap: var(--space-5);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: var(--space-9) var(--margin);
  }

  .beyond__title--dark {
    color: var(--navy-900);
  }
</style>
