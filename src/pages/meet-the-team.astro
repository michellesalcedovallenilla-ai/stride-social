---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarqueeHero from '@/components/sections/MarqueeHero.astro';
import TeamGrid from '@/components/company/TeamGrid.astro';
import { footerCtas } from '@/config/site';
import team from '@/content/data/company-team.json';
// AboutPage structured data kept as on the live page (its employee list predates the newer hires).
import jsonLd from '@/data/company-team-jsonld.json';
---

<BaseLayout
  title="Meet The Team at Stride Social"
  description="We provide a range or services from social media marketing, talent management and google media buying and this is our fantastic team"
  nav="transparent"
  footerCta={footerCtas.standard}
  jsonLd={[jsonLd]}
>
  <MarqueeHero tone="dark" title="Meet the team" intro="Our talented bunch are the brains and the braun behind our opertaion." />
  <TeamGrid members={team} />
</BaseLayout>
