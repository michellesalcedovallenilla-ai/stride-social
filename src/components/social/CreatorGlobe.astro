---
// Stride Social: the creator globe. A stylised, cut-away globe (the top of a sphere sliced across,
// its cross-section showing below the rim) acts as a region selector; a phone shows the selected
// region's creator content as a reel. Drag or swipe the globe, scroll through the section (the
// stage stays pinned while each region takes a turn), or use the region list. Behaviour:
// src/scripts/system/creator-globe.ts. Regions and creators: src/config/creator-regions.ts.
// A creator appears only with confirmed consent and a recorded country; until then a region shows
// its case study's own footage, labelled "Interim", or a labelled empty state. Nothing is invented.
import { getEntry, getEntries } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import DraftTag from '../core/DraftTag.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { creatorRegions } from '@/config/creator-regions';
import { getRoster } from '@/lib/roster';
import { workPreviews } from '@/lib/previews';
import { routes } from '@/lib/routes';

export interface Props {
  copy: { status: 'approved' | 'draft'; eyebrow?: string; headline?: string; body?: string };
}

const { copy } = Astro.props;
const roster = await getRoster();
const byId = new Map(roster.map((c) => [c.id, c]));
const countryName = new Intl.DisplayNames(['en'], { type: 'region' });
const platformOf = (p: Record<string, string | undefined>) =>
  p.tiktok ? 'TikTok' : p.instagram ? 'Instagram' : p.youtube ? 'YouTube' : p.twitch ? 'Twitch' : undefined;

const regions = await Promise.all(
  creatorRegions.map(async (r) => {
    const c = r.creator ? byId.get(r.creator) : undefined;
    const confirmed = c && c.data.consent.status === 'confirmed' && c.data.country;
    const category = confirmed && c.data.mainCategory ? await getEntry(c.data.mainCategory) : undefined;
    const creator = confirmed
      ? {
          name: c.data.name,
          href: routes.creator(c.id),
          country: countryName.of(c.data.country!) ?? c.data.country!,
          platform: platformOf(c.data.platforms),
          niche: category?.data.label,
          portrait: c.data.portrait,
        }
      : null;
    const w = r.work ? await getEntry('work', r.work) : undefined;
    const brand = w ? await getEntry(w.data.client) : undefined;
    const services = w ? await getEntries(w.data.services) : [];
    const work = w
      ? {
          title: w.data.title,
          href: routes.caseStudy(w.id),
          brand: brand?.data.name ?? w.data.title,
          service: services[0]?.data.name,
          video: workPreviews[w.id],
          poster: (w.data.homeTile?.front ?? w.data.hero ?? w.data.card).src,
        }
      : null;
    return { key: r.key, label: r.label, lat: r.lat, lon: r.lon, creator, work };
  }),
);
const globeData = JSON.stringify(regions.map(({ key, label, lat, lon }) => ({ key, label, lat, lon })));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="globe" aria-labelledby="globe-title" data-creator-globe data-regions={globeData} style={`--steps: ${regions.length}`}>
  <div class="globe__stage">
    <canvas class="globe__canvas" data-globe-canvas aria-hidden="true"></canvas>

    <div class="globe__intro">
      <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
      <h2 class="globe__title" id="globe-title" data-reveal="from-left">{copy.headline}</h2>
      {copy.body && <p class="globe__body">{copy.body}</p>}
      <DraftTag status={copy.status} />
      <div class="globe__regions" role="tablist" aria-label="Regions" data-globe-tabs>
        {regions.map((r, i) => (
          <button
            class="globe__region"
            type="button"
            role="tab"
            id={`globe-tab-${r.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="globe-phone"
            tabindex={i === 0 ? 0 : -1}
            data-globe-tab={i}
          >
            <span class="globe__region-num" aria-hidden="true">{pad(i + 1)}</span>{r.label}
          </button>
        ))}
      </div>
    </div>

    {/* The phone: one screen per region, the selected one in front. */}
    <div class="phone" id="globe-phone" role="tabpanel" aria-labelledby={`globe-tab-${regions[0].key}`} data-globe-phone>
      <div class="phone__body">
        <span class="phone__island" aria-hidden="true"></span>
        {regions.map((r, i) => (
          <div class:list={['phone__screen', { 'is-active': i === 0 }]} data-globe-screen={i} aria-hidden={i === 0 ? undefined : 'true'}>
            {r.work?.video ? (
              <video class="phone__media" muted loop playsinline preload="none" poster={r.work.poster} aria-label={`${r.work.brand} campaign footage`} data-globe-video>
                <source src={r.work.video} type="video/mp4" />
              </video>
            ) : r.creator?.portrait ? (
              <img class="phone__media" src={r.creator.portrait.src} alt={r.creator.portrait.alt} sizes="300px" loading="lazy" decoding="async" />
            ) : (
              <PlaceholderNotice variant="block" label={`Creator for ${r.label}`} class="phone__empty">— awaiting Stride: creator, consent and content</PlaceholderNotice>
            )}

            <div class="phone__ui">
              <p class="phone__top" aria-hidden="true"><span>Reels</span><span class="phone__cam"></span></p>
              <ul class="phone__actions" role="list" aria-hidden="true">
                <li><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></li>
                <li><svg viewBox="0 0 24 24"><path d="M5 18.5V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8.5L5 18.5Z" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></li>
                <li><svg viewBox="0 0 24 24"><path d="M4 12 20 4l-6 16-2.5-6.5L4 12Z" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></li>
              </ul>
              <div class="phone__meta">
                {r.creator ? (
                  <a class="phone__handle" href={r.creator.href}>@{r.creator.name}</a>
                ) : (
                  <p class="phone__handle phone__handle--pending">Creator to be confirmed</p>
                )}
                {r.work && <a class="phone__caption" href={r.work.href}>{r.work.brand}{r.work.service && ` · ${r.work.service}`}</a>}
                <p class="phone__chips">
                  <span class="phone__chip"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14s5-4.2 5-8A5 5 0 0 0 3 6c0 3.8 5 8 5 8Z M8 7.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg>{r.creator ? r.creator.country : r.label}</span>
                  {r.creator?.platform && <span class="phone__chip">{r.creator.platform}</span>}
                  {r.creator?.niche && <span class="phone__chip">{r.creator.niche}</span>}
                </p>
              </div>
            </div>
            {!r.creator && r.work && <PlaceholderNotice label="Interim" class="phone__interim"><span class="phone__interim-text">— case study footage; creator and location to be confirmed</span></PlaceholderNotice>}
          </div>
        ))}
        <button class="phone__toggle" type="button" data-globe-toggle aria-label="Pause video">
          <svg class="phone__icon phone__icon--pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor"></path></svg>
          <svg class="phone__icon phone__icon--play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor"></path></svg>
        </button>
      </div>
    </div>

    {/* The selected region, editorial-size, with its index and campaign. */}
    <div class="globe__readout" aria-hidden="true">
      {regions.map((r, i) => (
        <div class:list={['globe__now', { 'is-active': i === 0 }]} data-globe-now={i}>
          <p class="globe__index">{pad(i + 1)} / {pad(regions.length)}</p>
          <p class="globe__name">{r.label}</p>
          {r.work && <p class="globe__campaign">Campaign · {r.work.brand}</p>}
        </div>
      ))}
      <p class="globe__hint">Drag the globe · scroll to explore</p>
    </div>

    <p class="globe__status" aria-live="polite" data-globe-status></p>
  </div>
</section>

<style>
  /* The section is as tall as one screen per region; the stage stays pinned while each takes a turn. */
  .globe {
    position: relative;
    height: calc(100svh + (var(--steps) - 1) * 55svh);
    background: var(--navy-900);
    color: var(--white);
  }

  .globe__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--gutter);
    padding: calc(var(--header-h) + var(--space-5)) var(--margin) 0;
  }

  /* The globe fills the lower part of the stage, behind everything. */
  .globe__canvas {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 52%;
    touch-action: pan-y;
    cursor: grab;
  }

  .globe.is-dragging .globe__canvas {
    cursor: grabbing;
  }

  /* ---------- Intro and region list ---------- */
  .globe__intro {
    position: relative;
    align-self: start;
    display: grid;
    gap: var(--space-4);
    max-width: 30rem;
    padding-top: var(--space-6);
  }

  .globe__title {
    font-family: var(--font-display);
    font-size: var(--type-h1);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .globe__body {
    max-width: 32ch;
    color: rgb(255 255 255 / 0.8);
  }

  .globe__regions {
    display: grid;
    justify-items: start;
    gap: 2px;
    margin-top: var(--space-4);
  }

  .globe__region {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 36px;
    padding: 0 var(--space-4) 0 var(--space-3);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .globe__region-num {
    color: var(--ice);
  }

  .globe__region:hover {
    color: var(--white);
  }

  .globe__region[aria-selected='true'] {
    background: var(--white);
    color: var(--navy-900);
  }

  .globe__region[aria-selected='true'] .globe__region-num {
    color: var(--navy-900);
  }

  .globe__region:focus-visible {
    outline: 2px solid var(--ice);
    outline-offset: 2px;
  }

  /* ---------- Phone ---------- */
  .phone {
    position: relative;
    z-index: 2;
    align-self: start;
    margin-top: clamp(var(--space-2), 2vh, var(--space-6));
  }

  .phone__body {
    position: relative;
    height: min(62svh, 620px);
    aspect-ratio: 9 / 19;
    overflow: hidden;
    border-radius: 44px;
    background: #000;
    box-shadow:
      0 0 0 2px #2a2f38,
      0 0 0 9px #0b0d12,
      0 0 0 10px #3a404b,
      0 40px 80px rgb(0 0 0 / 0.55);
    isolation: isolate;
  }

  .phone__island {
    position: absolute;
    top: 10px;
    left: 50%;
    z-index: 5;
    width: 30%;
    height: 24px;
    border-radius: 999px;
    background: #000;
    translate: -50% 0;
  }

  /* Screens stack; the selected one sits in front. A change slides the new reel up, like a swipe. */
  .phone__screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 620ms var(--ease-out),
      opacity 300ms var(--ease-out),
      filter 620ms var(--ease-out);
  }

  .phone__screen.is-active {
    z-index: 1;
    opacity: 1;
    transform: none;
  }

  .phone__screen.is-before {
    transform: translateY(-30%);
    filter: blur(6px);
  }

  .phone__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A region still waiting for its creator: a quiet, centred empty screen with its label. */
  .globe :global(.phone__empty) {
    position: absolute;
    inset: 0;
    align-content: center;
    justify-items: center;
    padding: var(--space-8) var(--space-5);
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(90% 60% at 50% 40%, rgb(195 242 251 / 0.16), transparent 70%),
      var(--navy-700);
    text-align: center;
    font-size: var(--type-small);
    color: rgb(255 255 255 / 0.75);
  }

  .globe :global(.phone__interim) {
    top: 48px;
    left: var(--space-3);
    right: auto;
    max-width: calc(100% - var(--space-5));
  }

  .phone__ui {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 46px var(--space-4) var(--space-5);
    background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent 38%);
    pointer-events: none;
  }

  .phone__ui a {
    pointer-events: auto;
  }

  .phone__top {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .phone__cam {
    width: 20px;
    height: 16px;
    border: 1.6px solid currentColor;
    border-radius: 4px;
  }

  .phone__actions {
    align-self: end;
    justify-self: end;
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .phone__actions svg {
    width: 26px;
    height: 26px;
  }

  .phone__meta {
    display: grid;
    gap: 6px;
    font-size: 0.8125rem;
  }

  .phone__handle {
    font-weight: 700;
  }

  .phone__handle--pending {
    color: rgb(255 255 255 / 0.7);
    font-weight: 500;
  }

  .phone__caption {
    color: rgb(255 255 255 / 0.9);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-underline-offset: 3px;
  }

  .phone__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .phone__chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    font-size: 0.6875rem;
    backdrop-filter: blur(4px);
  }

  .phone__chip svg {
    width: 12px;
    height: 12px;
  }

  .phone__toggle {
    position: absolute;
    right: var(--space-3);
    top: 44px;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    color: var(--white);
  }

  .phone__toggle:focus-visible {
    outline: 2px solid var(--ice);
  }

  .phone__icon {
    width: 12px;
    height: 12px;
  }

  .phone__icon--play,
  .phone.is-paused .phone__icon--pause {
    display: none;
  }

  .phone.is-paused .phone__icon--play {
    display: block;
  }

  .phone.has-no-video .phone__toggle {
    display: none;
  }

  /* ---------- Readout ---------- */
  .globe__readout {
    position: relative;
    align-self: start;
    justify-self: end;
    display: grid;
    min-width: 0;
    padding-top: var(--space-6);
    text-align: right;
  }

  .globe__now {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(16px);
    filter: blur(6px);
    transition:
      opacity 400ms var(--ease-out),
      transform 600ms var(--ease-out),
      filter 500ms var(--ease-out);
  }

  .globe__now.is-active {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .globe__index,
  .globe__campaign,
  .globe__hint {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }

  .globe__name {
    margin-block: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .globe__hint {
    margin-top: var(--space-6);
    color: rgb(255 255 255 / 0.45);
  }

  .globe__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1023px) {
    .globe__stage {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .globe__readout {
      display: none;
    }
  }

  /* ---------- Phones: heading, region pills, the phone, the globe below ---------- */
  @media (max-width: 767px) {
    .globe {
      height: calc(100svh + (var(--steps) - 1) * 45svh);
    }

    .globe__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      justify-items: center;
      align-items: start;
      gap: var(--space-4);
      padding-top: calc(var(--header-h) + var(--space-3));
    }

    .globe__intro {
      justify-self: stretch;
      gap: var(--space-3);
      padding-top: 0;
    }

    .globe__title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }

    .globe__body {
      display: none;
    }

    /* Regions become a row of pills you can swipe. */
    .globe__regions {
      display: flex;
      gap: var(--space-2);
      margin: 0 calc(var(--margin) * -1);
      padding: 0 var(--margin);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .globe__region {
      flex: none;
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
    }

    .phone {
      margin-top: 0;
    }

    .phone__body {
      height: min(46svh, 420px);
      border-radius: 34px;
    }

    .globe__canvas {
      height: 36%;
    }

    /* On a phone-sized screen the label alone says it; the detail would cover the reel. */
    .globe :global(.phone__interim-text) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone__screen,
    .globe__now {
      transition: none;
    }
  }
</style>

<script>
  import { initCreatorGlobes } from '@/scripts/system/creator-globe';
  initCreatorGlobes();
</script>
