---
// Sticky card in the story column: tag, light uppercase title and copy. Consecutive items
// stick 3rem from the top and stack over each other while scrolling (services, seeding steps).
import TitleTag from './TitleTag.astro';
import StoryCopy from './StoryCopy.astro';

export interface Props {
  label: string;
  title: string;
  html: string;
}

const { label, title, html } = Astro.props;
---

<article class="story-item">
  <div class="story-item__intro">
    <div class="story-item__title">
      <div class="story-item__tag"><TitleTag>{label}</TitleTag></div>
      <h3 class="story-item__heading">{title}</h3>
    </div>
    <StoryCopy html={html} />
  </div>
</article>

<style>
  .story-item {
    position: sticky;
    top: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 6rem 0;
    border-top: 1px solid var(--color-line);
    background-color: var(--color-smoke);
  }

  .story-item__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
    max-width: 34rem;
  }

  .story-item__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .story-item__tag {
    margin-bottom: 3rem;
  }

  .story-item__heading {
    font-family: var(--font-sans);
    font-size: 3rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.09rem;
    text-transform: uppercase;
    color: var(--color-text);
  }

  @media screen and (max-width: 991px) {
    .story-item {
      padding: 3rem 0;
    }
  }

  @media screen and (max-width: 767px) {
    .story-item__heading {
      font-size: 1.5rem;
    }
  }

  @media screen and (max-width: 479px) {
    .story-item__heading {
      font-size: 1.8rem;
      line-height: 1.3;
      color: var(--color-navy);
    }
  }
</style>
