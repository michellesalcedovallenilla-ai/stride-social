---
// Typography for CMS rich text (case studies, blog posts, jobs, creator bios).
// Pass rendered HTML via `html`, or render Markdown content (<Content />) into the slot.
export interface Props {
  html?: string;
  /** `full` removes the 60% max width; `padded` adds right padding (blog body). */
  width?: 'default' | 'full' | 'narrow';
  padded?: boolean;
  class?: string;
}

const { html, width = 'default', padded = false, class: className, ...rest } = Astro.props;
---

<div class:list={['rich-text', `rich-text--${width}`, { 'rich-text--padded': padded }, className]} {...rest}>
  {html ? <Fragment set:html={html} /> : <slot />}
</div>

<style>
  .rich-text {
    max-width: 60%;
    margin-bottom: 35px;
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: #6d6d6d;
  }

  .rich-text--full {
    max-width: 100%;
  }

  .rich-text--narrow {
    max-width: 33rem;
  }

  .rich-text--padded {
    padding-right: 4rem;
  }

  .rich-text :global(> :first-child) {
    margin-top: 0;
  }

  .rich-text :global(h1),
  .rich-text :global(h2),
  .rich-text :global(h3),
  .rich-text :global(h4) {
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .rich-text :global(h1) {
    margin-bottom: 2.5rem;
    font-size: 3.7rem;
    font-weight: 900;
  }

  .rich-text :global(h2) {
    margin-bottom: 2rem;
    font-size: 2.8rem;
    font-weight: 800;
  }

  .rich-text :global(h3) {
    margin-bottom: 1rem;
    font-size: 2.4rem;
    font-weight: 600;
  }

  .rich-text :global(h4) {
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .rich-text :global(h5),
  .rich-text :global(h6) {
    color: var(--color-navy-mute);
  }

  .rich-text :global(p) {
    margin-bottom: 35px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-navy-mute);
  }

  .rich-text :global(a) {
    color: var(--color-navy);
  }

  .rich-text :global(ul),
  .rich-text :global(ol) {
    margin-bottom: 10px;
    padding-left: 40px;
    overflow: hidden;
    font-size: 1rem;
    color: var(--color-navy-mute);
  }

  .rich-text :global(li) {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .rich-text :global(blockquote) {
    margin: 0 0 10px;
    padding: 10px 20px;
    border-left: 5px solid #e2e2e2;
    font-size: 1rem;
    line-height: 22px;
  }

  .rich-text :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-bottom: 35px;
  }

  .rich-text :global(figure) {
    max-width: 60%;
    margin: 0 0 35px;
  }

  .rich-text :global(figure img) {
    width: 100%;
  }

  .rich-text :global(table) {
    width: 100%;
    margin-bottom: 35px;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .rich-text :global(th),
  .rich-text :global(td) {
    padding: 8px;
    text-align: left;
    vertical-align: top;
  }

  @media screen and (max-width: 991px) {
    .rich-text {
      max-width: 90%;
    }
  }

  @media screen and (max-width: 767px) {
    .rich-text :global(h2) {
      font-size: 42px;
    }
  }

  @media screen and (max-width: 479px) {
    .rich-text {
      max-width: 100%;
      font-size: 18px;
    }

    .rich-text--padded {
      padding-right: 1rem;
    }

    .rich-text :global(h1) {
      font-size: 2.3em;
    }

    .rich-text :global(h2) {
      font-size: 1.9em;
    }

    .rich-text :global(h3) {
      font-size: 1.7rem;
    }

    .rich-text :global(h4) {
      font-size: 1.4rem;
    }

    .rich-text :global(p) {
      font-size: 0.9em;
      letter-spacing: 0;
    }
  }
</style>
