---
// INTERIM parent lockup: the existing Stride mark plus a typeset "STRIDE" wordmark.
// Replace with the official parent and division lockups once supplied (approval checklist C).
export interface Props {
  division?: string;
  tone?: 'light' | 'dark';
  class?: string;
}

const { division, tone = 'light', class: className } = Astro.props;
---

<span class:list={['logo', `logo--on-${tone}`, className]}>
  <svg class="logo__mark" viewBox="0 0 106 106" aria-hidden="true">
    <path d="M53 53H0L53 0v53Z" fill="currentColor"></path>
    <path d="M53 106H0l53-53v53Z" fill="currentColor"></path>
    <path d="M106 53H53l53-53v53Z" fill="currentColor"></path>
    <path d="M106 106H53l53-53v53Z" fill="currentColor"></path>
  </svg>
  <span class="logo__word">Stride</span>
  {division && <span class="logo__division">{division}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }

  .logo--on-light {
    color: var(--navy-900);
  }

  .logo--on-dark {
    color: var(--white);
  }

  .logo__mark {
    width: 26px;
    height: 26px;
    flex: none;
  }

  .logo__word {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .logo__division {
    padding-left: 10px;
    border-left: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
