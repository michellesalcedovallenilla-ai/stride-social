---
// "Campaign content" strip: portrait UGC videos drifting left in an endless loop.
// Mirrors the live Flowbase carousel: one pass of the original set takes 15s, the set is
// cloned until it overfills the viewport, and hovering pauses it. Videos only play while
// the strip is near the viewport.
export interface Props {
  videos: string[];
  heading?: string;
}

const { videos, heading = 'campaign content' } = Astro.props;
---

<section class="campaign-videos">
  <h2 class="campaign-videos__title">{heading}</h2>
  <div class="campaign-videos__carousel" data-video-carousel>
    <div class="campaign-videos__track" data-video-track>
      {videos.map((src) => (
        <div class="campaign-videos__item">
          <video class="campaign-videos__video" src={src} muted loop playsinline preload="metadata"></video>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .campaign-videos {
    position: relative;
    padding: 3rem 0;
    background-color: var(--color-smoke);
  }

  .campaign-videos__title {
    margin-bottom: 3rem;
    font-family: var(--font-sans);
    font-size: 4rem;
    font-weight: 400;
    line-height: 0.89;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .campaign-videos__carousel {
    width: 100%;
    overflow: hidden;
  }

  .campaign-videos__track {
    display: flex;
    align-items: center;
    width: max-content;
  }

  .campaign-videos__track.is-running {
    animation: campaign-videos-loop var(--loop-duration, 15s) linear infinite;
  }

  .campaign-videos__carousel:hover .campaign-videos__track {
    animation-play-state: paused;
  }

  .campaign-videos__item {
    position: relative;
    flex: none;
    width: 27rem;
    aspect-ratio: 2 / 3;
    margin-right: 12px;
    overflow: hidden;
  }

  .campaign-videos__video {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  @keyframes campaign-videos-loop {
    to {
      transform: translateX(calc(-1 * var(--loop-distance, 0px)));
    }
  }

  @media screen and (max-width: 479px) {
    .campaign-videos__title {
      font-size: 2.5rem;
    }

    .campaign-videos__item {
      width: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .campaign-videos__track.is-running {
      animation: none;
    }
  }
</style>

<script>
  const SET_DURATION = 15; // seconds for one pass of the original set (fb-carousel-speed=15000)

  function setup(carousel: HTMLElement) {
    const track = carousel.querySelector<HTMLElement>('[data-video-track]');
    if (!track) return;
    const originals = [...track.children] as HTMLElement[];
    if (!originals.length) return;
    let visible = false;

    const sync = () =>
      track.querySelectorAll('video').forEach((v) => {
        if (visible) v.play().catch(() => {});
        else v.pause();
      });

    const fill = () => {
      track.classList.remove('is-running');
      const setWidth = originals.reduce((w, el) => w + el.offsetWidth + parseFloat(getComputedStyle(el).marginRight), 0);
      if (!setWidth) return;
      // Enough copies that the visible window never runs past the end of the track.
      while (track.scrollWidth < carousel.clientWidth + setWidth) {
        for (const el of originals) {
          const copy = el.cloneNode(true) as HTMLElement;
          copy.setAttribute('aria-hidden', 'true');
          copy.querySelectorAll('video').forEach((v) => (v.muted = true));
          track.append(copy);
        }
      }
      track.style.setProperty('--loop-distance', `${setWidth}px`);
      track.style.setProperty('--loop-duration', `${SET_DURATION}s`);
      track.classList.add('is-running');
      sync();
    };

    fill();
    let raf = 0;
    let width = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === width) return; // ignore mobile toolbar height changes
      width = window.innerWidth;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(fill);
    });

    // Play only while the strip is on (or near) screen.
    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(carousel);
  }

  document.querySelectorAll<HTMLElement>('[data-video-carousel]').forEach(setup);
</script>
