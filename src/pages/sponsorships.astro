---
// Our Sponsorships (brief §7: a visual archive of creators, sports teams, events and community
// initiatives): the movable wall (experience/Wall), filtered by type, each entry growing into a big card.
// Only entries Stride has confirmed render. The collection is empty until Stride supplies entries (Q12):
// until then, a frosted door with a short honest note, out of search results.
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Wall from '@/components/experience/Wall.astro';
import DivisionDoor from '@/components/talent/DivisionDoor.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';

const s = (await getEntry('pages', 'sponsorships'))?.data.sections;
if (!s) throw new Error('Missing src/content/pages/sponsorships.yaml');
const entries = (await getCollection('sponsorships', (e) => e.data.approval.status === 'confirmed')).sort((a, b) => b.data.year - a.data.year);
const types = { creator: 'Creators', 'sports-team': 'Sports teams', event: 'Events', community: 'Community' } as const;
const used = (Object.keys(types) as (keyof typeof types)[]).filter((t) => entries.some((e) => e.data.type === t));
const crumbs = [{ label: 'About', href: '/about' }, { label: 'Our Sponsorships' }];
const items = entries.map((e) => ({
  key: e.id,
  name: e.data.title,
  meta: `${types[e.data.type]} · ${e.data.year}`,
  image: e.data.images[0],
  href: e.data.link ?? `#${e.id}`,
  filters: { type: e.data.type },
  card: {
    name: e.data.title,
    text: e.data.summary,
    href: e.data.link ?? `#${e.id}`,
    image: e.data.images[0],
    chips: [e.data.partner, types[e.data.type], String(e.data.year), ...(e.data.location ? [e.data.location] : [])],
    action: e.data.link ? { label: 'Find out more', href: e.data.link, external: true } : undefined,
  },
}));
---

<SiteLayout title="Our Sponsorships | Stride" description={s.hero.body} noindex={entries.length === 0} headerOverlay>
  {entries.length > 0 ? (
    <Wall
      items={items}
      groups={[{ key: 'type', label: 'Type', options: used.map((t) => ({ id: t, label: types[t], n: entries.filter((e) => e.data.type === t).length })) }]}
      copy={s.hero}
      noun="sponsorship|sponsorships"
      tone="group"
      look="deep"
      crumbs={crumbs}
      eyebrow={s.hero.eyebrow}
    />
  ) : (
    <DivisionDoor
      tone="group"
      look="deep"
      name={s.hero.headline ?? 'Our sponsorships.'}
      brand={s.hero.eyebrow}
      tagline={s.hero.body}
      text={[s.empty.body ?? '']}
      crumbs={crumbs}
      actions={[{ label: 'Stride Social', href: '/social' }, { label: 'Stride Talent', href: '/talent' }]}
    >
      {isPreview && <PlaceholderNotice variant="inline" label="Awaiting sponsorship entries (Q12)">— each needs a title, partner, type, year, a photo with alt text, a summary and Stride's confirmation</PlaceholderNotice>}
    </DivisionDoor>
  )}
</SiteLayout>
