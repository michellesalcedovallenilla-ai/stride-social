---
// Full-screen multi-step enquiry form (the live site's "Formly" pattern): a welcome card,
// then one question per screen. "Next" stays disabled until the step's required fields
// are valid, choice steps advance on their own after a pick, and Enter moves forward.
// Submission: POSTs to `action` when one is configured; otherwise opens the visitor's mail
// app addressed to `fallbackEmail` with the answers filled in (a static build has no backend).

type Field = {
  type?: 'text' | 'email' | 'tel' | 'textarea';
  name: string;
  /** Accessible name; the live form shows placeholders only. */
  label: string;
  placeholder: string;
  required?: boolean;
  maxlength?: number;
};

type Choice = { label: string; value: string };

export type FormStep = {
  title: string;
  text?: string;
  fields?: Field[];
  choices?: { name: string; label: string; icon: 'video' | 'briefcase'; options: Choice[] };
};

export interface Props {
  id: string;
  /** Form name sent with the submission. */
  name: string;
  welcome: { heading: string; button: string; link?: { label: string; href: string } };
  steps: FormStep[];
  nextLabel?: string;
  submitLabel?: string;
  waitLabel?: string;
  success: { image: string; imageAlt: string; title: string; text: string };
  error: string;
  action?: string | null;
  fallbackEmail: string;
  fallbackSubject?: string;
}

const {
  id,
  name,
  welcome,
  steps,
  nextLabel = 'Next Step',
  submitLabel = 'Submit',
  waitLabel = 'Please wait...',
  success,
  error,
  action = null,
  fallbackEmail,
  fallbackSubject = 'Web enquiry',
} = Astro.props;

const lastIndex = steps.length - 1;
---

<div class="ms-page">
  <div class="ms-section">
    <div class="ms-container">
      <div class="ms-block" data-lenis-prevent>
        <form
          class="ms-form"
          id={id}
          name={name}
          method="post"
          action={action ?? undefined}
          novalidate
          data-ms-form
          data-fallback-email={fallbackEmail}
          data-fallback-subject={fallbackSubject}
        >
          <div class="ms-step ms-step--welcome" data-ms-step>
            <div class="ms-welcome">
              <div class="ms-welcome__top">
                <h1 class="ms-welcome__heading">{welcome.heading}</h1>
                <div class="ms-welcome__button">
                  <button class="ms-button" type="button" data-ms-next>{welcome.button}</button>
                </div>
              </div>
              {welcome.link && (
                <div class="ms-welcome__links">
                  <a class="ms-welcome__link" href={welcome.link.href}>{welcome.link.label}</a>
                </div>
              )}
            </div>
          </div>

          {steps.map((step, i) => (
            <fieldset class="ms-step" data-ms-step aria-labelledby={`${id}-step-${i}`} hidden>
              <div class="ms-step__wrap">
                <div class="ms-step__col">
                  <div class="ms-step__head">
                    <h2 class="ms-step__title" id={`${id}-step-${i}`}>{step.title}</h2>
                    {step.text && <p class="ms-step__text">{step.text}</p>}
                  </div>
                  <div class="ms-step__divider"></div>
                  <div class="ms-step__inputs">
                    {step.fields?.map((f) => (
                      <div class="ms-step__item">
                        {f.type === 'textarea' ? (
                          <textarea class="ms-field ms-field--text" name={f.name} id={`${id}-${f.name}`} placeholder={f.placeholder} aria-label={f.label} maxlength={f.maxlength ?? 5000} required={f.required}></textarea>
                        ) : (
                          <input class="ms-field" type={f.type ?? 'text'} name={f.name} id={`${id}-${f.name}`} placeholder={f.placeholder} aria-label={f.label} maxlength={f.maxlength ?? 256} required={f.required} autocomplete={f.type === 'email' ? 'email' : f.type === 'tel' ? 'tel' : undefined} />
                        )}
                      </div>
                    ))}
                    {step.choices && (
                      <div class="ms-step__item">
                        <div class="ms-choices" role="radiogroup" aria-label={step.choices.label} data-ms-choices>
                          {step.choices.options.map((o) => (
                            <label class="ms-choice">
                              <input class="ms-choice__input" type="radio" name={step.choices!.name} value={o.value} />
                              <span class="ms-choice__bg" aria-hidden="true"></span>
                              <span class="ms-choice__icon" aria-hidden="true">
                                {step.choices!.icon === 'video' ? (
                                  <svg width="28" height="28" viewBox="0 0 25 24" fill="none"><path d="M6.5 16H14.5V15.45C14.5 14.7167 14.1333 14.125 13.4 13.675C12.6667 13.225 11.7 13 10.5 13C9.3 13 8.33333 13.225 7.6 13.675C6.86667 14.125 6.5 14.7167 6.5 15.45V16ZM10.5 12C11.05 12 11.5208 11.8042 11.9125 11.4125C12.3042 11.0208 12.5 10.55 12.5 10C12.5 9.45 12.3042 8.97917 11.9125 8.5875C11.5208 8.19583 11.05 8 10.5 8C9.95 8 9.47917 8.19583 9.0875 8.5875C8.69583 8.97917 8.5 9.45 8.5 10C8.5 10.55 8.69583 11.0208 9.0875 11.4125C9.47917 11.8042 9.95 12 10.5 12ZM4.5 20C3.95 20 3.47917 19.8042 3.0875 19.4125C2.69583 19.0208 2.5 18.55 2.5 18V6C2.5 5.45 2.69583 4.97917 3.0875 4.5875C3.47917 4.19583 3.95 4 4.5 4H16.5C17.05 4 17.5208 4.19583 17.9125 4.5875C18.3042 4.97917 18.5 5.45 18.5 6V10.5L22.5 6.5V17.5L18.5 13.5V18C18.5 18.55 18.3042 19.0208 17.9125 19.4125C17.5208 19.8042 17.05 20 16.5 20H4.5ZM4.5 18H16.5V6H4.5V18Z" fill="#1C1B1F" /></svg>
                                ) : (
                                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 15.5C12.55 15.5 13.0208 15.3042 13.4125 14.9125C13.8042 14.5208 14 14.05 14 13.5C14 12.95 13.8042 12.4792 13.4125 12.0875C13.0208 11.6958 12.55 11.5 12 11.5C11.45 11.5 10.9792 11.6958 10.5875 12.0875C10.1958 12.4792 10 12.95 10 13.5C10 14.05 10.1958 14.5208 10.5875 14.9125C10.9792 15.3042 11.45 15.5 12 15.5ZM4 21C3.45 21 2.97917 20.8042 2.5875 20.4125C2.19583 20.0208 2 19.55 2 19V8C2 7.45 2.19583 6.97917 2.5875 6.5875C2.97917 6.19583 3.45 6 4 6H8V4C8 3.45 8.19583 2.97917 8.5875 2.5875C8.97917 2.19583 9.45 2 10 2H14C14.55 2 15.0208 2.19583 15.4125 2.5875C15.8042 2.97917 16 3.45 16 4V6H20C20.55 6 21.0208 6.19583 21.4125 6.5875C21.8042 6.97917 22 7.45 22 8V19C22 19.55 21.8042 20.0208 21.4125 20.4125C21.0208 20.8042 20.55 21 20 21H4ZM4 19H20V8H4V19ZM10 6H14V4H10V6Z" fill="#1C1B1F" /></svg>
                                )}
                              </span>
                              <span class="ms-choice__label">{o.label}</span>
                            </label>
                          ))}
                        </div>
                      </div>
                    )}
                    {!step.choices && (
                      <div class="ms-step__buttons">
                        {i === lastIndex ? (
                          <button class="ms-button" type="submit" data-ms-submit data-wait={waitLabel}>{submitLabel}</button>
                        ) : (
                          <button class="ms-button" type="button" data-ms-next>{nextLabel}</button>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </fieldset>
          ))}
        </form>

        <div class="ms-done" hidden data-ms-done role="status">
          <div class="ms-done__box">
            <div class="ms-done__image"><img src={success.image} alt={success.imageAlt} width="50" height="50" /></div>
            <div class="ms-done__content">
              <p class="ms-step__title">{success.title}</p>
              <p class="ms-step__text">{success.text}</p>
            </div>
          </div>
        </div>
        <div class="ms-fail" hidden data-ms-fail role="alert">
          <div class="ms-fail__box">{error}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const RADIO_DELAY = 250;

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-ms-form]')) {
    const steps = [...form.querySelectorAll<HTMLElement>('[data-ms-step]')];
    const block = form.parentElement!;
    const done = block.querySelector<HTMLElement>('[data-ms-done]')!;
    const fail = block.querySelector<HTMLElement>('[data-ms-fail]')!;
    let current = 0;

    const fieldsOf = (step: HTMLElement) => [...step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
    const isValid = (step: HTMLElement) => fieldsOf(step).every((f) => f.type === 'radio' || f.checkValidity());
    const buttonOf = (step: HTMLElement) => step.querySelector<HTMLButtonElement>('[data-ms-next], [data-ms-submit]');

    const refresh = () => {
      const step = steps[current];
      const button = buttonOf(step);
      if (!button || current === 0) return;
      const ok = isValid(step);
      button.classList.toggle('is-disabled', !ok);
      button.setAttribute('aria-disabled', String(!ok));
    };

    const show = (index: number) => {
      current = index;
      steps.forEach((s, i) => (s.hidden = i !== index));
      refresh();
      const first = steps[index].querySelector<HTMLElement>('input, textarea');
      first?.focus({ preventScroll: true });
    };

    const next = () => {
      if (current > 0 && !isValid(steps[current])) return;
      if (current < steps.length - 1) show(current + 1);
    };

    form.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-ms-next]');
      if (!target) return;
      e.preventDefault();
      if (target.getAttribute('aria-disabled') === 'true') return;
      next();
    });

    form.addEventListener('input', refresh);

    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== 'radio') return;
      setTimeout(next, RADIO_DELAY);
    });

    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' || (e.target as HTMLElement).tagName === 'TEXTAREA') return;
      if (current === steps.length - 1) return; // let Enter submit on the last step
      e.preventDefault();
      next();
    });

    const fallback = (data: FormData) => {
      const lines: string[] = [];
      data.forEach((value, key) => {
        if (String(value).trim()) lines.push(`${key.replace(/-/g, ' ')}: ${value}`);
      });
      const to = form.dataset.fallbackEmail;
      const subject = encodeURIComponent(form.dataset.fallbackSubject ?? '');
      window.location.href = `mailto:${to}?subject=${subject}&body=${encodeURIComponent(lines.join('\n'))}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const step = steps[current];
      if (!isValid(step)) return;
      const button = form.querySelector<HTMLButtonElement>('[data-ms-submit]')!;
      const data = new FormData(form);
      const action = form.getAttribute('action');
      if (!action) {
        fallback(data);
        return;
      }
      const label = button.textContent;
      button.textContent = button.dataset.wait ?? label;
      button.disabled = true;
      fail.hidden = true;
      try {
        const res = await fetch(action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        done.hidden = false;
      } catch {
        fail.hidden = false;
      } finally {
        button.textContent = label;
        button.disabled = false;
      }
    });

    show(0);
  }
</script>

<style>
  .ms-page {
    position: relative;
    z-index: 5;
    min-height: 90dvh;
    background-color: var(--color-smoke-2);
  }

  .ms-section {
    position: relative;
    display: flex;
    height: 100vh;
    overflow: hidden;
    letter-spacing: 0.2px;
  }

  .ms-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: 3.25rem;
    width: 90%;
    max-width: 80rem;
    height: 100%;
    margin-inline: auto;
  }

  .ms-block {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0 0 15px;
    overflow: auto;
  }

  .ms-form {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 60px;
    height: 100%;
  }

  .ms-form[hidden],
  .ms-step[hidden],
  .ms-done[hidden],
  .ms-fail[hidden] {
    display: none;
  }

  .ms-step {
    position: relative;
    flex: none;
    width: 100%;
    height: 100%;
    min-width: 0;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
  }

  /* ---- Welcome card ---- */
  .ms-welcome {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    margin-inline: auto;
  }

  .ms-welcome__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    width: 100%;
    max-width: 1200px;
    text-align: center;
  }

  .ms-welcome__heading {
    font-family: var(--font-sans);
    font-size: 6.5rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .ms-welcome__button {
    margin-top: 16px;
  }

  .ms-welcome__links {
    position: relative;
    bottom: -27%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .ms-welcome__link {
    font-weight: 400;
    color: var(--color-navy);
  }

  .ms-welcome__link:hover {
    text-decoration: underline;
  }

  /* ---- Buttons ---- */
  .ms-button {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.125rem 2.5rem;
    border-radius: 0.25rem;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: inherit;
    text-transform: uppercase;
    color: var(--color-navy);
    background-color: var(--accent);
  }

  .ms-button.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  /* ---- Question steps ---- */
  .ms-step__wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    width: 100%;
    height: 100%;
    margin: auto;
    font-family: var(--font-sans);
  }

  .ms-step__col {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2rem;
    width: 100%;
    max-width: 566px;
    padding-top: 50px;
  }

  .ms-step__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .ms-step__title {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 5rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .ms-step__text {
    margin-top: 16px;
    font-family: var(--font-sans);
    text-align: center;
    opacity: 0.7;
  }

  .ms-step__divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-navy-mute);
    opacity: 0.23;
  }

  .ms-step__inputs {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2rem;
  }

  .ms-step__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ms-step__buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .ms-field {
    display: block;
    width: 100%;
    height: 60px;
    margin: 0 0 10px;
    padding: 13px 12px;
    border: 0;
    border-radius: 7px;
    font-family: var(--font-alt);
    font-size: 14px;
    line-height: 1.42857;
    letter-spacing: inherit;
    color: var(--color-navy);
    background-color: var(--color-line);
    transition: all 0.2s;
  }

  .ms-field:focus-visible {
    outline: 0;
    box-shadow: inset 0 0 0 2px var(--color-navy-20);
  }

  .ms-field::placeholder {
    font-family: var(--font-sans);
    color: var(--color-navy-mute);
  }

  .ms-field--text {
    height: 10rem;
  }

  /* ---- Choice cards ---- */
  .ms-choices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 7px;
  }

  .ms-choice {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    width: 32%;
    min-height: 12rem;
    padding: 20px 15px;
    overflow: hidden;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 20px;
    text-transform: uppercase;
  }

  /* Webflow's clearfix pseudo-elements sit in the flex column and add two gaps. */
  .ms-choice::before,
  .ms-choice::after {
    content: '';
  }

  .ms-choice__input {
    position: absolute;
    z-index: -1;
    opacity: 0;
  }

  .ms-choice__bg {
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    background-color: var(--color-line);
  }

  .ms-choice__input:checked + .ms-choice__bg {
    border-color: #fff;
    border-radius: 20px;
  }

  .ms-choice__input:focus-visible + .ms-choice__bg {
    box-shadow: 0 0 3px 1px #3898ec;
  }

  .ms-choice__icon {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ms-choice__icon svg {
    display: block;
  }

  .ms-choice__label {
    position: relative;
    text-align: center;
    color: var(--color-navy);
  }

  /* ---- Success / error ---- */
  .ms-done {
    padding: 20px;
    text-align: center;
  }

  .ms-done__box {
    max-width: 500px;
    margin-inline: auto;
    padding: 35px 0;
    border-radius: 20px;
    background-color: #ffe5e517;
  }

  .ms-done__image {
    width: 50px;
    margin: 0 auto 1rem;
  }

  .ms-done__content {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .ms-done .ms-step__text {
    margin-top: 0;
  }

  .ms-fail {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 10px;
  }

  .ms-fail__box {
    width: 100%;
    max-width: 566px;
    padding: 12px;
    border-radius: 7px;
    background-color: #ff4d4d;
  }

  @media screen and (max-width: 991px) {
    .ms-step__wrap {
      flex-direction: column;
      justify-content: flex-start;
      gap: 5rem;
    }

    .ms-step__col {
      margin-inline: auto;
      padding-top: 0;
    }
  }

  @media screen and (max-width: 767px) {
    .ms-step__title {
      font-size: 1.8rem;
    }
  }

  @media screen and (max-width: 479px) {
    .ms-welcome__heading {
      font-size: 2.8rem;
    }

    .ms-welcome__link {
      font-family: var(--font-sans);
    }

    .ms-button {
      padding-inline: 2.1rem;
    }

    .ms-step__wrap {
      justify-content: center;
      align-items: center;
    }

    .ms-step__title {
      font-size: 2.7rem;
    }

    .ms-field {
      font-size: 16px;
    }

    .ms-choice {
      gap: 1rem;
      width: 100%;
      min-height: 7rem;
      padding-block: 10px;
    }
  }
</style>
