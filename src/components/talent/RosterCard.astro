---
// Creator card for the roster grid and previews: 4:5 portrait, name, main category, country and
// platforms. No follower counts (brief: "Do not invent talent or follower counts"; old figures
// are unverified). Carries data-name / data-categories for the roster filter script.
import type { Creator } from '@/lib/roster';
import { platformNames, platformsOf, platformShort } from '@/lib/roster';
import { routes } from '@/lib/routes';

export interface Props {
  creator: Creator;
  categoryLabels: Record<string, string>;
  nameLevel?: 'h2' | 'h3';
  eager?: boolean;
  hidden?: boolean;
}

const { creator, categoryLabels, nameLevel = 'h3', eager = false, hidden = false } = Astro.props;
const Name = nameLevel;
const d = creator.data;
const category = d.mainCategory ? categoryLabels[d.mainCategory.id] : null;
const categories = [d.mainCategory?.id, ...d.categories.map((c) => c.id)].filter(Boolean).join(' ');
const platforms = platformsOf(creator);
---

<li class="rcard" data-name={d.name.toLowerCase()} data-categories={categories} hidden={hidden}>
  <a class="rcard__link" href={routes.creator(creator.id)}>
    <span class="rcard__media">
      {d.portrait ? (
        <img src={d.portrait.src} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
      ) : (
        <span class="rcard__initial" aria-hidden="true">{d.name.replace(/[^a-z0-9]/gi, '').charAt(0)}</span>
      )}
    </span>
    <span class="rcard__info">
      <Name class="rcard__name">{d.name}</Name>
      <span class="rcard__meta">
        {category && <span>{category}</span>}
        {d.country && <span>{d.country}</span>}
      </span>
      {platforms.length > 0 && (
        <span class="rcard__platforms">
          <span class="visually-hidden">On {platforms.map((p) => platformNames[p.key]).join(', ')}</span>
          {platforms.map((p) => <span aria-hidden="true">{platformShort[p.key]}</span>)}
        </span>
      )}
    </span>
  </a>
</li>

<style>
  .rcard[hidden] {
    display: none;
  }

  .rcard__link {
    display: grid;
    gap: var(--space-3);
  }

  .rcard__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--peach);
  }

  .rcard__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .rcard__link:hover img {
    transform: scale(1.04);
  }

  .rcard__initial {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 850;
    text-transform: uppercase;
    color: var(--navy-900);
  }

  .rcard__info {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  /* Handles can be long and unbroken ("athomewithtash_xo"): wrap them rather than cut them. */
  .rcard__name {
    font-size: var(--type-body);
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .rcard__meta,
  .rcard__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .rcard__meta {
    color: var(--slate);
  }

  .rcard__meta span + span::before {
    content: '·';
    margin-right: var(--space-2);
  }

  .rcard__platforms {
    color: var(--accent-ink);
  }
</style>
