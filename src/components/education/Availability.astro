---
// Availability label for an education item: "Available now" or "Coming soon" once Stride has
// confirmed it; in preview, unconfirmed items say so instead (they never reach production, see
// src/lib/education.ts).
import Badge from '../core/Badge.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';

export interface Props {
  status: 'available' | 'planned' | 'unconfirmed';
}

const { status } = Astro.props;
---

{status === 'unconfirmed' ? <PlaceholderNotice variant="inline" label="Availability to confirm">(Q11)</PlaceholderNotice> : <Badge status={status} />}
