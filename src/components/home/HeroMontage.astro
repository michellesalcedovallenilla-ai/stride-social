---
// Homepage section A1 (docs/phase-2/05-wireframes.md): near full-screen montage, headline
// bottom-left, description and division routes bottom-right.
// With `intro`, desktop opens on that video first, every time: it plays over the hero, then fades away to
// the montage as the headline, copy and routes reveal (src/scripts/system/hero-intro.ts). The
// montage waits until then, so it starts from the top. Phones go straight to the montage.
import Media from '../core/Media.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';

type VideoSource = { mp4: string; webm?: string; poster: string };

export interface Props {
  headline: string[];
  description: string;
  routes: { label: string; href: string; division: 'social' | 'talent' | 'education' }[];
  video: VideoSource & { label: string; mobile?: VideoSource };
  intro?: VideoSource;
  interim?: boolean;
}

const { headline, description, routes, video, intro, interim = false } = Astro.props;
---

<section class:list={['hero', { 'hero--intro': intro }]} aria-labelledby="hero-title" data-hero-intro={intro ? '' : undefined}>
  <Media video={video} priority={!intro} controlsPosition="bottom-right" class="hero__media" />
  {interim && <PlaceholderNotice label="Interim footage" class="hero__interim">— awaiting approved montage</PlaceholderNotice>}
  <div class="hero__scrim" aria-hidden="true"></div>

  {intro && (
    <>
      <div class="hero__intro">
        <video class="hero__intro-video" data-intro-video data-mp4={intro.mp4} data-webm={intro.webm} data-poster={intro.poster} muted playsinline preload="none" aria-hidden="true"></video>
      </div>
      <script is:inline>
        // Decide before the headline paints whether the desktop intro plays: desktop, with motion
        // allowed. If the intro script never starts, show the hero.
        (() => {
          const hero = document.querySelector('[data-hero-intro]');
          if (!matchMedia('(min-width: 768px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const video = hero.querySelector('[data-intro-video]');
          video.poster = video.dataset.poster;
          hero.classList.add('is-intro-playing');
          setTimeout(() => {
            if (hero.dataset.introReady) return;
            hero.classList.remove('is-intro-playing');
            hero.dispatchEvent(new CustomEvent('hero:intro', { bubbles: true }));
          }, 3000);
        })();
      </script>
      <button class="hero__intro-toggle" type="button" data-intro-toggle>Play intro</button>
    </>
  )}

  <div class="hero__content">
    <h1 class="hero__title" id="hero-title" data-reveal-lines="load">
      {headline.map((line, i) => (
        <span class="reveal-line" style={`--line: ${i}`}><span class="reveal-line__inner">{line}</span></span>
      ))}
    </h1>
    <div class="hero__aside" data-reveal="load" style="--reveal-delay: 0.45s">
      <p class="hero__description">{description}</p>
      <ul class="hero__routes" role="list">
        {routes.map((r) => (
          <li>
            <a class={`hero__route hero__route--${r.division}`} href={r.href}>
              <span class="hero__route-swatch" aria-hidden="true"></span>
              <span class="hero__route-label">{r.label}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 640px;
    height: 100svh;
    max-height: 1040px;
    overflow: hidden;
    background: var(--navy-900);
    color: var(--white);
  }

  .hero :global(.hero__interim) {
    top: calc(var(--header-h) + var(--space-3));
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgb(6 20 43 / 0.82) 0%, rgb(6 20 43 / 0.35) 45%, rgb(6 20 43 / 0.15) 100%),
      linear-gradient(to right, rgb(6 20 43 / 0.35), transparent 60%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
    gap: var(--gutter);
    width: 100%;
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: 0 var(--margin) calc(var(--space-8) + 20px);
  }

  .hero__title {
    grid-column: 1 / 9;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 8.6vw, 9.5rem);
    font-weight: 850;
    font-stretch: 118%;
    line-height: 0.86;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .hero__aside {
    grid-column: 9 / -1;
    display: grid;
    gap: var(--space-6);
    padding-bottom: 0.4rem;
  }

  .hero__description {
    max-width: 36ch;
    font-size: var(--type-lead);
    line-height: 1.4;
    color: rgb(255 255 255 / 0.9);
  }

  .hero__routes {
    display: grid;
    border-top: 1px solid rgb(255 255 255 / 0.25);
  }

  .hero__route {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
    font-weight: 500;
  }

  .hero__route-swatch {
    width: 10px;
    height: 10px;
    flex: none;
  }

  .hero__route--social .hero__route-swatch {
    background: var(--ice);
  }

  .hero__route--talent .hero__route-swatch {
    background: var(--peach);
  }

  .hero__route--education .hero__route-swatch {
    background: var(--sun);
  }

  .hero__route-label {
    flex: 1;
  }

  .hero__route svg {
    width: 16px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .hero__route:hover svg {
    transform: translateX(4px);
  }

  /* Desktop intro: covers the hero while it plays, then fades out as the content reveals.
     Hidden states sit under .js so content can never stay invisible without scripts. */
  .hero__intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--navy-900);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.9s var(--ease-out),
      visibility 0s linear 0.9s;
  }

  :global(.js) .hero.is-intro-playing .hero__intro {
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  .hero__intro-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.js) .hero.is-intro-playing .hero__content {
    opacity: 0;
  }

  /* The interim label and the montage's pause button belong to the montage underneath. */
  :global(.js) .hero.is-intro-playing :global(.hero__interim),
  :global(.js) .hero.is-intro-playing :global(.media__toggle) {
    visibility: hidden;
  }

  /* Hold the load reveals until the intro ends; they play from the start when it does. */
  :global(.js) .hero.is-intro-playing [data-reveal='load'],
  :global(.js) .hero.is-intro-playing .reveal-line__inner {
    animation: none;
  }

  /* Sits beside the montage's pause button; takes the corner while the intro plays. */
  .hero__intro-toggle {
    position: absolute;
    right: calc(var(--space-4) + 44px + var(--space-2));
    bottom: var(--space-4);
    z-index: 4;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 999px;
    background: rgb(6 20 43 / 0.35);
    color: var(--white);
    font-size: 0.8125rem;
    font-weight: 500;
    backdrop-filter: blur(6px);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .hero__intro-toggle:hover {
    background: rgb(6 20 43 / 0.6);
  }

  :global(.js) .hero.is-intro-playing .hero__intro-toggle {
    right: var(--space-4);
  }

  @media (max-width: 1023px) {
    .hero__content {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__title,
    .hero__aside {
      grid-column: 1 / -1;
    }

    .hero__title {
      font-size: clamp(3rem, 11.5vw, 7rem);
    }

    .hero__aside {
      max-width: 520px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 600px;
      max-height: none;
    }

    .hero__intro,
    .hero__intro-toggle {
      display: none;
    }

    .hero__content {
      gap: var(--space-6);
      padding-bottom: calc(var(--space-8) + 12px);
    }

    .hero__title {
      font-stretch: 112%;
      font-size: min(12vw, 5rem);
    }
  }

  /* "CREATORS." must fit on one line down to 320px wide. */
  @media (max-width: 479px) {
    .hero__title {
      font-stretch: 100%;
      font-size: 10.6vw;
    }

    .hero__aside {
      gap: var(--space-5);
    }
  }
</style>

<script>
  import { initHeroIntro } from '@/scripts/system/hero-intro';
  initHeroIntro();
</script>
