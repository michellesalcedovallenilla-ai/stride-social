---
// Group homepage: the ten sections from the client brief (PDF §3; docs/phase-2/05-wireframes.md §A).
// Copy lives in src/content/pages/home.yaml; collections supply work, team, insights, divisions,
// sponsorships and markets. Media marked interim is labelled on screen until approved assets arrive.
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import HeroMontage from '@/components/home/HeroMontage.astro';
import ThreeSides from '@/components/home/ThreeSides.astro';
import GroupIntro from '@/components/home/GroupIntro.astro';
import DivisionIndex from '@/components/home/DivisionIndex.astro';
import WorkMosaic from '@/components/home/WorkMosaic.astro';
import PeopleMosaic from '@/components/home/PeopleMosaic.astro';
import BeyondBusiness from '@/components/home/BeyondBusiness.astro';
import InsightsTrio from '@/components/home/InsightsTrio.astro';
import MarketsDisplay from '@/components/home/MarketsDisplay.astro';
import FinalRoutes from '@/components/home/FinalRoutes.astro';
import { site, socials } from '@/config/site';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.yaml');
const s = page.data.sections;

// Interim panel media for Three Sides (labelled on screen). Keyed by division.
const sideMedia = {
  social: {
    image: { src: '/assets/site/f2fc912c-video1-poster-00001.jpg', alt: 'A creator filming a product campaign in her kitchen', position: '50% 30%' },
    video: {
      label: 'A creator filming a product campaign in her kitchen',
      mp4: '/assets/video/f2fc912c-video1-transcode.mp4',
      webm: '/assets/video/f2fc912c-video1-transcode.webm',
      poster: '/assets/site/f2fc912c-video1-poster-00001.jpg',
    },
  },
  talent: { image: { src: '/assets/cms/7a2c07a0-aq.jpg', alt: 'Black and white portrait of a Stride Talent creator', position: '50% 25%' } },
  education: { image: { src: '/assets/site/b9208d92-stride-social.webp', alt: 'Creators and the Stride team at an industry event', position: '50% 50%' } },
} as const;
type DivisionKey = keyof typeof sideMedia;

// Organization + WebSite structured data: real company facts only (no address until Q3).
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Stride',
    legalName: site.legalName,
    url: site.url,
    logo: new URL(site.favicon, site.url).href,
    sameAs: socials.map((s) => s.href),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Stride', url: site.url },
];
---

<SiteLayout
  title="Stride Social | Influencer Advertising & Talent Agency"
  description="Stride is a global media group built around creators: Stride Social for brands, Stride Talent for creators and Stride Education for the next generation."
  headerOverlay
  jsonLd={jsonLd}
>
  <HeroMontage
    headline={s.hero.lines ?? []}
    description={s.hero.body ?? ''}
    routes={(s.sides.items ?? []).map((item) => {
      // Each tab brings in the same footage as its "Three sides" panel below.
      const media = sideMedia[item.key as DivisionKey];
      return {
        label: `Stride ${item.label}`,
        href: item.href ?? '/',
        division: item.key as DivisionKey,
        audience: item.audience ?? '',
        copy: item.copy ?? '',
        image: media.image,
        video: 'video' in media ? media.video : undefined,
      };
    })}
    video={{
      label: 'Montage of Stride creator campaigns',
      mp4: '/assets/video/1236e597-1029-transcode.mp4',
      webm: '/assets/video/1236e597-1029-transcode.webm',
      poster: '/assets/site/1236e597-1029-poster-00001.jpg',
      mobile: {
        mp4: '/assets/video/926f3517-1029-1-transcode.mp4',
        webm: '/assets/video/926f3517-1029-1-transcode.webm',
        poster: '/assets/site/926f3517-1029-1-poster-00001.jpg',
      },
    }}
    intro={{
      // The divisions take turns after STRIDE; the last name holds as the opening ends.
      words: [
        { label: 'Social', division: 'social' },
        { label: 'Talent', division: 'talent' },
        { label: 'Education', division: 'education' },
        { label: 'Group' },
      ],
    }}
  />

  <ThreeSides
    eyebrow={s.sides.eyebrow ?? ''}
    headline={s.sides.headline ?? ''}
    panels={(s.sides.items ?? []).map((item) => ({
      division: item.key as DivisionKey,
      audience: item.audience ?? '',
      name: item.label,
      copy: item.copy ?? '',
      cta: item.cta ?? '',
      href: item.href ?? '/',
      ...sideMedia[item.key as DivisionKey],
      interim: true,
    }))}
  />

  <GroupIntro
    copy={s.group}
    image={{ src: '/assets/site/d0919a45-stride-social.webp', alt: 'Stride team members at an industry technology event', position: '45% 50%' }}
    interim
  />
  <DivisionIndex copy={s.divisions} />
  <WorkMosaic copy={s.work} />
  <PeopleMosaic copy={s.people} candid={{ src: '/assets/site/81d2e389-screenshot-2025-10-13-at-10.59.51.jpg', alt: 'A Stride team member at an industry event with a Stride Social floor sign', interim: true }} />
  <BeyondBusiness copy={s.beyond} />
  <InsightsTrio copy={s.insights} />
  <MarketsDisplay copy={s.presence} />
  <FinalRoutes copy={s.final} />
</SiteLayout>
