---
// Stride Social: the creator content world. A desk of browser-style windows (a live campaign, a
// collab brief, reels, the roster) that drift at different speeds as the page scrolls, lean a
// little with the pointer and straighten when hovered. Everything shown is real: case study
// footage and names, service names, roster portraits through the consent rule; the reels are the
// previous site's creator clips, labelled interim like the hero's. Windows without content to show
// are left out. Drift is CSS only (scroll-driven), off under reduced motion; phones stack the windows.
import { getEntry, getEntries } from 'astro:content';
import Media from '../core/Media.astro';
import Eyebrow from '../core/Eyebrow.astro';
import DraftTag from '../core/DraftTag.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { getRoster } from '@/lib/roster';
import { workPreviews } from '@/lib/previews';
import { routes } from '@/lib/routes';

export interface Props {
  copy: { status: 'approved' | 'draft'; eyebrow?: string; headline?: string; body?: string };
  /** Case study ids: the first plays in the campaign window, the second fills the brief. */
  campaigns: [string, string];
  /** Vertical creator clips for the reels window. */
  reels: { mp4: string; webm?: string; poster: string; label: string }[];
}

const { copy, campaigns, reels } = Astro.props;

const caseStudy = async (id: string) => {
  const w = await getEntry('work', id);
  if (!w) return null;
  const brand = await getEntry(w.data.client);
  const services = await getEntries(w.data.services);
  return {
    href: routes.caseStudy(w.id),
    title: w.data.title,
    brand: brand?.data.name ?? w.data.title,
    services: services.map((s) => s.data.name),
    still: w.data.homeTile?.front ?? w.data.hero ?? w.data.card,
    preview: workPreviews[w.id],
  };
};
const live = await caseStudy(campaigns[0]);
const brief = await caseStudy(campaigns[1]);
const roster = (await getRoster()).filter((c) => c.data.portrait).slice(0, 6);
const interimRoster = roster.some((c) => c.data.consent.status !== 'confirmed');
---

<section class="world" aria-labelledby="world-title">
  <div class="world__inner container-wide">
    <header class="world__head">
      <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
      <h2 class="world__title" id="world-title" data-reveal="wipe">{copy.headline}</h2>
      {copy.body && <p class="world__body">{copy.body}</p>}
      <DraftTag status={copy.status} />
    </header>

    <div class="world__desk">
      {live && (
        <article class="win win--live" data-parallax="8" aria-label={`Campaign: ${live.brand}`}>
          <p class="win__bar" aria-hidden="true"><span class="win__dots"><i></i><i></i><i></i></span><span class="win__tab">Campaign · {live.brand}</span></p>
          <div class="win__view win__view--wide">
            {live.preview ? (
              <Media video={{ mp4: live.preview, poster: live.still.src, label: `${live.brand} campaign footage` }} controlsPosition="bottom-right" />
            ) : (
              <Media image={{ src: live.still.src, alt: live.still.alt }} />
            )}
          </div>
          <p class="win__foot"><a href={live.href}>{live.title}</a><span>{live.services[0]}</span></p>
        </article>
      )}

      {reels.length > 0 && (
        <article class="win win--reels" data-parallax="14" aria-label="Creator reels">
          <p class="win__bar" aria-hidden="true"><span class="win__dots"><i></i><i></i><i></i></span><span class="win__tab">Reels</span></p>
          <div class="win__reels">
            {reels.map((r) => (
              <div class="win__reel">
                <Media video={r} ratio="9 / 16" controlsPosition="bottom-right" />
              </div>
            ))}
          </div>
          <PlaceholderNotice label="Interim footage" class="win__interim">— previous site's creator clips</PlaceholderNotice>
        </article>
      )}

      {brief && (
        <article class="win win--brief" data-parallax="-10" aria-label={`Collab brief: ${brief.brand}`}>
          <p class="win__bar" aria-hidden="true"><span class="win__dots"><i></i><i></i><i></i></span><span class="win__tab">Brief</span></p>
          <dl class="win__brief">
            <div><dt>Brand</dt><dd>{brief.brand}</dd></div>
            <div><dt>Campaign</dt><dd><a href={brief.href}>{brief.title}</a></dd></div>
            {brief.services.length > 0 && (
              <div><dt>Formats</dt><dd class="win__tags">{brief.services.map((s) => <span>{s}</span>)}</dd></div>
            )}
          </dl>
        </article>
      )}

      {roster.length >= 6 && (
        <article class="win win--roster" data-parallax="-6" aria-label="Roster">
          <p class="win__bar" aria-hidden="true"><span class="win__dots"><i></i><i></i><i></i></span><span class="win__tab">Roster</span></p>
          <ul class="win__faces" role="list">
            {roster.map((c) => (
              <li>
                <a href={routes.creator(c.id)} aria-label={`${c.data.name}, creator profile`}>
                  <img src={c.data.portrait!.src} alt={c.data.portrait!.alt} sizes="96px" loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
          {interimRoster && <PlaceholderNotice label="Interim portraits" class="win__interim">— consent to be re-confirmed</PlaceholderNotice>}
        </article>
      )}
    </div>
  </div>
</section>

<style>
  .world {
    padding-block: clamp(72px, 9vw, 160px);
    background: var(--navy-900);
    color: var(--white);
  }

  .world__head {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    margin-bottom: var(--space-8);
  }

  .world__title {
    font-family: var(--font-display);
    font-size: var(--type-h1);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .world__body {
    max-width: 36ch;
    color: rgb(255 255 255 / 0.8);
  }

  /* ---------- The desk: windows placed on a loose 12-column grid ---------- */
  .world__desk {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(0, auto);
    gap: var(--gutter);
    align-items: start;
  }

  .win {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: #0b1a33;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12),
      0 30px 60px rgb(0 0 0 / 0.45);
    rotate: var(--turn, 0deg);
    transition:
      rotate 500ms var(--ease-out),
      box-shadow 500ms var(--ease-out);
  }

  .win:hover,
  .win:focus-within {
    rotate: 0deg;
    box-shadow:
      0 0 0 1px rgb(195 242 251 / 0.5),
      0 40px 80px rgb(0 0 0 / 0.5);
  }

  .win--live {
    grid-column: 1 / 8;
    grid-row: 1;
    --turn: -1.5deg;
  }

  .win--reels {
    grid-column: 8 / 13;
    grid-row: 1 / 3;
    margin-top: var(--space-9);
    --turn: 2deg;
  }

  .win--brief {
    grid-column: 2 / 6;
    grid-row: 2;
    margin-top: calc(var(--space-7) * -1);
    --turn: 1deg;
  }

  .win--roster {
    grid-column: 5 / 8;
    grid-row: 2;
    margin-top: var(--space-6);
    --turn: -2.5deg;
  }

  /* Each window drifts at its own speed while the desk scrolls past (CSS scroll timeline). */
  @supports (animation-timeline: view()) {
    .win {
      animation: win-drift linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }

    .win--live {
      --from: 40px;
      --to: -40px;
    }

    .win--reels {
      --from: 120px;
      --to: -120px;
    }

    .win--brief {
      --from: 80px;
      --to: -20px;
    }

    .win--roster {
      --from: 160px;
      --to: -60px;
    }

    @keyframes win-drift {
      from {
        transform: translateY(var(--from, 0));
      }
      to {
        transform: translateY(var(--to, 0));
      }
    }
  }

  /* ---------- Window chrome ---------- */
  .win__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 34px;
    padding: 0 var(--space-3);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background: #0e2142;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }

  .win__dots {
    display: inline-flex;
    gap: 6px;
  }

  .win__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.22);
  }

  .win__dots i:first-child {
    background: var(--ice);
  }

  .win__tab {
    padding: 4px 10px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.06);
  }

  .win__view {
    position: relative;
  }

  .win__view--wide {
    aspect-ratio: 16 / 10;
  }

  .win__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    font-size: var(--type-small);
  }

  .win__foot a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 3px;
  }

  .win__foot a:hover {
    text-decoration-color: var(--ice);
  }

  .win__foot span {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }

  .win__reels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    padding: var(--space-2);
  }

  .win__reel {
    overflow: hidden;
    border-radius: 10px;
  }

  .world :global(.win__interim) {
    top: auto;
    bottom: var(--space-3);
    left: var(--space-3);
    right: auto;
  }

  .win__brief {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .win__brief dt {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ice);
  }

  .win__brief dd {
    font-size: var(--type-body);
  }

  .win__brief dd a {
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 3px;
  }

  .win__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .win__tags span {
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
    font-size: var(--type-small);
  }

  .win__faces {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-8);
  }

  .win__faces a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 0.1);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }

  .win__faces a:hover,
  .win__faces a:focus-visible {
    box-shadow: 0 0 0 2px var(--ice);
  }

  .win__faces img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1023px) {
    .win--live {
      grid-column: 1 / 9;
    }

    .win--reels {
      grid-column: 7 / 13;
    }

    .win--brief {
      grid-column: 1 / 7;
    }

    .win--roster {
      grid-column: 1 / 6;
      grid-row: 3;
      margin-top: 0;
    }
  }

  /* ---------- Phones: the windows stack, each slightly turned ---------- */
  @media (max-width: 767px) {
    .world__desk {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .win--live,
    .win--reels,
    .win--brief,
    .win--roster {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0;
    }

    .win--roster {
      width: 72%;
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .win {
      animation: none;
      rotate: 0deg;
      transition: none;
    }
  }
</style>
