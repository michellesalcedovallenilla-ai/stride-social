---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DetailHero from '@/components/sections/DetailHero.astro';
import PostArticle from '@/components/editorial/PostArticle.astro';
import RelatedPosts from '@/components/editorial/RelatedPosts.astro';
import { getPosts, toCard, type Post } from '@/components/editorial/blog';
import { footerCtas } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    // The live "more..." list is the first four posts in CMS order, skipping the current one.
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(0, 4) },
  }));
}

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { data } = post;
// Bodies are HTML inside Markdown; the rendered string lets PostArticle wrap tables.
const html = post.rendered?.html ?? '';
---

<BaseLayout
  title={data.seo?.title ?? data.title}
  description={data.seo?.description ?? data.summary}
  ogImage={data.seo?.ogImage ?? data.cardImage}
  nav="solid"
  footerCta={footerCtas.standard}
  background="smoke"
>
  <DetailHero tag={data.category} title={data.title} summary={data.summary} size="long" alignBottom />
  <PostArticle date={data.date} dateLabel={data.dateLabel} author={data.author} html={html} asideImage={data.asideImage}>
    <RelatedPosts cards={related.map((p) => toCard(p))} />
  </PostArticle>
</BaseLayout>

