---
// Stride Talent landing; the page's content is shared with the homepage's Talent card
// (components/talent/TalentPage.astro).
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import TalentPage from '@/components/talent/TalentPage.astro';

const page = await getEntry('pages', 'talent');
if (!page) throw new Error('Missing src/content/pages/talent.yaml');
---

<SiteLayout title="Stride Talent | Creator Management" description={page.data.sections.hero.body} division="talent" look="deep" headerOverlay>
  <TalentPage />
</SiteLayout>
