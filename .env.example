# Copy to .env for local development. Real values belong in the hosting provider's settings.

# URL the general contact form on /contact POSTs to. Same contract and fallback as the other
# forms below (Q13): empty shows a labelled "temporarily unavailable, email us" state.
PUBLIC_CONTACT_FORM_ACTION=

# URL the Stride Social brand enquiry form POSTs to (/social/enquire and the end of /social).
# Any endpoint that accepts form data and answers JSON works (a host function or a form
# service). Destination inbox/CRM is open question Q13. Leave empty and the form shows a
# labelled "temporarily unavailable, email us" state instead of failing silently.
PUBLIC_BRAND_ENQUIRY_ACTION=

# URL the Stride Talent application form POSTs to (/talent/apply and the end of /talent).
# Same contract and fallback as the brand enquiry form (Q13).
PUBLIC_TALENT_APPLICATION_ACTION=

# URL the Stride Education enquiry form POSTs to (/education/enquire). The route itself
# (waitlist, enquiry or course platform) depends on Q11; destination on Q13.
PUBLIC_EDUCATION_ENQUIRY_ACTION=

# production = live build (hides sections awaiting content; placeholders must be gone).
# Anything else (or unset) = preview.
PUBLIC_SITE_ENV=
