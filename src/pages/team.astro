---
// Our Team (docs/phase-2/05-wireframes.md §E; brief §7: names, roles, genuine photographs and
// optional bios). Leadership row, filterable team grid, careers CTA.
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageIntro from '@/components/global/PageIntro.astro';
import Button from '@/components/core/Button.astro';
import TeamGrid from '@/components/group/TeamGrid.astro';

const s = (await getEntry('pages', 'team'))?.data.sections;
if (!s) throw new Error('Missing src/content/pages/team.yaml');
---

<SiteLayout title="Our Team | Stride" description={s.hero.body}>
  <PageIntro crumbs={[{ label: 'About', href: '/about' }, { label: 'Our Team' }]} copy={s.hero} tone="light" />
  <section class="team-page" aria-label="Team members">
    <TeamGrid />
  </section>
  <section class="join" aria-labelledby="join-title">
    <div class="join__inner container-wide">
      <h2 class="join__title" id="join-title">{s.join.headline}</h2>
      {s.join.cta && <Button href={s.join.cta.href} tone="dark" arrow>{s.join.cta.label}</Button>}
    </div>
  </section>
</SiteLayout>

<style>
  .team-page {
    position: relative;
    z-index: 1;
    background: var(--paper);
    color: var(--navy-900);
  }

  .join {
    position: relative;
    z-index: 1;
    background: var(--navy-900);
    color: var(--white);
  }

  .join__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: clamp(64px, 8vw, 128px);
  }

  .join__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
</style>
