---
// Stride Social landing. The content is shared with the homepage, where the Social card opens onto
// it (components/social/SocialPage.astro).
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import SocialPage from '@/components/social/SocialPage.astro';

const page = await getEntry('pages', 'social');
if (!page) throw new Error('Missing src/content/pages/social.yaml');
---

<SiteLayout
  title="Stride Social | Influencer Marketing Agency"
  description={page.data.sections.hero.body}
  division="social"
  headerOverlay
>
  <SocialPage />
</SiteLayout>
