---
// Small uppercase IBM Plex Mono eyebrow label. `light` for dark backgrounds.
export interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'dark', class: className, ...rest } = Astro.props;
---

<div class:list={['mono-label', `mono-label--${tone}`, className]} {...rest}><slot /></div>

<style>
  .mono-label {
    font-family: var(--font-mono);
    font-size: 1em;
    font-weight: 300;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .mono-label--dark {
    color: var(--color-navy);
  }

  .mono-label--light {
    color: var(--color-smoke);
  }

  @media screen and (max-width: 479px) {
    .mono-label {
      font-size: 0.8em;
    }

    /* The live site flips light labels to navy on phones. */
    .mono-label--light {
      color: var(--color-navy);
    }
  }
</style>
