---
// Meet the team: white cards (name, role, square photo) in a 3/2/1 column grid.
// Members with a second photo cross-fade to it on hover, as on the live site.
export interface Member {
  name: string;
  role: string;
  photo: string;
  photoAlt?: string;
  hoverPhoto?: string;
}

export interface Props {
  members: Member[];
}

const { members } = Astro.props;
---

<section class="team">
  <div class="team__inner">
    <ul class="team__grid" role="list">
      {members.map((m) => (
        <li class:list={['team-card', { 'team-card--swap': m.hoverPhoto }]}>
          <div class="team-card__info">
            <h2 class="team-card__name">{m.name}</h2>
            <p class="team-card__role">{m.role}</p>
          </div>
          <div class="team-card__image">
            <img class="team-card__photo" src={m.photo} alt={m.photoAlt ?? ''} loading="lazy" decoding="async" />
            {m.hoverPhoto && <img class="team-card__photo-alt" src={m.hoverPhoto} alt="" loading="lazy" decoding="async" />}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team {
    position: relative;
    z-index: 1;
    padding-inline: 45px;
    background-color: var(--color-smoke);
  }

  .team__inner {
    padding: 10rem 2rem;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1rem;
    border-radius: 0.3rem;
    color: #313131;
    background-color: var(--color-white);
  }

  .team-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .team-card__name {
    font-family: var(--font-sans);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-navy);
  }

  .team-card__role {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 20px;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .team-card__image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.2rem;
  }

  .team-card__photo,
  .team-card__photo-alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .team-card__photo {
    z-index: 1;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .team-card--swap:hover .team-card__photo {
      opacity: 0;
    }
  }

  @media screen and (max-width: 991px) {
    .team__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 767px) {
    .team {
      padding-inline: 1rem;
    }

    .team__grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 479px) {
    .team-card__role {
      font-size: 0.6rem;
    }
  }
</style>
