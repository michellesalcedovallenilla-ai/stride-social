---
// Job page meta row under the hero: location on the left, salary on the right.
export interface Props {
  location?: string | null;
  salary?: string | null;
}

const { location, salary } = Astro.props;
---

<section class="job-meta">
  <div class="job-meta__row">
    {location && (
      <p class="job-meta__item">
        <span>{location}</span>
      </p>
    )}
    {salary && (
      <p class="job-meta__item job-meta__item--salary">
        <span>Salary -</span>
        <span>{salary}</span>
      </p>
    )}
  </div>
</section>

<style>
  .job-meta {
    position: relative;
    padding-inline: 2.5rem;
    background-color: var(--color-smoke-2);
  }

  .job-meta__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 2rem;
  }

  .job-meta__item {
    display: flex;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-navy-mute);
  }

  .job-meta__item--salary {
    gap: 12px;
    margin-left: auto;
  }

  @media screen and (max-width: 479px) {
    .job-meta {
      padding-left: 20px;
    }

    .job-meta__row {
      gap: 10px;
    }

    .job-meta__item {
      flex-wrap: wrap;
      font-size: 0.8rem;
    }

    .job-meta__item > span {
      margin-right: 6px;
    }
  }
</style>
