---
// Stride Talent C6 "Divisions": five tall cards in a row, unlike the homepage's typographic
// index. The hovered or focused card widens. Active divisions link to their page; coming-soon
// divisions show a label and do not link (no dead ends). Member counts appear only for active
// divisions, counted from published roster entries. Phones get a stack of wide bands.
import { getCollection } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import { getRoster } from '@/lib/roster';
import { routes } from '@/lib/routes';

export interface Props {
  copy: { eyebrow?: string; headline?: string };
}

const { copy } = Astro.props;
const divisions = (await getCollection('talentDivisions')).sort((a, b) => a.data.order - b.data.order);
const roster = await getRoster();
const cards = divisions.map((d) => ({
  id: d.id,
  name: d.data.name,
  short: d.data.name.replace(/^Stride /, ''),
  active: d.data.status === 'active',
  tagline: d.data.tagline,
  image: d.data.hero,
  members: roster.filter((c) => c.data.divisions.some((x) => x.id === d.id)).length,
}));
---

<section class="divs" id="divisions" aria-labelledby="divs-title">
  <div class="divs__inner container-wide">
    <header class="divs__head">
      <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
      <h2 class="divs__title" id="divs-title" data-reveal-lines>{copy.headline}</h2>
    </header>
    <ul class="divs__row" role="list">
      {cards.map((c, i) => {
        const Tag = c.active ? 'a' : 'div';
        return (
          <li class:list={['div-card', { 'div-card--soon': !c.active }]}>
            <Tag class="div-card__box" href={c.active ? routes.talentDivision(c.id) : undefined}>
              {c.image && <img class="div-card__img" src={c.image.src} alt="" loading="lazy" />}
              <span class="div-card__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="div-card__text">
                <span class="div-card__brand">Stride</span>
                <h3 class="div-card__name">{c.short}</h3>
                {c.active && c.tagline && <span class="div-card__tag">{c.tagline}</span>}
                <span class="div-card__status">{c.active ? (c.members > 0 ? `${c.members} creators` : 'Explore') : 'Coming soon'}</span>
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .divs {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--navy-900);
    color: var(--white);
  }

  .divs__inner {
    display: grid;
    gap: var(--space-8);
  }

  .divs__head {
    display: grid;
    gap: var(--space-4);
  }

  .divs__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .divs__row {
    display: flex;
    gap: var(--space-3);
    height: clamp(420px, 44vw, 620px);
  }

  .div-card {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow var(--dur-slow) var(--ease-out);
  }

  .div-card:hover,
  .div-card:focus-within {
    flex-grow: 1.8;
  }

  .div-card__box {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: var(--space-5);
    overflow: hidden;
    background: var(--navy-700);
    isolation: isolate;
  }

  .div-card--soon .div-card__box {
    border: 1px solid var(--line-dark);
    background: none;
  }

  .div-card__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .div-card__n,
  .div-card__brand,
  .div-card__status,
  .div-card__tag {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .div-card__text {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .div-card__brand {
    color: var(--accent);
  }

  /* On the tall cards names run up the card, so even "SPEAKERS" fits a narrow column. */
  .div-card__name {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.2vw, 4.75rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .div-card--soon .div-card__name {
    color: transparent;
    -webkit-text-stroke: 1px var(--white);
  }

  .div-card--soon:hover .div-card__name {
    color: var(--accent);
    -webkit-text-stroke: 0;
  }

  .div-card__status {
    align-self: stretch;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-dark);
    color: rgb(255 255 255 / 0.75);
  }

  @media (max-width: 1023px) {
    .divs__row {
      flex-direction: column;
      height: auto;
    }

    .div-card,
    .div-card:hover,
    .div-card:focus-within {
      flex: none;
    }

    .div-card__box {
      flex-direction: row;
      align-items: flex-end;
      gap: var(--space-5);
      min-height: 120px;
    }

    .div-card__text {
      flex: 1;
    }

    .div-card__name {
      writing-mode: horizontal-tb;
      transform: none;
      line-height: 0.95;
      font-size: clamp(1.75rem, 6vw, 3.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .div-card {
      transition: none;
    }
  }
</style>
