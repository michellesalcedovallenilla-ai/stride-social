---
// Homepage A9 "Global presence": a typographic display of markets from the markets collection.
// Talent markets come from the client brief; team locations and operating markets are only
// listed once verified, and offices are never implied (brief §3.9).
import { getCollection } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';

export interface Props {
  copy: { eyebrow?: string; headline?: string };
}

const { copy } = Astro.props;
const markets = (await getCollection('markets', (m) => m.data.status === 'verified'));
const talent = markets.filter((m) => m.data.roles.includes('talent-market'));
const operating = markets.filter((m) => m.data.roles.some((r) => r !== 'talent-market'));
// Cap the title so its longest word fits the column (the About page uses "International presence.").
const longest = Math.max(1, ...(copy.headline ?? '').split(/\s+/).map((w) => w.length));
const fit = `${(100 / (longest * 0.86)).toFixed(2)}cqi`;
---

<section class="markets" aria-labelledby="markets-title">
  <div class="markets__inner">
    <header class="markets__head">
      <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
      <h2 class="markets__title" id="markets-title" data-reveal-lines style={`--fit: ${fit}`}>{copy.headline}</h2>
    </header>

    <div class="markets__cols">
      <div class="markets__col">
        <p class="markets__label">Talent markets</p>
        <ul class="markets__list" role="list">
          {talent.map((m, i) => (
            <li class="markets__item" data-reveal="rise" style={`--reveal-delay: ${i * 0.06}s`}>
              <span class="markets__code">{m.id.toUpperCase()}</span>
              <span class="markets__name">{m.data.label}</span>
            </li>
          ))}
        </ul>
      </div>

      {operating.length > 0 ? (
        <div class="markets__col markets__col--secondary">
          <p class="markets__label">Team and operating markets</p>
          <ul class="markets__list markets__list--small" role="list">
            {operating.map((m) => (
              <li class="markets__item"><span class="markets__code">{m.id.toUpperCase()}</span><span class="markets__name">{m.data.label}</span></li>
            ))}
          </ul>
        </div>
      ) : (
        isPreview && (
          <div class="markets__col markets__col--secondary">
            <p class="markets__label">Team and operating markets</p>
            <PlaceholderNotice variant="block" label="Awaiting verified locations">
              <p>Shown once Stride confirms team locations and operating markets (Q3). Hidden on the live site until then; offices are never implied.</p>
            </PlaceholderNotice>
          </div>
        )
      )}
    </div>
  </div>
</section>

<style>
  .markets {
    position: relative;
    z-index: 1;
    background: var(--navy-900);
    color: var(--white);
  }

  .markets__inner {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-8) var(--gutter);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: var(--section-pad) var(--margin);
  }

  .markets__head {
    grid-column: 1 / 6;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    min-width: 0;
    container-type: inline-size;
  }

  .markets__title {
    font-family: var(--font-display);
    font-size: min(clamp(2.5rem, 4vw, 4.75rem), var(--fit));
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .markets__cols {
    grid-column: 7 / -1;
    min-width: 0;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-8);
  }

  .markets__label {
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .markets__list {
    border-top: 1px solid var(--line-dark);
  }

  .markets__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line-dark);
  }

  .markets__code {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    color: rgb(255 255 255 / 0.6);
  }

  .markets__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 3.5rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .markets__list--small .markets__name {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
  }

  .markets__col--secondary :global(.ph-block) {
    border-color: rgb(255 255 255 / 0.35);
    color: var(--white);
    background: none;
  }

  @media (max-width: 1023px) {
    .markets__head,
    .markets__cols {
      grid-column: 1 / -1;
    }

    .markets__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
