---
// Article: the cover full-bleed with the title in glass at its foot, then the text on navy, with a thin
// line of light along the top of the screen and a glass pill counting down the minutes left as you read
// (worked out from the article's own length). Share links stay beside it; more in the topic in the shared
// menu. Structured data: Article. Body HTML is the migrated article (trusted repository content).
import SiteLayout from '@/layouts/SiteLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import Prose from '@/components/core/Prose.astro';
import Deck from '@/components/experience/Deck.astro';
import { categoryLabels, formatDate, getArticles, normaliseHeadings, readingMinutes, realAside, type Article } from '@/lib/insights';
import { routes } from '@/lib/routes';
import { rewriteLegacyLinks } from '@/lib/legacy-links';
import { site } from '@/config/site';
import { interfaceCopy } from '@/lib/ui-copy';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article, articles } }));
}

const { article, articles } = Astro.props as { article: Article; articles: Article[] };
const t = await interfaceCopy();
const d = article.data;
// Bodies are migrated HTML: headings are renumbered so the outline never skips a level, and links
// to the previous site's URLs point straight at the new pages.
const body = rewriteLegacyLinks(normaliseHeadings((article.body ?? '').replace(/<!--[\s\S]*?-->/g, '')));
const aside = realAside(article);
const minutes = readingMinutes(article);
const related = articles.filter((a) => a.id !== article.id && a.data.category === d.category).slice(0, 8);
const url = new URL(routes.article(article.id), site.url).href;
const share = [
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { label: 'X', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}` },
  { label: 'Email', href: `mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(url)}` },
];
const author = d.authorName;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.standfirst,
    image: new URL(d.cover.src, site.url).href,
    ...(d.date ? { datePublished: d.date.toISOString().slice(0, 10) } : {}),
    ...(author ? { author: { '@type': 'Person', name: author } } : {}),
    publisher: { '@type': 'Organization', name: 'Stride Social', url: site.url },
  },
];
---

<SiteLayout title={d.seo?.title ?? `${d.title} | Stride Insights`} description={d.seo?.description ?? d.standfirst} ogImage={d.cover.src} ogType="article" jsonLd={jsonLd} headerOverlay>
  <article class="read" data-read data-minutes={minutes} data-tone="group">
    <span class="read__line" aria-hidden="true"></span>

    <header class="read__hero on-photo" data-look="deep">
      <img class="read__cover" src={d.cover.src} alt={d.cover.alt} fetchpriority="high" decoding="async" />
      <div class="read__scrim" aria-hidden="true" data-backdrop></div>
      <div class="read__head container-wide">
        <div class="read__panel glass">
          <Breadcrumbs items={[{ label: 'Insights', href: '/insights' }, { label: categoryLabels[d.category], href: routes.insightsFiltered(d.category) }]} tone="dark" />
          <h1 class="read__title exp-title">{d.title}</h1>
          <p class="read__stand">{d.standfirst}</p>
          <p class="exp-label">
            {d.date && <><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time> · </>}{minutes} min read{author && <> · By {author}</>}
          </p>
        </div>
      </div>
    </header>

    <div class="read__body container-wide" data-look="white" data-read-body>
      <aside class="read__side">
        <p class="exp-label">Share</p>
        <ul class="read__share" role="list">
          {share.map((s) => (
            <li><a class="exp-chip" href={s.href} target={s.label === 'Email' ? undefined : '_blank'} rel="noopener">{s.label}{s.label !== 'Email' && <span class="visually-hidden"> (opens in a new tab)</span>}</a></li>
          ))}
        </ul>
      </aside>
      <Prose class="read__prose exp-prose" html={body} />
      {aside && (
        <figure class="read__aside">
          <img src={aside.src} alt={aside.alt} loading="lazy" />
        </figure>
      )}
    </div>

    <nav class="read__rail desk-only" aria-label={t('article.sections')} data-read-rail></nav>

    <div class="read__quote glass on-photo desk-only" hidden data-read-quote>
      <a class="exp-chip" href="#" target="_blank" rel="noopener" data-read-share>{t('article.share')}</a>
      <button class="exp-chip" type="button" data-read-copy data-done={t('article.copied')}>{t('article.copy')}</button>
    </div>

    <p class="read__left glass on-photo" aria-hidden="true"><span data-read-left>{minutes}</span> min left</p>
  </article>

  {related.length > 0 && (
    <Deck
      id="read-more"
      label={`More in ${categoryLabels[d.category]}`}
      tone="group"
      look="deep"
      tabs={[{
        key: 'more',
        label: `More in ${categoryLabels[d.category]}`,
        icon: 'book',
        cards: related.map((a) => ({ name: a.data.title, text: `${formatDate(a.data.date)} · ${readingMinutes(a)} min`, href: routes.article(a.id), image: a.data.cover, direct: true })),
      }]}
      link={{ label: 'All Insights', href: '/insights' }}
    />
  )}
</SiteLayout>

<style>
  .read {
    position: relative;
    color: rgb(var(--ink));
  }

  /* How far you've read: a line of light along the top of the screen. */
  .read__line {
    position: fixed;
    inset: 0 0 auto;
    z-index: 110;
    height: 3px;
    background: rgb(var(--tone-lit));
    box-shadow: 0 0 14px rgb(var(--tone-glow));
    transform: scaleX(var(--read, 0));
    transform-origin: left;
  }

  .read__hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
  }

  .read__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: contrast(1.1) saturate(1.18) brightness(0.94);
  }

  .read__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(var(--backdrop, var(--tone-surface))), rgb(var(--backdrop, var(--tone-surface)) / 0) 55%),
      linear-gradient(to bottom, rgb(6 20 43 / 0.55), rgb(6 20 43 / 0) 24%);
  }

  .read__head {
    position: relative;
    width: 100%;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-6);
  }

  .read__panel {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
    padding: clamp(22px, 2.6vw, 42px);
  }

  .read__title {
    font-size: clamp(1.875rem, 3.8vw, 4rem);
    line-height: 0.98;
  }

  .read__stand {
    font-size: var(--type-lead);
    line-height: 1.34;
    color: rgb(var(--ink) / 0.9);
  }

  /* ---------- The text ---------- */
  .read__body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 7fr) minmax(0, 3fr);
    gap: var(--space-6) var(--gutter);
    align-items: start;
    padding-block: var(--space-7) var(--space-8);
  }

  .read__side {
    position: sticky;
    top: calc(var(--header-h) + var(--space-3));
    display: grid;
    gap: var(--space-2);
  }

  .read__share {
    display: grid;
    justify-items: start;
    gap: 6px;
  }

  .read__aside {
    position: sticky;
    top: calc(var(--header-h) + var(--space-3));
  }

  .read__aside img {
    width: 100%;
    border-radius: 22px;
  }

  /* Minutes left. */
  .read__left {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 40;
    padding: 10px 16px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgb(6 20 43 / 0.72);
    opacity: var(--pill, 0);
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }

  /* A dot for each section down the side of the screen. */
  .read__rail {
    position: fixed;
    top: 50%;
    right: var(--space-5);
    z-index: 40;
    display: grid;
    gap: 2px;
    opacity: var(--pill, 0);
    transform: translateY(-50%);
    transition: opacity 400ms var(--ease-out);
  }

  .read__rail :global(button) {
    position: relative;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
  }

  .read__rail :global(button::before) {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(var(--ink) / 0.3);
    transition:
      background-color 240ms var(--ease-out),
      scale 240ms var(--ease-out);
  }

  .read__rail :global(button.is-here::before),
  .read__rail :global(button:hover::before) {
    background: rgb(var(--tone-lit));
    scale: 1.5;
  }

  .read__rail :global(button span) {
    position: absolute;
    top: 50%;
    right: 100%;
    max-width: 18rem;
    padding: 5px 12px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(var(--panel) / 0.92);
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.2);
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--ink));
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition: opacity 180ms var(--ease-out);
  }

  .read__rail :global(button:hover span),
  .read__rail :global(button:focus-visible span) {
    opacity: 1;
  }

  /* Share a sentence: appears over what's selected. */
  .read__quote {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    display: flex;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(6 20 43 / 0.92);
    transform: translate(var(--qx, 0), var(--qy, 0));
  }

  .read__quote[hidden] {
    display: none;
  }

  @media (max-width: 1023px) {
    .read__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .read__side,
    .read__aside {
      position: static;
    }

    .read__share {
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-read]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const body = root.querySelector<HTMLElement>('[data-read-body]');
    const left = root.querySelector<HTMLElement>('[data-read-left]');
    const minutes = Number(root.dataset.minutes) || 1;
    if (!body) return;
    const update = () => {
      const r = body.getBoundingClientRect();
      const f = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight)));
      root.style.setProperty('--read', f.toFixed(4));
      root.style.setProperty('--pill', r.top < window.innerHeight * 0.4 && r.bottom > window.innerHeight * 0.6 ? '1' : '0');
      if (left) left.textContent = String(Math.max(0, Math.ceil(minutes * (1 - f))));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();

    if (!window.matchMedia('(min-width: 1024px)').matches) return;
    const scrollTo = (y: number) => {
      const l = (window as unknown as { lenis?: { scrollTo(t: number, o?: { duration?: number; force?: boolean }): void } }).lenis;
      if (l) l.scrollTo(y, { duration: 0.9, force: true });
      else window.scrollTo(0, y);
    };

    /* ---------- The section dots ---------- */
    const rail = root.querySelector<HTMLElement>('[data-read-rail]');
    const heads = [...body.querySelectorAll<HTMLElement>('.read__prose h2, .read__prose h3')];
    const top = heads.filter((h) => h.tagName === heads[0]?.tagName);
    if (rail && top.length > 1) {
      const dots = top.map((h) => {
        const b = document.createElement('button');
        b.type = 'button';
        const label = document.createElement('span');
        label.textContent = h.textContent?.trim() ?? '';
        b.append(label);
        b.setAttribute('aria-label', label.textContent ?? '');
        b.addEventListener('click', () => scrollTo(h.getBoundingClientRect().top + window.scrollY - 110));
        rail.append(b);
        return b;
      });
      const spy = () => {
        let at = 0;
        top.forEach((h, i) => {
          if (h.getBoundingClientRect().top < window.innerHeight * 0.4) at = i;
        });
        dots.forEach((d, i) => d.classList.toggle('is-here', i === at));
      };
      window.addEventListener('scroll', spy, { passive: true });
      spy();
    }

    /* ---------- Share a sentence ---------- */
    const quote = root.querySelector<HTMLElement>('[data-read-quote]');
    const share = root.querySelector<HTMLAnchorElement>('[data-read-share]');
    const copy = root.querySelector<HTMLButtonElement>('[data-read-copy]');
    const prose = body.querySelector<HTMLElement>('.read__prose');
    if (quote && share && copy && prose) {
      let chosen = '';
      const pageUrl = location.href.split('#')[0];
      const hide = () => (quote.hidden = true);
      document.addEventListener('selectionchange', () => {
        const s = document.getSelection();
        const text = s?.toString().trim() ?? '';
        if (!s || s.isCollapsed || text.length < 16 || text.length > 280 || !prose.contains(s.anchorNode)) return hide();
        chosen = text;
        const r = s.getRangeAt(0).getBoundingClientRect();
        quote.hidden = false;
        quote.style.setProperty('--qx', `${Math.max(12, r.left + r.width / 2 - quote.offsetWidth / 2)}px`);
        quote.style.setProperty('--qy', `${Math.max(12, r.top - quote.offsetHeight - 10)}px`);
        share.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`“${chosen}”`)}&url=${encodeURIComponent(pageUrl)}`;
      });
      window.addEventListener('scroll', hide, { passive: true });
      copy.addEventListener('click', async () => {
        const label = copy.textContent;
        try {
          await navigator.clipboard.writeText(`${pageUrl}#:~:text=${encodeURIComponent(chosen)}`);
          copy.textContent = copy.dataset.done ?? label;
          window.setTimeout(() => (copy.textContent = label), 1400);
        } catch {
          /* the browser refused: the sentence is still selected */
        }
      });
    }
  });
</script>
