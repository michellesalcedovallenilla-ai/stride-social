---
// Stride Education D4 "The experience": six items in deliberately varied sizes, each with an
// image slot, title, one line and an availability label. The brief requires available and
// planned benefits to be clearly distinguished: available items are filled (sun), planned items
// are outlined and quieter. Items show only once Stride confirms them (src/lib/education.ts);
// image slots are labelled frames in preview until photography exists (Q18).
import Eyebrow from '../core/Eyebrow.astro';
import DraftTag from '../core/DraftTag.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import Availability from './Availability.astro';
import { getExperience } from '@/lib/education';
import { isPreview } from '@/lib/env';

export interface Props {
  copy: { eyebrow?: string; headline?: string };
}

const { copy } = Astro.props;
const items = await getExperience();
const draft = items.some((t) => t.data.copyStatus !== 'approved');
// Size rhythm across the six items: one large block beside four regular ones, then one wide band.
const sizes = ['l', 's', 's', 's', 's', 'w'];
---

{items.length > 0 && (
  <section class="exp" id="experience" aria-labelledby="exp-title">
    <div class="exp__inner container-wide">
      <header class="exp__head">
        <div>
          <Eyebrow tone="light">{copy.eyebrow}</Eyebrow>
          <h2 class="exp__title" id="exp-title" data-reveal-lines>{copy.headline}</h2>
        </div>
        <div class="exp__key">
          <DraftTag status={draft ? 'draft' : 'approved'} />
          <p class="exp__legend"><span class="exp__swatch exp__swatch--available"></span>Available now <span class="exp__swatch exp__swatch--planned"></span>Coming soon</p>
        </div>
      </header>
      <ul class="exp__grid" role="list">
        {items.map((item, i) => (
          <li class:list={['exp-item', `exp-item--${sizes[i % sizes.length]}`, `exp-item--${item.data.status}`]} data-reveal="rise" style={`--reveal-delay: ${(i % 3) * 0.06}s`}>
            {isPreview && (
              <div class="exp-item__media" aria-hidden="true">
                <PlaceholderNotice label="Awaiting photography">(Q18)</PlaceholderNotice>
              </div>
            )}
            <div class="exp-item__body">
              <Availability status={item.data.status} />
              <h3 class="exp-item__title">{item.data.title}</h3>
              {item.data.summary && <p class="exp-item__summary">{item.data.summary}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .exp {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--paper);
    color: var(--navy-900);
    scroll-margin-top: calc(var(--header-h) + var(--division-bar-h));
  }

  .exp__inner {
    display: grid;
    gap: var(--space-8);
  }

  .exp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .exp__head > div:first-child {
    display: grid;
    gap: var(--space-4);
  }

  .exp__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .exp__key {
    display: grid;
    gap: var(--space-3);
    justify-items: end;
  }

  .exp__legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .exp__swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-left: var(--space-3);
  }

  .exp__swatch--available {
    background: var(--sun);
  }

  .exp__swatch--planned {
    border: 1.5px solid var(--navy-900);
  }

  .exp__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .exp-item {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 280px;
    overflow: hidden;
    background: var(--white);
  }

  .exp-item--l {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* Wide band: image left, text right. */
  .exp-item--w {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto;
    min-height: 0;
  }

  .exp-item--w .exp-item__media {
    border-right: 1px dashed rgb(6 20 43 / 0.25);
    border-bottom: 0;
  }

  .exp-item--w .exp-item__title {
    font-size: clamp(1.75rem, 3vw, 3rem);
  }

  .exp-item--available {
    background: var(--sun);
  }

  .exp-item--planned {
    border: 1.5px solid var(--navy-900);
    background: none;
    color: var(--navy-700);
  }

  .exp-item--unconfirmed {
    border: 1px dashed rgb(6 20 43 / 0.35);
    background: var(--white);
  }

  .exp-item__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: repeating-linear-gradient(-45deg, transparent 0 14px, rgb(6 20 43 / 0.04) 14px 28px);
    border-bottom: 1px dashed rgb(6 20 43 / 0.25);
  }

  .exp-item--l .exp-item__media {
    aspect-ratio: 4 / 3;
  }

  .exp-item__body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
  }

  .exp-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 2rem);
    font-weight: 800;
    font-stretch: 108%;
    line-height: 1.05;
  }

  .exp-item--l .exp-item__title {
    font-size: clamp(1.75rem, 3vw, 3rem);
  }

  .exp-item__summary {
    max-width: 40ch;
  }

  @media (max-width: 1023px) {
    .exp__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .exp-item--l {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .exp-item--w {
      grid-template-columns: minmax(0, 1fr);
    }

    .exp-item--w .exp-item__media {
      border-right: 0;
      border-bottom: 1px dashed rgb(6 20 43 / 0.25);
    }

    .exp__key {
      justify-items: start;
    }
  }

  @media (max-width: 599px) {
    .exp__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .exp__legend {
      flex-wrap: wrap;
    }
  }
</style>
