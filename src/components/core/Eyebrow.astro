---
// Small mono label above headlines ("01 — FOR BRANDS", "EXPLORE STRIDE").
export interface Props {
  number?: string;
  tone?: 'light' | 'dark';
  as?: 'p' | 'span' | 'div';
  class?: string;
}

const { number, tone = 'light', as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', `eyebrow--on-${tone}`, className]}>
  {number && <span class="eyebrow__number">{number} —</span>}
  <slot />
</Tag>

<style>
  .eyebrow {
    display: inline-flex;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .eyebrow--on-light {
    color: var(--slate);
  }

  .eyebrow--on-dark {
    color: rgb(255 255 255 / 0.78);
  }

  .eyebrow__number {
    color: inherit;
    opacity: 0.8;
  }
</style>
