---
// 404 (docs/phase-2/05-wireframes.md §E): a short message and routes to the three divisions and
// home, inside the normal site chrome so visitors can navigate on. Replaces the Phase 1 page.
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Eyebrow from '@/components/core/Eyebrow.astro';

const copy = (await getEntry('pages', 'system'))?.data.sections.notFound;
if (!copy) throw new Error('Missing notFound in src/content/pages/system.yaml');
const routes = [
  { key: 'social', label: 'Stride Social', note: 'For brands', href: '/social' },
  { key: 'talent', label: 'Stride Talent', note: 'For creators', href: '/talent' },
  { key: 'education', label: 'Stride Education', note: 'For the next generation', href: '/education' },
  { key: 'home', label: 'Homepage', note: 'Start again', href: '/' },
];
---

<SiteLayout title="Page not found | Stride" description={copy.body} noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf__inner container-wide">
      <p class="nf__code" aria-hidden="true">404</p>
      <div class="nf__text">
        <Eyebrow tone="light">{copy.eyebrow}</Eyebrow>
        <h1 class="nf__title" id="nf-title">{copy.headline}</h1>
        <p class="nf__body">{copy.body}</p>
      </div>
      <ul class="nf__routes" role="list">
        {routes.map((r) => (
          <li>
            <a class={`nf__route nf__route--${r.key}`} href={r.href}>
              <span class="nf__swatch" aria-hidden="true"></span>
              <span class="nf__label">{r.label}</span>
              <span class="nf__note">{r.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .nf {
    position: relative;
    z-index: 1;
    background: var(--paper);
    color: var(--navy-900);
  }

  .nf__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--gutter);
    align-content: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--space-9);
    container-type: inline-size;
  }

  /* Outlined numerals sized to the container, so they never overflow. */
  .nf__code {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: min(34cqi, 22rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px var(--navy-900);
  }

  .nf__text {
    grid-column: 1 / 7;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .nf__title {
    font-family: var(--font-display);
    font-size: var(--type-h1);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .nf__body {
    max-width: 40ch;
    font-size: var(--type-lead);
  }

  .nf__routes {
    grid-column: 8 / -1;
    border-top: 1px solid var(--navy-900);
  }

  .nf__route {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }

  .nf__swatch {
    width: 14px;
    height: 14px;
    border: 1px solid var(--navy-900);
  }

  .nf__route--social .nf__swatch { background: var(--navy-900); }
  .nf__route--talent .nf__swatch { background: var(--peach); }
  .nf__route--education .nf__swatch { background: var(--sun); }

  .nf__label {
    font-weight: 700;
  }

  .nf__note {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .nf__route:hover .nf__label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .nf__text,
    .nf__routes {
      grid-column: 1 / -1;
    }
  }
</style>
