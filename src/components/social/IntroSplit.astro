---
// Stride Social B3 "INFLUENCE IS MORE THAN A POST.": type-led editorial split, a deliberate pause
// after the logos. Headline left (c1–c6), short paragraphs right (c8–c12). Proof points stay out
// until Stride re-verifies its figures (Q7).
import DraftTag from '../core/DraftTag.astro';

export interface Props {
  copy: { status: 'approved' | 'draft'; headline?: string; body?: string };
}

const { copy } = Astro.props;
const paragraphs = (copy.body ?? '').split(/\n\s*\n/).filter(Boolean);
---

<section class="intro" aria-labelledby="intro-title">
  <div class="intro__inner container-wide">
    <div class="intro__head">
      <h2 class="intro__title" id="intro-title" data-reveal-lines>{copy.headline}</h2>
    </div>
    <div class="intro__body" data-reveal="rise">
      <DraftTag status={copy.status} />
      {paragraphs.map((p, i) => <p class:list={{ 'intro__lead': i === 0 }}>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--navy-900);
    color: var(--white);
  }

  .intro__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--gutter);
    align-items: start;
  }

  /* Title size follows its column so the longest word ("INFLUENCE") always fits. */
  .intro__head {
    grid-column: 1 / 7;
    container-type: inline-size;
  }

  .intro__title {
    font-family: var(--font-display);
    font-size: min(13.2cqi, 7rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .intro__body {
    grid-column: 8 / -1;
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-3);
    max-width: 58ch;
    color: rgb(255 255 255 / 0.78);
  }

  .intro__lead {
    font-size: var(--type-lead);
    line-height: 1.4;
    color: var(--white);
  }

  @media (max-width: 1023px) {
    .intro__head,
    .intro__body {
      grid-column: 1 / -1;
    }
  }
</style>
