---
// Full-viewport Typeform "live embed", fixed behind the navbar like the live sign-up page.
// The form itself is hosted by Typeform; this only loads their public embed script.
export interface Props {
  /** Typeform live-embed id (`data-tf-live`). */
  liveId: string;
  /** Accessible name for the embed region. */
  label: string;
}

const { liveId, label } = Astro.props;
---

<div class="typeform-page">
  <div class="typeform-embed" role="region" aria-label={label} data-lenis-prevent>
    <div data-tf-live={liveId}></div>
  </div>
</div>
<script is:inline src="https://embed.typeform.com/next/embed.js" async></script>

<style>
  .typeform-page {
    position: relative;
    z-index: 5;
    min-height: 90dvh;
    background-color: var(--color-smoke-2);
  }

  .typeform-embed {
    position: fixed;
    inset: 0;
    z-index: 99;
    width: 100vw;
    height: 100vh;
  }
</style>
