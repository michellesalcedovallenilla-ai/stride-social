---
// Creator profile: the creator as a holographic card that leans towards the pointer, beside their
// biography and platforms in glass (talent/HoloProfile). Then the shared menu: Selected Work, More
// Creators. Built only for published creators (src/lib/roster.ts). No follower counts: the old figures
// are unverified.
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import HoloProfile from '@/components/talent/HoloProfile.astro';
import Deck from '@/components/experience/Deck.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { cleanBio, getRoster, platformNames, platformsOf } from '@/lib/roster';
import { routes } from '@/lib/routes';
import { isPreview } from '@/lib/env';
import { site } from '@/config/site';
import type { Card } from '@/lib/experience';
import Tray from '@/components/experience/Tray.astro';

export async function getStaticPaths() {
  const roster = await getRoster();
  return roster.map((creator) => ({ params: { slug: creator.id }, props: { creator, roster } }));
}

const { creator, roster } = Astro.props;
const at = roster.findIndex((c) => c.id === creator.id);
const neighbour = (by: number) => (roster.length > 1 ? routes.creator(roster[(at + by + roster.length) % roster.length].id) : undefined);
const d = creator.data;
const categories = Object.fromEntries((await getCollection('categories')).map((c) => [c.id, c.data.label]));
const mainCategory = d.mainCategory ? categories[d.mainCategory.id] : null;
const platforms = platformsOf(creator);
const bio = cleanBio(creator.body);
const work = (await getCollection('work', (w) => w.data.visible && w.data.creators.some((c) => c.id === creator.id))).sort((a, b) => a.data.order - b.data.order);
const related = roster.filter((c) => c.id !== creator.id && d.mainCategory && c.data.mainCategory?.id === d.mainCategory.id && c.data.portrait).slice(0, 8);
const country = d.country ? new Intl.DisplayNames(['en'], { type: 'region' }).of(d.country) : null;
const seoDescription = `${d.name}${mainCategory ? `, ${mainCategory.toLowerCase()} creator` : ''} represented by Stride Talent. Brands can enquire about collaborations.`;
const enquire = `Enquire about ${d.name}`;

const workCards: Card[] = work.map((w) => ({ name: w.data.title, text: w.data.summary, href: routes.caseStudy(w.id), image: w.data.card, direct: true }));
const relatedCards: Card[] = [
  ...related.map((c) => ({ name: c.data.name, text: mainCategory, href: routes.creator(c.id), image: c.data.portrait, direct: true })),
  ...(d.mainCategory ? [{ name: 'See all', text: mainCategory, href: routes.rosterFiltered(d.mainCategory.id), direct: true }] : []),
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      name: d.name,
      ...(d.portrait ? { image: new URL(d.portrait.src, site.url).href } : {}),
      sameAs: platforms.map((p) => p.href),
    },
  },
];
---

<SiteLayout title={`${d.name} | Stride Talent roster`} description={seoDescription} division="talent" ogImage={d.portrait?.src} ogType="profile" jsonLd={jsonLd} look="deep" headerOverlay>
  <HoloProfile
    creatorId={creator.id}
    prev={neighbour(-1)}
    next={neighbour(1)}
    name={d.name}
    portrait={d.portrait}
    label={[mainCategory ?? 'Creator', country].filter(Boolean).join(' · ')}
    bio={bio || undefined}
    fallback={`${d.name} is part of the Stride Talent roster.`}
    platforms={platforms.map((p) => ({ label: platformNames[p.key], href: p.href }))}
    enquire={{ label: enquire, href: routes.creatorEnquiry(creator.id) }}
    crumbs={[{ label: 'Stride Talent', href: '/talent' }, { label: 'Roster', href: '/talent/roster' }, { label: d.name }]}
  >
    {isPreview && d.consent.status !== 'confirmed' && <PlaceholderNotice label="Interim profile">— from the previous site; consent to be re-confirmed before launch</PlaceholderNotice>}
  </HoloProfile>

  {(workCards.length > 0 || relatedCards.length > 0) && (
    <Deck
      id="creator-menu"
      label={`More from ${d.name}`}
      tone="talent"
      look="deep"
      tabs={[
        { key: 'work', label: 'Selected Work', icon: 'play', cards: workCards },
        { key: 'more', label: mainCategory ? `More ${mainCategory}` : 'More Creators', icon: 'people', cards: relatedCards },
      ]}
      link={{ label: enquire, href: routes.creatorEnquiry(creator.id) }}
    />
  )}
  <Tray list="creators" side="left" />
</SiteLayout>
