---
import StrideMark from '../ui/StrideMark.astro';
import BackgroundVideo from '../ui/BackgroundVideo.astro';

export interface Props {
  title: string;
  badges?: { src: string; alt: string }[];
  video: { mp4: string; webm?: string; poster: string; mobile?: { mp4: string; webm?: string; poster: string } };
}

const { title, badges = [], video } = Astro.props;
---

<section class="hero-video">
  <div class="hero-video__content">
    <StrideMark class="hero-video__mark" />
    <h1 class="hero-video__title">{title}</h1>
    {badges.length > 0 && (
      <div class="hero-video__badges">
        {badges.map((b) => <img src={b.src} alt={b.alt} width="110" height="144" />)}
      </div>
    )}
  </div>
  <div class="hero-video__gradient"></div>
  <BackgroundVideo class="hero-video__video" {...video} />
</section>

<style>
  .hero-video {
    position: relative;
    z-index: 1;
    background-color: var(--color-navy);
  }

  .hero-video__content {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 0 2rem 1rem;
    text-align: center;
  }

  .hero-video__mark {
    width: 10vh;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .hero-video__title {
    max-width: 90%;
    font-family: var(--font-sans);
    font-size: 10vh;
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .hero-video__badges {
    height: 9rem;
  }

  .hero-video__badges img {
    width: auto;
    height: 100%;
    margin-top: 1rem;
  }

  .hero-video__gradient,
  .hero-video :global(.hero-video__video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin-top: 7.4em;
  }

  .hero-video__gradient {
    z-index: 1;
    background-image: linear-gradient(0deg, var(--color-navy), #fff0);
  }

  @media screen and (max-width: 991px) {
    .hero-video__title {
      max-width: 100%;
      font-size: 6vh;
    }
  }

  @media screen and (max-width: 767px) {
    .hero-video__content {
      justify-content: flex-end;
    }

    .hero-video__title {
      font-size: 5vh;
    }
  }

  @media screen and (max-width: 479px) {
    .hero-video__content {
      justify-content: center;
      padding: 0 1rem;
    }

    .hero-video__mark {
      width: 4rem;
    }

    .hero-video__title {
      font-size: 4vh;
    }

    .hero-video__badges {
      height: 7rem;
    }

    .hero-video__gradient,
    .hero-video :global(.hero-video__video) {
      margin-top: 6.1em;
    }
  }
</style>
