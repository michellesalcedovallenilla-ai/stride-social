---
// Our Team (brief §7: names, roles, genuine photographs and optional bios): a field of faces that swell
// as you pass (group/TeamField), then the way to the open roles.
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import TeamField from '@/components/group/TeamField.astro';
import EnquiryClose from '@/components/social/EnquiryClose.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { asHtml, paragraphs } from '@/lib/experience';
import { isPreview } from '@/lib/env';

const s = (await getEntry('pages', 'team'))?.data.sections;
if (!s) throw new Error('Missing src/content/pages/team.yaml');
const labels = { leadership: 'Leadership', talent: 'Talent', campaigns: 'Campaigns', social: 'Social media', sales: 'Sales', operations: 'Operations' } as const;
const team = (await getCollection('team', (m) => m.data.visible)).sort((a, b) => a.data.order - b.data.order);
const ordered = [...team.filter((m) => m.data.department === 'leadership'), ...team.filter((m) => m.data.department !== 'leadership')];
const ui = (key: string, fallback: string) => s.field?.items?.find((i) => i.key === key)?.label ?? fallback;
const people = ordered.map((m) => ({
  id: m.id,
  name: m.data.name,
  role: m.data.role,
  department: m.data.department,
  lead: m.data.department === 'leadership',
  photo: m.data.photo,
  photoAlt: m.data.photoAlt,
  card: {
    name: m.data.name,
    text: m.data.role,
    href: `#${m.id}`,
    image: m.data.photoAlt ?? m.data.photo,
    chips: [labels[m.data.department]],
    html: m.data.bio ? asHtml(paragraphs(m.data.bio)) : undefined,
    action: m.data.linkedin ? { label: 'LinkedIn', href: m.data.linkedin, external: true } : undefined,
  },
}));
const departments = (Object.keys(labels) as (keyof typeof labels)[]).filter((d) => team.some((m) => m.data.department === d)).map((id) => ({ id, label: labels[id] }));
---

<SiteLayout title="Our Team | Stride" description={s.hero.body} look="frost" headerOverlay>
  <TeamField
    copy={s.hero}
    people={people}
    departments={departments}
    crumbs={[{ label: 'About', href: '/about' }, { label: 'Our Team' }]}
    ui={{ all: ui('all', 'Everyone'), shuffle: ui('shuffle', 'Shuffle'), hint: s.field?.body ?? 'Move across the faces · click one to meet them' }}
  />
  {isPreview && <PlaceholderNotice variant="inline" label="Departments proposed">— derived from job titles; confirm (Gate 2)</PlaceholderNotice>}
  <EnquiryClose headline={s.join.headline ?? ''} label={s.join.cta?.label ?? ''} href={s.join.cta?.href} tone="group" look="navy" />
</SiteLayout>
