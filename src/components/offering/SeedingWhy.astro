---
// "Why you can't afford to ignore influencer seeding" — big light uppercase statement beside
// a list of sectors with ice-blue markers.
import MonoLabel from '@/components/ui/MonoLabel.astro';

export interface Props {
  label: string;
  /** Statement HTML (bold lead-in + line break, as on the live page). */
  html: string;
  sectors: string[];
}

const { label, html, sectors } = Astro.props;
---

<section class="seeding-why">
  <div class="seeding-why__inner">
    <MonoLabel tone="light">{label}</MonoLabel>
    <div class="seeding-why__grid">
      <div class="seeding-why__lead">
        <p class="seeding-why__text" data-split="letters-fade-in" set:html={html} />
      </div>
      <ul class="seeding-why__sectors">
        {sectors.map((s) => (
          <li class="seeding-why__sector">
            <span class="seeding-why__mark" aria-hidden="true"></span>
            {s}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .seeding-why {
    position: relative;
    z-index: 1;
    background-color: var(--color-smoke-2);
  }

  .seeding-why__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: var(--container-wide);
    margin-inline: auto;
    /* bottom = 6rem + the 3rem gap the live page keeps for its (collapsed) image row */
    padding: 3rem 45px 9rem;
  }

  .seeding-why__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-items: start;
    gap: 16px;
    width: 100%;
  }

  .seeding-why__text {
    font-family: var(--font-sans);
    font-size: 3.3em;
    font-weight: 200;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .seeding-why__text :global(strong) {
    font-weight: 700;
  }

  .seeding-why__sectors {
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .seeding-why__sector {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 2rem 0;
    border-top: 1px solid var(--color-navy-20);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    line-height: 20px;
    color: var(--color-navy-mute);
  }

  .seeding-why__mark {
    flex: none;
    width: 12px;
    height: 12px;
    background-color: var(--accent);
  }

  @media screen and (max-width: 991px) {
    .seeding-why__lead {
      font-size: 12px;
    }
  }

  @media screen and (max-width: 767px) {
    .seeding-why__inner {
      padding-bottom: 10rem;
    }
  }

  @media screen and (max-width: 479px) {
    .seeding-why__inner {
      padding: 3rem 20px 12rem;
    }

    .seeding-why__grid {
      grid-template-columns: 1fr;
    }

    .seeding-why__text {
      font-size: 25px;
    }

    .seeding-why__sector {
      gap: 10px;
      font-size: 0.8rem;
    }
  }
</style>
