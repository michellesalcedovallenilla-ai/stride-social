---
// Our History: a road you travel sideways. Scrolling (or dragging) carries you along a line of glass
// panels, one per milestone, each leaning with your speed while its huge year drifts behind it at its own
// pace; the panel you're at lights up, and the years along the foot take you straight there. Behaviour:
// src/scripts/system/history-road.ts. Below desktop or with reduced motion it's a plain vertical story.
// Only verified milestones in production; preview also shows the previous site's, until Stride confirms.
import Breadcrumbs from '../global/Breadcrumbs.astro';
import { interfaceCopy } from '@/lib/ui-copy';

export interface Props {
  copy: { eyebrow?: string; headline?: string; body?: string };
  milestones: { id: string; year: number; title: string; body: string[]; image?: { src: string; alt: string } | null }[];
  crumbs: { label: string; href?: string }[];
  next: { label: string; copy?: string; href: string }[];
  hint: string;
}

const { copy, milestones, crumbs, next, hint } = Astro.props;
const t = await interfaceCopy();
---

<section class="road" aria-labelledby="road-title" data-road data-tone="group" data-look="deep" data-to="frost">
  <div class="road__pin" data-road-pin>
    <span class="road__fade" aria-hidden="true" data-backdrop></span>
    <ol class="road__track" role="list" data-road-track>
      <li class="road__start" data-road-panel>
        <Breadcrumbs items={crumbs} tone="dark" />
        {copy.eyebrow && <p class="exp-label">{copy.eyebrow}</p>}
        <h1 class="road__title exp-title" id="road-title" data-reveal-lines="load">{copy.headline}</h1>
        {copy.body && <p class="road__lede">{copy.body}</p>}
        <slot />
        {milestones.length > 0 && <p class="road__hint exp-label" aria-hidden="true">{hint} →</p>}
      </li>

      {milestones.map((m) => {
        const size = m.body.join('').length;
        return (
          <li class="stop" data-road-panel data-road-stop={m.id} style={`--w: ${size > 700 ? '46rem' : size > 380 ? '38rem' : '30rem'}`}>
            <p class="stop__year" aria-hidden="true">{m.year}</p>
            <article class="stop__card glass">
              <p class="exp-label stop__when">{m.year}</p>
              <h2 class="stop__name exp-title">{m.title}</h2>
              {m.image && <img class="stop__image" src={m.image.src} alt={m.image.alt} sizes="600px" loading="lazy" decoding="async" draggable="false" />}
              {m.body.map((p) => <p class="stop__text">{p}</p>)}
            </article>
          </li>
        );
      })}

      <li class="road__end" data-road-panel>
        <ul class="road__next" role="list">
          {next.map((n) => (
            <li>
              <a class="road__link glass" href={n.href}>
                <span class="road__link-name exp-title">{n.label}</span>
                {n.copy && <span class="road__link-copy">{n.copy}</span>}
                <span class="exp-round" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg></span>
              </a>
            </li>
          ))}
        </ul>
      </li>
    </ol>

    {milestones.length > 0 && (
      <nav class="road__years glass" aria-label="Jump to a year">
        <span class="road__progress" aria-hidden="true"></span>
        <button class="road__play" type="button" aria-pressed="false" aria-label={t('play.play')} data-play={t('play.play')} data-pause={t('play.pause')} data-road-play><svg class="play-on" viewBox="0 0 16 16" aria-hidden="true" style="fill: currentColor; stroke: none"><path d="M4 2l10 6-10 6z"></path></svg><svg class="play-off" viewBox="0 0 16 16" aria-hidden="true" style="fill: currentColor; stroke: none"><path d="M4 2h3v12H4zM9 2h3v12H9z"></path></svg></button>
        {milestones.map((m) => <a class="road__jump" href={`#${m.id}`} data-road-jump={m.id}>{m.year}</a>)}
      </nav>
    )}
  </div>
</section>

<style>
  /* ---------- A plain story until the script takes over ---------- */
  .road {
    position: relative;
    color: rgb(var(--ink));
  }

  .road__pin {
    position: relative;
    padding: calc(var(--header-h) + var(--space-4)) var(--margin) var(--space-7);
    overflow: clip;
  }

  .road__fade {
    display: none;
  }

  .road__track {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-6);
  }

  .road__start {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .road__title {
    font-size: clamp(3rem, 9vw, 9rem);
  }

  .road__lede {
    max-width: 34rem;
    font-size: var(--type-lead);
    line-height: 1.36;
    color: rgb(var(--ink) / 0.88);
  }

  .road__hint {
    color: rgb(var(--tone-lit));
  }

  .stop {
    position: relative;
  }

  .stop__year {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
    font-family: var(--font-display);
    font-size: clamp(9rem, 26vw, 26rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(var(--tone-lit) / 0.42);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .stop__card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: clamp(22px, 2.4vw, 38px);
    transition: box-shadow 400ms var(--ease-out);
  }

  .stop.is-here .stop__card {
    box-shadow:
      inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.95),
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 0 40px -6px rgb(var(--tone-glow) / 0.65),
      0 30px 60px -30px rgb(var(--shade) / 0.8);
  }

  .stop__when {
    color: rgb(var(--tone-lit));
  }

  .stop__name {
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    line-height: 0.98;
  }

  .stop__image {
    width: 100%;
    max-height: 30svh;
    border-radius: 16px;
    object-fit: cover;
  }

  .stop__text {
    color: rgb(var(--ink) / 0.88);
    text-shadow: 0 1px 12px rgb(var(--halo) / 0.6);
  }

  .road__next {
    display: grid;
    gap: clamp(10px, 1vw, 16px);
  }

  .road__link {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: clamp(18px, 1.8vw, 28px);
    padding-right: 84px;
    color: rgb(var(--ink));
    transition:
      translate 400ms var(--ease-out),
      box-shadow 400ms var(--ease-out);
  }

  .road__link:hover,
  .road__link:focus-visible {
    translate: 0 -4px;
    outline: none;
    box-shadow:
      inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.95),
      0 0 30px -4px rgb(var(--tone-glow) / 0.6);
  }

  .road__link .exp-round {
    position: absolute;
    top: 50%;
    right: 20px;
    margin-top: -23px;
  }

  .road__link-name {
    font-size: clamp(1.375rem, 2.2vw, 2.25rem);
  }

  .road__link-copy {
    font-size: 0.9375rem;
    color: rgb(var(--ink) / 0.84);
  }

  .road__years {
    display: none;
  }

  /* ---------- The road itself ---------- */
  .road.is-live .road__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 620px;
    padding: 0;
    cursor: grab;
    user-select: none;
    touch-action: pan-y;
  }

  .road.is-dragging .road__pin {
    cursor: grabbing;
  }

  /* Panels fade out before they reach the wheel at the left. */
  .road.is-live .road__fade {
    display: block;
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 2;
    width: calc(var(--margin) + 11vw);
    background: linear-gradient(to right, rgb(var(--backdrop, var(--tone-surface))) 34%, rgb(var(--backdrop, var(--tone-surface)) / 0.82) 50%, rgb(var(--backdrop, var(--tone-surface)) / 0.42) 70%, rgb(var(--backdrop, var(--tone-surface)) / 0.12) 88%, transparent);
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  .road.is-live .road__track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: clamp(90px, 14vw, 240px);
    width: max-content;
    padding: calc(var(--header-h) + var(--space-2)) 22vw 84px var(--margin);
    will-change: transform;
  }

  .road.is-live .road__start {
    flex: none;
    width: min(46vw, 44rem);
  }

  .road.is-live .road__title {
    font-size: clamp(3rem, 7.4vw, 8rem);
  }

  .road.is-live .stop {
    flex: none;
    width: var(--w);
    max-width: 62vw;
  }

  /* Leaning with the speed of travel; the one you're at comes forward. These panels never stop moving, so
     live blur would be recalculated every frame: over plain navy a matching fill looks the same, and stays smooth. */
  .road.is-live .stop__card,
  .road.is-live .road__link {
    background:
      linear-gradient(165deg, rgb(255 255 255 / calc(0.16 * var(--fill-k))), rgb(255 255 255 / calc(0.07 * var(--fill-k))) 42%, rgb(255 255 255 / calc(0.04 * var(--fill-k))) 62%, rgb(255 255 255 / calc(0.09 * var(--fill-k)))),
      rgb(var(--panel) / 0.86);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .road.is-live .stop__card {
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  .road.is-live .stop__year {
    will-change: transform;
  }

  .road.is-live .road__end {
    flex: none;
    width: min(32rem, 44vw);
  }

  .road.is-live .road__years {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    z-index: 3;
    display: flex;
    gap: 2px;
    padding: 5px;
    overflow: hidden;
    border-radius: 999px;
    transform: translateX(-50%);
  }

  .road__progress {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: rgb(var(--tone-lit));
    box-shadow: 0 0 10px rgb(var(--tone-glow));
    transform: scaleX(0);
    transform-origin: left;
  }

  .road__jump {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding-inline: var(--space-4);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.08em;
    color: rgb(var(--ink) / 0.72);
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }

  .road__jump:hover {
    color: rgb(var(--ink));
  }

  .road__jump.is-here {
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .road__jump:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .road__play {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: rgb(var(--ink));
    transition: background-color 300ms var(--ease-out);
  }

  .road__play:hover {
    background: rgb(var(--hair) / 0.14);
  }

  .road__play:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .road__play svg {
    width: 12px;
    height: 12px;
  }
</style>

<script>
  import { initHistoryRoads } from '@/scripts/system/history-road';
  initHistoryRoads();
</script>
