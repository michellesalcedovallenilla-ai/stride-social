---
import MonoLabel from '../../ui/MonoLabel.astro';
import Button from '../../ui/Button.astro';

export interface Props {
  label: string;
  heading: string;
  body: string;
  cta: { label: string; href: string };
}

const { label, heading, body, cta } = Astro.props;
---

<div class="statement container-wide">
  <MonoLabel tone="light">{label}</MonoLabel>
  <div class="statement__heading-wrap">
    <h2 class="statement__heading" data-split="letters-slide-up">{heading}</h2>
  </div>
  <div class="statement__grid">
    <p class="statement__body" data-split="letters-fade-in">{body}</p>
  </div>
</div>
<div class="statement__mobile-cta">
  <Button href={cta.href}>{cta.label}</Button>
</div>

<style>
  .statement {
    display: flex;
    flex-direction: column;
    gap: 5em;
    padding-top: 12em;
    padding-bottom: 12em;
  }

  .statement__heading-wrap {
    display: flex;
    width: 90%;
    padding-top: 1em;
    overflow: hidden;
  }

  .statement__heading {
    font-family: var(--font-sans);
    font-size: 6.8rem;
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .statement__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .statement__body {
    font-family: var(--font-sans);
    font-size: 3.3em;
    font-weight: 200;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .statement__mobile-cta {
    display: none;
  }

  @media screen and (max-width: 991px) {
    .statement__heading-wrap {
      text-align: center;
    }

    .statement__heading {
      text-align: left;
      font-size: 5rem;
    }

    .statement__body {
      font-size: 39.6px;
    }

    .statement__mobile-cta {
      position: sticky;
      top: 85%;
      z-index: 99;
      display: flex;
      justify-content: center;
      padding-bottom: 2rem;
    }
  }

  @media screen and (max-width: 767px) {
    .statement__heading {
      font-size: 3.8rem;
    }
  }

  @media screen and (max-width: 479px) {
    .statement {
      gap: 4em;
      padding-top: 30px;
      padding-bottom: 30px;
    }

    .statement__heading-wrap {
      flex-direction: column;
      padding-top: 5px;
    }

    .statement__heading {
      font-size: 11vw;
    }

    .statement__body {
      grid-column: 1 / -1;
      font-size: 25px;
    }

    .statement__mobile-cta {
      top: 88%;
    }
  }
</style>
