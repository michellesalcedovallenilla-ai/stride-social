---
// Stride Social B6 "Featured campaigns": full-width spreads, deliberately different from the
// homepage mosaic. Large image on one side (alternating), summary on the other: client, the
// brief in a line, verified results as large figures, services. Data: work with
// featuredOn: social, in featuredOrder. Unverified figures never render; preview builds say so.
import { getCollection, getEntries, getEntry } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import Button from '../core/Button.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { routes } from '@/lib/routes';
import { isPreview } from '@/lib/env';

export interface Props {
  copy: { eyebrow?: string; headline?: string; cta?: { label: string; href: string } };
}

const { copy } = Astro.props;
const featured = (await getCollection('work', (w) => w.data.visible && w.data.featuredOn.includes('social'))).sort(
  (a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99),
);
const spreads = await Promise.all(
  featured.map(async (w) => {
    const client = await getEntry(w.data.client);
    const services = await getEntries(w.data.services);
    const industries = await getEntries(w.data.industries);
    return {
      id: w.id,
      client: client?.data.name ?? w.data.title,
      summary: w.data.summary,
      image: w.data.hero ?? w.data.card,
      services: services.map((s) => ({ name: s.data.name, href: routes.service(s.id) })),
      industries: industries.map((i) => i.data.label),
      verified: w.data.results.filter((r) => r.status === 'verified'),
      pending: w.data.results.filter((r) => r.status !== 'verified').length,
    };
  }),
);
---

{spreads.length > 0 && (
  <section class="spreads" aria-labelledby="spreads-title">
    <header class="spreads__head container-wide">
      <div>
        <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
        <h2 class="spreads__title" id="spreads-title" data-reveal-lines>{copy.headline}</h2>
      </div>
      {copy.cta && <Button href={copy.cta.href} variant="text" tone="dark">{copy.cta.label}</Button>}
    </header>

    <div class="spreads__list container-wide">
      {spreads.map((s, i) => (
        <article class:list={['spread', { 'spread--flip': i % 2 === 1 }]} aria-labelledby={`spread-${s.id}`}>
          <a class="spread__media" href={routes.caseStudy(s.id)} tabindex="-1" aria-hidden="true" data-reveal="rise">
            <img src={s.image.src} alt="" loading="lazy" decoding="async" />
          </a>
          <div class="spread__body" data-reveal="rise" style="--reveal-delay: 0.1s">
            <p class="spread__index">{String(i + 1).padStart(2, '0')} / {String(spreads.length).padStart(2, '0')}</p>
            <h3 class="spread__client" id={`spread-${s.id}`}>{s.client}</h3>
            <p class="spread__summary">{s.summary}</p>

            {s.verified.length > 0 && (
              <dl class="spread__results">
                {s.verified.slice(0, 3).map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>{r.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {isPreview && s.verified.length === 0 && (
              <PlaceholderNotice variant="inline" label="Results awaiting verification">
                {s.pending ? `— ${s.pending} figure${s.pending === 1 ? '' : 's'} from the previous site to confirm (Q6)` : '— no figures supplied yet (Q6)'}
              </PlaceholderNotice>
            )}

            <dl class="spread__facts">
              {s.services.length > 0 && (
                <div>
                  <dt>Services</dt>
                  <dd>{s.services.map((sv, j) => <>{j > 0 && ', '}<a href={sv.href}>{sv.name}</a></>)}</dd>
                </div>
              )}
              {s.industries.length > 0 && (
                <div>
                  <dt>Industry</dt>
                  <dd>{s.industries.join(', ')}</dd>
                </div>
              )}
            </dl>
            <Button href={routes.caseStudy(s.id)} variant="secondary" tone="dark" aria-label={`View the ${s.client} case study`}>View case study</Button>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .spreads {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--navy-900);
    color: var(--white);
  }

  .spreads__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-8);
  }

  .spreads__head > div {
    display: grid;
    gap: var(--space-4);
  }

  .spreads__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .spreads__list {
    display: grid;
    gap: clamp(64px, 8vw, 128px);
  }

  .spread {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--gutter);
    align-items: center;
  }

  .spread__media {
    position: relative;
    grid-column: 1 / 9;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--navy-700);
  }

  .spread__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .spread:hover .spread__media img {
    transform: scale(1.03);
  }

  .spread__body {
    grid-column: 9 / -1;
    container-type: inline-size;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .spread--flip .spread__media {
    grid-column: 5 / -1;
    grid-row: 1;
  }

  .spread--flip .spread__body {
    grid-column: 1 / 5;
    grid-row: 1;
  }

  .spread__index {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  /* Sized to the column so long client names stay on one line. */
  .spread__client {
    font-family: var(--font-display);
    font-size: min(14cqi, 5.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .spread__summary {
    color: rgb(255 255 255 / 0.82);
  }

  .spread__results {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
  }

  .spread__results dd {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
    color: var(--accent);
  }

  .spread__results dt,
  .spread__facts dt {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .spread__facts {
    display: grid;
    gap: var(--space-3);
    width: 100%;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-dark);
  }

  .spread__facts dd {
    font-size: var(--type-small);
  }

  .spread__facts a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .spread__media,
    .spread__body,
    .spread--flip .spread__media,
    .spread--flip .spread__body {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
