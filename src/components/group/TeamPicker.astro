---
// "Don't see your role?": pick the team you'd fit, and its people slide in while the email to the careers
// inbox is addressed for you, with that team in the subject. Only real teams, real faces and real counts,
// from the team collection.
import { pad } from '@/lib/experience';

export interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  email: string;
  teams: { id: string; label: string; count: number; faces: { src: string; alt: string }[] }[];
  pick: string;
  send: string;
}

const { eyebrow, headline, body, email, teams, pick, send } = Astro.props;
const subject = (team?: string) => `mailto:${email}?subject=${encodeURIComponent(team ? `Application: ${team} team` : 'Application')}`;
---

<section class="picker" aria-labelledby="picker-title" data-picker data-tone="group" data-look="frost">
  <div class="picker__inner container-wide">
    <div class="picker__lead">
      {eyebrow && <p class="exp-label">{eyebrow}</p>}
      <h2 class="picker__title exp-title" id="picker-title">{headline}</h2>
      {body && <p class="picker__body">{body}</p>}
    </div>

    <div class="picker__board glass">
      <p class="exp-label">{pick}</p>
      <div class="picker__teams" role="group" aria-label={pick}>
        {teams.map((t, i) => (
          <button class="picker__team" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-picker-team={t.id} data-href={subject(t.label)}>
            <span class="picker__team-n" aria-hidden="true">{pad(t.count)}</span>
            {t.label}
          </button>
        ))}
      </div>

      <div class="picker__stage">
        {teams.map((t, i) => (
          <ul class:list={['picker__faces', { 'is-active': i === 0 }]} role="list" aria-hidden={i === 0 ? undefined : 'true'} data-picker-faces={t.id}>
            {t.faces.map((f, k) => (
              <li style={`--k: ${k}`}><img src={f.src} alt={f.alt} sizes="120px" loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        ))}
      </div>

      <a class="exp-pill" href={subject(teams[0]?.label)} data-picker-send>
        {send}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .picker {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-8);
    overflow: clip;
    background: radial-gradient(70% 28% at 50% 72%, rgb(var(--tone-wash) / 0.2), transparent);
    color: rgb(var(--ink));
  }

  .picker__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-6) var(--gutter);
    align-items: center;
    width: 100%;
  }

  .picker__lead {
    display: grid;
    gap: var(--space-4);
    container-type: inline-size;
  }

  .picker__title {
    font-size: clamp(2.25rem, 13cqi, 5rem);
  }

  .picker__body {
    max-width: 30rem;
    font-size: var(--type-lead);
    line-height: 1.36;
    color: rgb(var(--ink) / 0.88);
  }

  .picker__board {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: clamp(20px, 2.4vw, 36px);
  }

  .picker__teams {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .picker__team {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(var(--hair) / 0.26);
    font-weight: 600;
    color: rgb(var(--ink));
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }

  .picker__team:hover {
    background: rgb(255 255 255 / calc(0.08 * var(--fill-k)));
  }

  .picker__team[aria-pressed='true'] {
    background: rgb(var(--tone-lit));
    color: rgb(var(--tone-on));
  }

  .picker__team:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 2px;
  }

  .picker__team-n {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    opacity: 0.7;
  }

  .picker__stage {
    display: grid;
    width: 100%;
    min-height: clamp(120px, 11vw, 170px);
  }

  .picker__faces {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    padding-left: 18px;
    visibility: hidden;
  }

  .picker__faces li {
    flex: 0 1 clamp(84px, 8.4vw, 124px);
    min-width: 0;
    aspect-ratio: 4 / 5;
    margin-left: -18px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--navy-700);
    box-shadow:
      0 0 0 2px rgb(var(--tone-surface)),
      0 14px 26px -14px rgb(var(--shade) / 0.8);
    opacity: 0;
    transform: translateY(26px) rotate(calc((var(--k) - 4) * 1.4deg)) scale(0.86);
  }

  .picker__faces img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .picker__faces.is-active {
    visibility: visible;
  }

  .picker__faces.is-active li {
    opacity: 1;
    transform: rotate(calc((var(--k) - 4) * 1.4deg));
    transition:
      opacity 340ms var(--ease-out) calc(var(--k) * 38ms),
      transform 620ms cubic-bezier(0.2, 1.4, 0.35, 1) calc(var(--k) * 38ms);
  }

  .picker__faces.is-active li:hover {
    z-index: 2;
    transform: translateY(-8px) scale(1.12);
  }

  @media (max-width: 1023px) {
    .picker__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .picker__faces.is-active li {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const teams = [...root.querySelectorAll<HTMLButtonElement>('[data-picker-team]')];
    const faces = [...root.querySelectorAll<HTMLElement>('[data-picker-faces]')];
    const send = root.querySelector<HTMLAnchorElement>('[data-picker-send]');
    const choose = (i: number) => {
      teams.forEach((t, k) => t.setAttribute('aria-pressed', String(k === i)));
      faces.forEach((f, k) => {
        f.classList.toggle('is-active', k === i);
        if (k === i) f.removeAttribute('aria-hidden');
        else f.setAttribute('aria-hidden', 'true');
      });
      if (send && teams[i].dataset.href) send.href = teams[i].dataset.href;
    };
    teams.forEach((t, i) => t.addEventListener('click', () => choose(i)));
  });
</script>
