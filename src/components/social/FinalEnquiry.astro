---
// Stride Social B8: ice closing section, "YOUR NEXT CAMPAIGN STARTS HERE.", with the button
// "Talk To Stride Social" leading straight into the inline brand enquiry form below it. The same
// form also lives on its own at /social/enquire.
import Button from '../core/Button.astro';
import DraftTag from '../core/DraftTag.astro';
import EnquiryForm from './EnquiryForm.astro';

export interface Props {
  copy: { headline?: string; cta?: { label: string; href: string } };
  form: { status: 'approved' | 'draft'; body?: string; items?: { key?: string; label: string }[] };
}

const { copy, form } = Astro.props;
const msg = (key: string) => form.items?.find((i) => i.key === key)?.label ?? '';
---

<section class="final-enq" aria-labelledby="final-enq-title">
  <div class="final-enq__inner container-wide">
    <div class="final-enq__lead">
      <h2 class="final-enq__title" id="final-enq-title" data-reveal-lines>{copy.headline}</h2>
      {copy.cta && <Button href="#enquire" tone="light" arrow>{copy.cta.label}</Button>}
    </div>
    <div class="final-enq__form" id="enquire">
      <DraftTag status={form.status} />
      {form.body && <p class="final-enq__body">{form.body}</p>}
      <EnquiryForm messages={{ success: msg('success'), error: msg('error'), unavailable: msg('unavailable'), consent: msg('consent') }} />
    </div>
  </div>
</section>

<style>
  .final-enq {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--ice);
    color: var(--navy-900);
  }

  .final-enq__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8) var(--gutter);
    align-items: start;
  }

  .final-enq__lead {
    grid-column: 1 / 7;
    display: grid;
    gap: var(--space-7);
    justify-items: start;
    position: sticky;
    top: calc(var(--header-h) + var(--division-bar-h) + var(--space-6));
  }

  .final-enq__title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6.4vw, 7rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.88;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .final-enq__form {
    grid-column: 8 / -1;
    min-width: 0;
    display: grid;
    gap: var(--space-5);
    scroll-margin-top: calc(var(--header-h) + var(--division-bar-h) + var(--space-5));
  }

  .final-enq__body {
    font-size: var(--type-lead);
    line-height: 1.4;
  }

  @media (max-width: 1023px) {
    .final-enq__lead,
    .final-enq__form {
      grid-column: 1 / -1;
    }

    .final-enq__lead {
      position: static;
    }
  }

  @media (max-width: 479px) {
    .final-enq__title {
      font-size: 10.4vw;
      font-stretch: 112%;
    }
  }
</style>
