---
// "More campaigns" row at the end of a case study: three case study cards.
import TalentCard from '@/components/cards/TalentCard.astro';
import CardGrid from './CardGrid.astro';

export interface Props {
  heading?: string;
  items: { href: string; image: string; name: string; tag?: string | null; metric?: string | null }[];
}

const { heading = 'more campaigns', items } = Astro.props;
---

<section class="more-campaigns">
  <h2 class="more-campaigns__title">{heading}</h2>
  <CardGrid layout="three" label={heading}>
    {items.map((item) => (
      <li>
        <TalentCard
          href={item.href}
          image={item.image}
          name={item.name}
          tag={item.tag}
          metric={item.metric}
          metricLabel={item.metric ? 'views' : undefined}
          headingLevel="h3"
        />
      </li>
    ))}
  </CardGrid>
</section>

<style>
  .more-campaigns {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 6rem 45px;
    background-color: var(--color-smoke-2);
  }

  .more-campaigns__title {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 6rem;
    font-weight: 900;
    line-height: 1.45;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  @media screen and (max-width: 991px) {
    .more-campaigns__title {
      font-size: 5rem;
      line-height: 1;
    }
  }

  @media screen and (max-width: 767px) {
    .more-campaigns {
      padding-left: 25px;
      padding-right: 25px;
    }
  }

  @media screen and (max-width: 479px) {
    .more-campaigns__title {
      font-size: 3.4rem;
    }
  }
</style>
