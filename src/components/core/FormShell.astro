---
// Shared frame for the site's forms (docs/phase-2/07-technical-architecture.md §6): the native
// form, spam fields (honeypot + time-to-submit, re-checked on the server), consent line, submit
// button, status line, error alert with an email fallback, and the "unavailable" and success
// panels. Fields go in the default slot; extra success content in the "done" slot.
// Behaviour: src/scripts/system/form.ts. Until a destination is configured the form says so
// instead of failing silently: with JS it shows the "email us" panel, without JS it opens the
// visitor's mail app.
import Button from './Button.astro';
import PlaceholderNotice from './PlaceholderNotice.astro';

export interface Props {
  /** Where the form posts; empty until Stride confirms the destination (Q13). */
  action: string;
  /** Fallback inbox shown when sending fails or no destination is set. */
  email: string;
  subject: string;
  submitLabel: string;
  messages: { success: string; error: string; unavailable: string; consent: string };
  /** Creator ids → names, so a prefilled ?creator= can be shown by name. */
  names?: Record<string, string>;
  tone?: 'light' | 'dark';
  class?: string;
}

const { action, email, subject, submitLabel, messages, names, tone = 'light', class: className } = Astro.props;
const configured = action !== '';
const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
const [consentBefore, consentAfter] = messages.consent.split('privacy policy');
---

<div class:list={['form', `form--on-${tone}`, className]} data-form>
  <form
    class="form__form"
    action={configured ? action : `mailto:${email}`}
    method="post"
    enctype={configured ? undefined : 'text/plain'}
    novalidate
    data-configured={configured ? 'true' : 'false'}
    data-success={messages.success}
    data-names={names ? JSON.stringify(names) : undefined}
  >
    {!configured && (
      <PlaceholderNotice variant="inline" label="Form destination not set">— submissions can't be received until Stride confirms where they go (Q13)</PlaceholderNotice>
    )}

    <slot />

    {/* Spam protection: a field people never see, and the time the page loaded. */}
    <div class="form__hp" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <input type="hidden" name="started" value="" />

    <p class="form__consent">
      {consentBefore}{consentAfter !== undefined && <><a href="/privacy">privacy policy</a>{consentAfter}</>}
    </p>

    <div class="form__actions">
      <Button type="submit" tone={tone} class="form__submit">{submitLabel}</Button>
      <p class="form__status" role="status" aria-live="polite" data-status></p>
    </div>

    <div class="form__alert" role="alert" hidden data-error>
      <p>{messages.error}</p>
      <p><a href={mailto}>{email}</a></p>
    </div>
  </form>

  <div class="form__panel" hidden data-unavailable tabindex="-1">
    <p class="form__panel-title">{messages.unavailable}</p>
    <Button href={mailto} tone={tone}>{email}</Button>
  </div>

  <div class="form__panel" hidden data-done tabindex="-1">
    <svg class="form__tick" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m14 25 7 7 13-15" fill="none" stroke="currentColor" stroke-width="2.5"></path></svg>
    <p class="form__panel-title" data-done-message></p>
    <slot name="done" />
  </div>
</div>

<style>
  .form {
    display: grid;
  }

  .form__form {
    display: grid;
    gap: var(--space-6);
  }

  .form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__consent {
    max-width: 60ch;
    font-size: var(--type-small);
  }

  .form__consent a,
  .form__alert a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .form__status {
    font-size: var(--type-small);
    font-weight: 500;
  }

  .form__alert {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid #b42318;
    background: rgb(180 35 24 / 0.08);
    font-weight: 500;
  }

  .form__form[hidden],
  .form__alert[hidden],
  .form__panel[hidden] {
    display: none;
  }

  .form__panel {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding: var(--space-7) 0;
    outline: none;
  }

  .form__panel-title {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 3rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 1;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .form__tick {
    width: 48px;
  }

  .form--on-dark .form__alert {
    border-color: #ffb4a9;
    background: rgb(255 180 169 / 0.1);
  }

  .form.is-sending :global(.form__submit) {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .form__actions :global(.form__submit) {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  import { initForms } from '@/scripts/system/form';
  initForms();
</script>
