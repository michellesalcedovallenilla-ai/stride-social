---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarqueeHero from '@/components/sections/MarqueeHero.astro';
import LogoTicker from '@/components/sections/LogoTicker.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import StoryLayout from '@/components/offering/StoryLayout.astro';
import StrategyTabs from '@/components/offering/StrategyTabs.astro';
import CaseGrid from '@/components/offering/CaseGrid.astro';
import LiveCampaigns from '@/components/offering/LiveCampaigns.astro';
import { footerCtas } from '@/config/site';
import strategies from '@/data/offering-strategies.json';
// WebPage structured data kept as on the live page (logo points at the migrated copy).
import jsonLd from '@/data/offering-strategies-jsonld.json';
---

<BaseLayout
  title="Influencer Strategies"
  description="We provide a range or services and strategies from social media marketing, talent management and google media buying and ads. find out more about our services here"
  nav="transparent"
  footerCta={footerCtas.strategies}
  jsonLd={jsonLd}
>
  <MarqueeHero tone="dark" title="Influencer Strategies" intro={strategies.hero.intro} compact />

  <StoryLayout image={strategies.image} media="light" card="wide" columns="list-wide" tightList>
    <StrategyTabs tabs={strategies.tabs} />
  </StoryLayout>

  <LogoTicker />

  <CaseGrid items={strategies.caseGrid} />

  <LiveCampaigns heading="Our Live Campaigns" />

  <Testimonials />
</BaseLayout>
