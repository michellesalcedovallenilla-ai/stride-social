---
// "Recent works": sticky full-screen track that scrolls flip cards horizontally on desktop
// and stacks them on tablet/mobile. Hovering a card flips it to show the case study blurb.
import Button from '../../ui/Button.astro';

export interface Props {
  heading: string;
  cta: { label: string; href: string };
  items: { href: string; title: string; blurb: string; front: string; back: string }[];
}

const { heading, cta, items } = Astro.props;
---

<section class="works" data-horizontal-track data-end="0.77" aria-label={heading}>
  <div class="works__sticky">
    <div class="works__heading" aria-hidden="true"><div>{heading}</div></div>
    <h2 class="visually-hidden">{heading}</h2>
    <div class="works__cta">
      <Button href={cta.href}>{cta.label}</Button>
    </div>
    <div class="works__rail" data-horizontal-rail>
      {items.map((item) => (
        <div class="cube">
          <a class="cube__body" href={item.href} aria-label={item.title}>
            <div class="cube__front">
              <img class="cover-image" src={item.front} alt="" loading="lazy" />
            </div>
            <div class="cube__side cube__side--left"></div>
            <div class="cube__back">
              <div class="cube__back-face">
                <div class="cube__info">
                  <div class="cube__info-inner">
                    <div class="cube__title">{item.title}</div>
                    <p class="cube__blurb">{item.blurb}</p>
                  </div>
                </div>
                <img class="cover-image" src={item.back} alt="" loading="lazy" />
              </div>
            </div>
            <div class="cube__side cube__side--right"></div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .works {
    --horizontal-enabled: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 180vw;
    background-color: var(--color-smoke);
  }

  .works__sticky {
    position: sticky;
    top: 0;
    overflow: hidden;
  }

  .works__heading {
    position: absolute;
    inset: 0 auto auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-navy);
  }

  .works__heading > div {
    font-family: var(--font-sans);
    font-size: 9em;
    font-weight: 900;
    line-height: 0.8;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .works__cta {
    position: absolute;
    inset: auto 0 6%;
    z-index: 5;
    display: flex;
    justify-content: center;
  }

  .works__rail {
    display: flex;
    width: 300vw;
    height: 100vh;
    will-change: transform;
  }

  /* Flip card ("cube") */
  .cube {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    perspective: 125em;
  }

  .cube__body {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #d13b3b;
    transform-style: preserve-3d;
    transition: transform 0.9s var(--ease-out);
  }

  .cube:hover .cube__body,
  .cube__body:focus-visible {
    transform: rotateY(180deg) translateZ(2em);
  }

  .cube__front {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .cube__side {
    position: absolute;
    top: 0;
    z-index: 3;
    width: 2em;
    height: 100%;
    transform-style: preserve-3d;
  }

  .cube__side--left {
    left: 0;
    transform-origin: 0%;
    transform: rotateY(90deg);
    background-color: var(--accent);
    background-image: radial-gradient(circle, #b8b8b800 23%, #27272733);
  }

  .cube__side--right {
    right: 0;
    transform-origin: 100%;
    transform: rotateY(-90deg);
    background-color: #707070;
  }

  .cube__back {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: translate3d(0, 0, -2em);
  }

  .cube__back-face {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateY(180deg);
  }

  .cube__info {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 24px 32px 20px;
    background-color: #06142bbf;
  }

  .cube__info-inner {
    display: flex;
    flex-direction: column;
    gap: 25px;
    max-width: 20vw;
  }

  .cube__title {
    font-family: var(--font-sans);
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .cube__blurb {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 1.5;
    text-align: center;
    color: #fff9;
  }

  @media screen and (max-width: 991px) {
    .works {
      --horizontal-enabled: 0;
      height: auto;
    }

    .works__sticky {
      position: relative;
      display: flex;
      flex: 1;
      flex-direction: column;
      align-items: flex-start;
    }

    .works__heading > div {
      font-size: 60px;
    }

    .works__cta {
      display: none;
    }

    .works__rail {
      flex-direction: column;
      width: 100%;
      height: auto;
      border: 3px solid #000;
      transform: none !important;
    }

    .cube {
      flex: 0 auto;
      height: 45em;
    }

    .cube__title {
      font-size: 3.3rem;
    }

    .cube__info-inner {
      max-width: 60vw;
    }
  }

  @media screen and (max-width: 767px) {
    .cube__title {
      font-size: 2.8rem;
    }

    .cube__blurb {
      font-size: 0.9rem;
    }

    .cube__info-inner {
      max-width: 70vw;
    }
  }

  @media screen and (max-width: 479px) {
    .works {
      top: 4px;
    }

    .cube__title {
      font-size: 1.6rem;
    }

    .cube__blurb {
      font-size: 0.7rem;
    }

    .cube__info-inner {
      max-width: 80vw;
      font-size: 14px;
    }
  }
</style>
