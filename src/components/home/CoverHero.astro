---
// Homepage section 1, the hero: the creator showreel fills the screen behind an editorial,
// off-centre composition. "Built around" is a small, slightly turned kicker; "creators." is the
// one huge word, wide enough to run off both edges. Small annotations (the group tag, numbered
// routes to the three businesses, "Global" beside the group line) frame it without crowding.
// The footage and selected type drift a little with the pointer (src/scripts/system/motion.ts).
// With `intro`, the page opens on the Stride lockup animation first (home/IntroReveal.astro), on
// every device and every visit: it covers the whole screen and scrolling stays locked until it
// ends or is skipped, while the reel loads behind it; then it fades to the hero as the type is
// masked in (src/scripts/system/hero-intro.ts).
import Media from '../core/Media.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import IntroReveal from './IntroReveal.astro';

type Division = 'social' | 'talent' | 'education';
type VideoSource = { mp4: string; webm?: string; poster: string };

export interface Props {
  headline: string[]; // ['Built', 'around', 'creators.']: the last line is the big word
  description: string;
  reel?: VideoSource & { label: string; mobile?: VideoSource }; // the showreel; a placeholder frame without it
  routes: { audience: string; name: string; href: string; division: Division }[]; // numbered annotations, one per business
  intro?: { words: { label: string; division?: Division }[] };
}

const { headline, description, reel, routes, intro } = Astro.props;
const kicker = headline.slice(0, -1).join(' ');
const word = headline[headline.length - 1] ?? '';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class:list={['cover', { 'cover--intro': intro }]} aria-labelledby="hero-title" data-hero-intro={intro ? '' : undefined}>
  {intro && (
    <>
      <div class="cover__intro">
        <IntroReveal words={intro.words} />
        <div class="cover__intro-grain" aria-hidden="true"></div>
      </div>
      <script is:inline>
        // Decide before the page paints whether the intro plays: whenever motion is allowed. It
        // starts at the top with scrolling locked. If the intro script never starts, show the page.
        (() => {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const hero = document.querySelector('[data-hero-intro]');
          hero.classList.add('is-intro-playing');
          document.documentElement.classList.add('intro-lock');
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          scrollTo(0, 0);
          setTimeout(() => {
            if (hero.dataset.introReady) return;
            hero.classList.remove('is-intro-playing');
            document.documentElement.classList.remove('intro-lock');
            hero.dispatchEvent(new CustomEvent('hero:intro', { bubbles: true }));
          }, 3000);
        })();
      </script>
      <button class="cover__intro-toggle" type="button" data-intro-toggle>Skip intro</button>
    </>
  )}

  <div class="cover__content">
    {/* The footage sits a little larger than the frame so the pointer drift never shows an edge. */}
    <div class="cover__media" data-parallax="14">
      {reel ? (
        <Media video={reel} priority={!intro} controlsPosition="bottom-right" />
      ) : (
        <PlaceholderNotice variant="block" label="Showreel" class="cover__empty">— campaign reel needed</PlaceholderNotice>
      )}
    </div>
    <div class="cover__shade" aria-hidden="true"></div>

    <p class="cover__tag cover__enter" data-parallax="5"><span class="cover__num">00</span>The Stride Group</p>

    {routes.length > 0 && (
      <nav class="cover__routes" aria-label="Stride businesses" data-parallax="6">
        <ol role="list">
          {routes.map((r, i) => (
            <li class="cover__enter" style={`--enter: ${i}`}>
              <a class={`cover__route cover__route--${r.division}`} href={r.href} data-magnetic>
                <span class="cover__num">{pad(i + 1)}</span>
                <span class="cover__route-audience">{r.audience}</span>
                <span class="cover__route-name">{r.name}</span>
                <svg class="cover__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <h1 class="cover__title" id="hero-title">
      <span class="cover__kicker"><span class="cover__kicker-inner cover__enter">{kicker}</span></span>
      {' '}
      <span class="cover__word-wrap" data-parallax="-12"><span class="cover__word cover__enter">{word}</span></span>
    </h1>

    <div class="cover__aside cover__enter">
      <p class="cover__global"><span class="cover__num">↗</span>Global</p>
      <p class="cover__description">{description}</p>
    </div>

    <p class="cover__scroll cover__enter" aria-hidden="true">Scroll <span>↓</span></p>
  </div>
</section>

<style>
  /* No z-index here: the intro layer is position: fixed and must stack above the header (z 100),
     which a stacking context on the section would prevent. */
  .cover {
    position: relative;
    background: var(--navy-900);
    color: var(--white);
  }

  .cover__content {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
  }

  /* ---------- Footage ---------- */
  .cover__media {
    position: absolute;
    inset: -28px;
  }

  .cover :global(.cover__empty) {
    position: absolute;
    inset: 28px;
  }

  /* The reel's pause button stays for keyboard users (WCAG 2.2.2: looping video needs a way to
     pause) but is invisible until it has keyboard focus. */
  .cover :global(.media__toggle:not(:focus-visible)) {
    opacity: 0;
    pointer-events: none;
  }

  /* Only what legibility needs: a navy fall-off under the header and behind the big word. */
  .cover__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(6 20 43 / 0.55), transparent 22%),
      linear-gradient(to top, rgb(6 20 43 / 0.7), transparent 48%);
  }

  /* ---------- Annotations ---------- */
  .cover__num {
    display: inline-block;
    min-width: 2.4em;
    color: var(--ice);
  }

  .cover__tag,
  .cover__global,
  .cover__route,
  .cover__scroll {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cover__tag {
    position: absolute;
    top: calc(var(--header-h) + var(--space-5));
    left: var(--margin);
  }

  .cover__routes {
    position: absolute;
    top: calc(var(--header-h) + var(--space-5));
    right: var(--margin);
  }

  .cover__routes ol {
    display: grid;
    gap: var(--space-1);
    justify-items: end;
  }

  .cover__route {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 36px;
    padding: 0 var(--space-3) 0 var(--space-4);
    border-radius: 999px;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .cover__route-name {
    color: rgb(255 255 255 / 0.55);
    transition: color var(--dur-base) var(--ease-out);
  }

  .cover__arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .cover__route:hover,
  .cover__route:focus-visible {
    background: var(--ice);
    color: var(--navy-900);
  }

  .cover__route:hover .cover__num,
  .cover__route:hover .cover__route-name,
  .cover__route:focus-visible .cover__num,
  .cover__route:focus-visible .cover__route-name {
    color: var(--navy-900);
  }

  .cover__route:hover .cover__arrow,
  .cover__route:focus-visible .cover__arrow {
    transform: translate(2px, -2px) rotate(45deg);
  }

  /* ---------- Title ---------- */
  .cover__title {
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  /* "Built around": secondary, set right of centre and turned a few degrees. */
  .cover__kicker {
    position: absolute;
    left: 38%;
    bottom: calc(12vw + var(--space-6));
    display: block;
    overflow: hidden;
    padding: 0.08em 0.1em;
    font-size: clamp(1.5rem, 3.4vw, 3.5rem);
    font-weight: 750;
    font-stretch: var(--stretch-normal);
    line-height: 1;
    letter-spacing: -0.01em;
    rotate: -3deg;
  }

  .cover__kicker-inner {
    display: block;
  }

  /* "Creators.": the dominant moment, a touch wider than the screen so it bleeds off both edges. */
  .cover__word-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.02em;
    display: block;
  }

  .cover__word {
    display: block;
    margin-left: -0.035em;
    font-size: 14.2vw;
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.8;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  /* ---------- Group line ---------- */
  .cover__aside {
    position: absolute;
    right: var(--margin);
    bottom: calc(12vw + var(--space-6));
    display: grid;
    gap: var(--space-3);
    max-width: 30ch;
  }

  .cover__description {
    font-size: var(--type-body);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.85);
  }

  .cover__scroll {
    position: absolute;
    left: var(--margin);
    bottom: calc(12vw + var(--space-6));
    color: rgb(255 255 255 / 0.7);
  }

  .cover__scroll span {
    display: inline-block;
    margin-left: var(--space-2);
  }

  /* ---------- Entrances (played once the intro hands over) ----------
     The big word is masked in from the left; the kicker drops into its slot from above; the
     annotations slide in from the right, slightly blurred, one after another. */
  .cover__word {
    animation: cover-wipe 1100ms var(--ease-out) 120ms both;
  }

  .cover__kicker-inner {
    animation: cover-drop 800ms var(--ease-out) 420ms both;
  }

  .cover__tag,
  .cover__routes li,
  .cover__aside,
  .cover__scroll {
    animation: cover-slide 700ms var(--ease-out) both;
    animation-delay: calc(560ms + var(--enter, 0) * 80ms);
  }

  @keyframes cover-wipe {
    from {
      clip-path: inset(-10% 100% -10% 0);
      transform: translateX(-4%);
    }
    to {
      clip-path: inset(-10% -10% -10% 0);
      transform: none;
    }
  }

  @keyframes cover-drop {
    from {
      transform: translateY(-110%) rotate(-6deg);
    }
  }

  @keyframes cover-slide {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateX(32px);
    }
  }

  /* ---------- Intro ---------- */
  /* Covers the whole screen, header included (the consent banner, z 200, stays above), with page
     scrolling locked while it plays; then it fades out to the paper cover as the content reveals
     (1.1s: the fade lands on a light surface now). Hidden and locked states sit under .js so the
     page can never stay covered without scripts. */
  .cover__intro {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--navy-900);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 1.1s var(--ease-out),
      visibility 0s linear 1.1s;
  }

  /* While it plays it also catches clicks, so nothing hidden underneath can be clicked. */
  :global(.js) .cover.is-intro-playing .cover__intro {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: none;
  }

  :global(html.js.intro-lock) {
    overflow: hidden;
  }

  /* A fine moving film grain over the animation. */
  .cover__intro-grain {
    position: absolute;
    inset: -50%;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    opacity: 0.16;
    mix-blend-mode: soft-light;
  }

  :global(.js) .cover.is-intro-playing .cover__intro-grain {
    animation: cover-grain 0.9s steps(5) infinite;
  }

  @keyframes cover-grain {
    0% { transform: translate(0, 0); }
    20% { transform: translate(-3%, 2%); }
    40% { transform: translate(2%, -3%); }
    60% { transform: translate(-2%, -1%); }
    80% { transform: translate(3%, 3%); }
    100% { transform: translate(0, 0); }
  }

  :global(.js) .cover.is-intro-playing .cover__content {
    opacity: 0;
  }

  /* Any placeholder tag belongs to the cover underneath. */
  :global(.js) .cover.is-intro-playing :global(.ph-tag) {
    visibility: hidden;
  }

  /* Hold the entrances until the intro ends; they play from the start when it does. */
  :global(.js) .cover.is-intro-playing [data-reveal='load'],
  :global(.js) .cover.is-intro-playing .reveal-line__inner,
  :global(.js) .cover.is-intro-playing .cover__enter {
    animation: none;
  }

  /* "Skip intro": only while the intro plays (WCAG 2.2.2), in the screen's corner. */
  .cover__intro-toggle {
    display: none;
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 151;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 999px;
    background: rgb(6 20 43 / 0.35);
    color: var(--white);
    font-size: 0.8125rem;
    font-weight: 500;
    backdrop-filter: blur(6px);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .cover__intro-toggle:hover {
    background: rgb(6 20 43 / 0.6);
  }

  :global(.js) .cover.is-intro-playing .cover__intro-toggle {
    display: block;
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1023px) {
    .cover__kicker {
      left: var(--margin);
    }

    .cover__scroll {
      display: none;
    }
  }

  /* ---------- Phones ----------
     One annotation, the group line, then the kicker and the word stacked at the bottom; the
     routes are left to the businesses section just below. */
  @media (max-width: 767px) {
    .cover__content {
      min-height: 560px;
    }

    .cover__routes {
      display: none;
    }

    .cover__word {
      margin-left: -0.04em;
      font-size: 17.6vw;
      font-stretch: var(--stretch-normal);
    }

    .cover__kicker {
      left: var(--margin);
      bottom: calc(14vw + var(--space-4));
      font-size: clamp(1.25rem, 6.4vw, 1.75rem);
    }

    .cover__aside {
      left: var(--margin);
      right: var(--margin);
      bottom: calc(14vw + var(--space-4) + 3.4rem);
      max-width: none;
    }

    .cover__description {
      font-size: var(--type-small);
    }

    /* Phone footage often carries its own captions low in the frame; the group line needs a deeper base. */
    .cover__shade {
      background:
        linear-gradient(to bottom, rgb(6 20 43 / 0.55), transparent 20%),
        linear-gradient(to top, rgb(6 20 43 / 0.92) 18%, rgb(6 20 43 / 0.55) 42%, transparent 62%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__word,
    .cover__kicker-inner,
    .cover__tag,
    .cover__routes li,
    .cover__aside,
    .cover__scroll {
      animation: none;
    }
  }
</style>

<script>
  import { initHeroIntro } from '@/scripts/system/hero-intro';
  initHeroIntro();
</script>
