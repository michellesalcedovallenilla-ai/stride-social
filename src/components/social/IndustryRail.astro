---
// Stride Social B5 "Industries we work in": a horizontal rail of tall tiles, one per industry in
// the brief. Each tile uses a real campaign image from that industry and the number of case
// studies tagged with it, and opens the filtered archive. Industries without a case study yet get
// a text-only tile that does not link. Scroll, swipe or use the arrows (src/scripts/system/rail.ts).
import { getCollection } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import { routes } from '@/lib/routes';

export interface Props {
  copy: { eyebrow?: string; headline?: string };
}

const { copy } = Astro.props;
const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const work = (await getCollection('work', (w) => w.data.visible)).sort((a, b) => a.data.order - b.data.order);
const tiles = industries.map((ind) => {
  const tagged = work.filter((w) => w.data.industries.some((r) => r.id === ind.id));
  return { id: ind.id, label: ind.data.label, count: tagged.length, image: tagged[0]?.data.card };
});
---

<section class="ind" aria-labelledby="ind-title" data-rail>
  <header class="ind__head container-wide">
    <div>
      <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
      <h2 class="ind__title" id="ind-title" data-reveal-lines>{copy.headline}</h2>
    </div>
    <div class="ind__controls">
      <button class="ind__arrow" type="button" data-rail-prev aria-label="Previous industries" disabled>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M15 8H2M7 3 2 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
      <button class="ind__arrow" type="button" data-rail-next aria-label="Next industries">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
    </div>
  </header>

  <ul class="ind__track" role="list" data-rail-track tabindex="0" aria-label="Industries">
    {tiles.map((t, i) => (
      <li class="ind__item">
        {t.count > 0 ? (
          <a class="ind__tile" href={routes.workFiltered({ industry: t.id })}>
            {t.image && <img class="ind__img" src={t.image.src} alt="" loading="lazy" decoding="async" />}
            <span class="ind__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="ind__info">
              <span class="ind__name">{t.label}</span>
              <span class="ind__count">{t.count} {t.count === 1 ? 'case study' : 'case studies'}</span>
            </span>
          </a>
        ) : (
          <div class="ind__tile ind__tile--text">
            <span class="ind__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="ind__info">
              <span class="ind__name">{t.label}</span>
            </span>
          </div>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .ind {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--navy-900);
    color: var(--white);
  }

  .ind__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-8);
  }

  .ind__head > div:first-child {
    display: grid;
    gap: var(--space-4);
  }

  .ind__title {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .ind__controls {
    display: flex;
    gap: var(--space-3);
  }

  .ind__arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    color: var(--white);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }

  .ind__arrow svg {
    width: 18px;
  }

  .ind__arrow:not(:disabled):hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--navy-900);
  }

  .ind__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* The rail lines up with the content edge and bleeds off the right of the screen. */
  .ind__track {
    display: flex;
    gap: var(--gutter);
    padding-inline: max(var(--margin), calc((100vw - var(--container-wide)) / 2));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--margin), calc((100vw - var(--container-wide)) / 2));
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .ind__track::-webkit-scrollbar {
    display: none;
  }

  .ind__item {
    flex: none;
    container-type: inline-size;
    width: clamp(240px, 24vw, 380px);
    scroll-snap-align: start;
  }

  .ind__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 2 / 3;
    padding: var(--space-5);
    overflow: hidden;
    background: var(--navy-700);
    isolation: isolate;
  }

  .ind__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(6 20 43 / 0.85), rgb(6 20 43 / 0.05) 55%, rgb(6 20 43 / 0.35));
  }

  .ind__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: grayscale(0.35);
    transition:
      transform var(--dur-reveal) var(--ease-out),
      filter var(--dur-reveal) var(--ease-out);
  }

  a.ind__tile:hover .ind__img {
    transform: scale(1.05);
    filter: none;
  }

  .ind__tile--text {
    border: 1px solid var(--line-dark);
    background: none;
  }

  .ind__tile--text::after {
    content: none;
  }

  .ind__index {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .ind__info {
    display: grid;
    gap: var(--space-2);
  }

  /* Sized to the tile so "TECHNOLOGY" and "CONSTRUCTION" fit without breaking mid-word. */
  .ind__name {
    font-family: var(--font-display);
    font-size: min(9cqi, 2.75rem);
    font-weight: 850;
    font-stretch: 112%;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .ind__count {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .ind__controls {
      display: none;
    }

    .ind__item {
      width: 72vw;
    }
  }
</style>

<script>
  import { initRails } from '@/scripts/system/rail';
  initRails();
</script>
