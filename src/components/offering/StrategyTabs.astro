---
// Numbered strategies accordion. Each row toggles independently (several can be open);
// hovering a row slides its number up and turns the plus, an open row shows a cross.
// Panels hold the description, related case studies and a photo.
import { getCollection } from 'astro:content';

export interface Tab {
  number: string;
  title: string;
  /** Description HTML as on the live page (<strong>, <br>). */
  html: string;
  /** Case study slugs listed under "Case studies". */
  caseStudies: string[];
  /** Extra plain links shown after the list. */
  links: { label: string; href: string }[];
  image: { src: string; alt: string };
}

export interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;
const titles = new Map((await getCollection('caseStudies')).map((c) => [c.id, c.data.title]));
---

<div class="tabs">
  {tabs.map((tab, i) => (
    <div class="tab" data-tab>
      <h3 class="tab__heading">
        <button class="tab__top" id={`strategy-${i + 1}-toggle`} type="button" aria-expanded="false" aria-controls={`strategy-${i + 1}`} data-tab-toggle>
          <span class="tab__grid">
            <span class="tab__number" aria-hidden="true">
              <span class="tab__clip">
                <span class="tab__num">{tab.number}</span>
                <span class="tab__num tab__num--next">{tab.number}</span>
              </span>
            </span>
            <span class="tab__title">{tab.title}</span>
            <span class="tab__icon" aria-hidden="true">
              <span class="tab__icon-turn">
                <img src="/assets/site/1603f8ad-64167482b071a72dd977f8cf_icon-plus.svg.svg" alt="" width="16" height="16" />
              </span>
            </span>
          </span>
        </button>
      </h3>
      <div class="tab__panel" id={`strategy-${i + 1}`} role="region" aria-labelledby={`strategy-${i + 1}-toggle`} inert data-tab-panel>
        <div class="tab__panel-inner">
          <div class="tab__body">
            <div class="tab__intro">
              <p class="tab__text" set:html={tab.html} />
              <div class="tab__cases">
                <div class:list={['tab__cases-title', { 'tab__cases-title--no-list': !tab.caseStudies.length }]}>Case studies</div>
                {tab.caseStudies.length > 0 && (
                  <ul class="tab__case-list">
                    {tab.caseStudies.map((slug) => (
                      <li>
                        <a class="tab__case-link" href={`/case-studies/${slug}`}>{titles.get(slug) ?? slug}</a>
                      </li>
                    ))}
                  </ul>
                )}
                {tab.links.map((l) => (
                  <a class="tab__case-link" href={l.href}>{l.label}</a>
                ))}
              </div>
            </div>
            <img class="tab__image" src={tab.image.src} alt={tab.image.alt} loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .tab {
    border-top: 1px solid var(--color-line);
  }

  .tab__heading {
    font: inherit;
  }

  .tab__top {
    display: block;
    width: 100%;
    padding: 3.5rem 2.5rem 3.5rem 0;
    text-align: left;
    cursor: pointer;
  }

  .tab__grid {
    display: grid;
    grid-template-columns: 3rem 4fr 2rem;
    align-items: start;
    gap: 1rem;
  }

  .tab__number,
  .tab__icon {
    display: flex;
    align-self: center;
    align-items: center;
  }

  .tab__clip {
    position: relative;
    display: flex;
    overflow: hidden;
  }

  .tab__num {
    padding: 1px 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-strong);
    transition: transform 0.4s var(--ease-out);
  }

  .tab__num--next {
    position: absolute;
    top: 100%;
    left: 0;
  }

  .tab__title {
    font-family: var(--font-sans);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .tab__icon {
    justify-content: center;
    justify-self: end;
    width: 1rem;
    transition: transform 0.4s var(--ease-out);
  }

  .tab__icon-turn {
    display: flex;
    transition: transform 0.4s var(--ease-out);
  }

  .tab__icon img {
    display: block;
    width: 1rem;
    height: 1rem;
  }

  @media (hover: hover) {
    .tab__top:hover .tab__num {
      transform: translateY(-100%);
    }

    .tab__top:hover .tab__icon {
      transform: rotate(90deg);
    }
  }

  .tab.is-open .tab__icon-turn {
    transform: rotate(135deg);
  }

  .tab__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .tab.is-open .tab__panel {
    grid-template-rows: 1fr;
  }

  .tab__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .tab__body {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: start;
    gap: 1rem;
    padding: 2rem 2.5rem 5rem 0;
  }

  .tab__intro {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .tab__text {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-navy);
  }

  .tab__text :global(strong) {
    font-weight: 700;
  }

  .tab__cases {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .tab__cases-title {
    font-family: var(--font-sans);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--color-navy-mute);
  }

  /* The live page keeps an empty (zero-height) CMS list here, which adds one more gap. */
  .tab__cases-title--no-list {
    margin-bottom: 0.5rem;
  }

  .tab__case-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .tab__case-link {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-strong);
    text-decoration: underline;
    text-decoration-color: var(--color-navy);
    text-underline-offset: 5px;
    transition: color 0.2s;
  }

  .tab__case-link:hover {
    color: var(--color-navy-mute);
  }

  .tab__image {
    display: block;
    width: 100%;
    height: 30rem;
    object-fit: cover;
  }

  @media screen and (max-width: 991px) {
    .tab__top {
      padding: 2.75rem 1.625rem 2.75rem 0;
    }

    .tab__body {
      padding-right: 1.625rem;
    }

    .tab__intro {
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .tab__top {
      padding: 2rem 1rem 2rem 0;
    }

    .tab__body {
      padding: 1.5rem 1rem 3.25rem 0;
    }

    .tab__cases {
      padding-top: 0.5rem;
    }
  }

  @media screen and (max-width: 479px) {
    .tab__grid {
      grid-template-columns: 2rem 4fr 2rem;
    }

    .tab__title {
      font-size: 1.4rem;
      color: var(--color-navy-mute);
    }

    .tab__body {
      grid-template-columns: 1fr;
    }

    .tab__text {
      font-size: 16px;
    }

    .tab__image {
      height: 21rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => {
    const toggle = tab.querySelector<HTMLButtonElement>('[data-tab-toggle]');
    const panel = tab.querySelector<HTMLElement>('[data-tab-panel]');
    toggle?.addEventListener('click', () => {
      const open = !tab.classList.contains('is-open');
      tab.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      // Collapsed panels stay out of the tab order and the accessibility tree.
      panel?.toggleAttribute('inert', !open);
    });
  });
</script>
