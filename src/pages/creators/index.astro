---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarqueeHero from '@/components/sections/MarqueeHero.astro';
import TalentCard from '@/components/cards/TalentCard.astro';
import CardGrid from '@/components/portfolio/CardGrid.astro';
import { footerCtas } from '@/config/site';

// The live page loads the roster 100 at a time (Jetboost infinite scroll with a
// ?a335c3eb_page=N fallback); here the whole roster is rendered on one page.
const creators = (await getCollection('creators')).sort((a, b) => a.data.order - b.data.order);

// Roster entries without a profile page on the live site send enquiries to the contact page
// instead of linking to a missing profile.
const hrefFor = (c: (typeof creators)[number]) => (c.data.profile ? `/creators/${c.id}` : '/contact');
---

<BaseLayout
  title="Stride Social | Our Creators"
  description="Our Cretaors come from the world of social media marketing and UGC, we also work with trusted partners to guarantee results for you"
  nav="solid"
  background="smoke"
  footerCta={footerCtas.standard}
>
  <MarqueeHero title="Our creators" intro="Explore our roster of global creators and the partners we work with on commercial projects around the world." />

  <section class="creator-list" aria-label="Our creators">
    <CardGrid layout="four" label="Creator roster">
      {creators.map((c) => (
        <li>
          <TalentCard href={hrefFor(c)} image={c.data.image} name={c.data.name} tag={c.data.category} metric={c.data.followers} metricLabel="Followers" />
        </li>
      ))}
    </CardGrid>
  </section>
</BaseLayout>

<style>
  .creator-list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--color-smoke-2);
  }
</style>
