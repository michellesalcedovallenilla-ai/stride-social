---
// Utility 404 page. Like the live site it is a bare page: no navbar, no footer.
import '@/styles/global.css';
import { site } from '@/config/site';

const title = 'Not Found';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta name="twitter:title" content={title} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={site.favicon} type="image/png" />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />
  </head>
  <body>
    <main class="notfound">
      <div class="notfound__content">
        <h1 class="notfound__code">404</h1>
        <p class="notfound__text">The page you are looking for doesn't exist or has been moved</p>
        <a class="notfound__button" href="/">Go home</a>
      </div>
    </main>
  </body>
</html>

<style>
  .notfound {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100vw;
    max-width: 100%;
    height: 100vh;
    max-height: 100%;
  }

  .notfound__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .notfound__code {
    position: relative;
    z-index: 1;
    font-family: var(--font-sans);
    font-size: 32rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    color: #000;
  }

  .notfound__text {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #000;
  }

  .notfound__button {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 4rem;
    padding: 1.2em 35px;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
    background-color: #000;
    transition: background-color 0.2s;
  }

  .notfound__button:hover {
    color: #616161;
    background-color: #efffa6;
  }

  @media screen and (max-width: 991px) {
    .notfound__code {
      font-size: 21rem;
    }

    .notfound__button {
      padding: 18px 40px;
    }
  }

  @media screen and (max-width: 767px) {
    .notfound__code {
      font-size: 40vw;
    }

    .notfound__button {
      width: 100%;
      font-size: 16px;
    }
  }

  @media screen and (max-width: 479px) {
    .notfound__content {
      padding-inline: 1rem;
    }

    .notfound__button {
      padding-inline: 25px;
    }
  }
</style>
