---
// Muted looping background video with poster, optional separate source for phones (≤479px).
export interface Props {
  mp4: string;
  webm?: string;
  poster: string;
  mobile?: { mp4: string; webm?: string; poster: string };
  class?: string;
}

const { mp4, webm, poster, mobile, class: className, ...rest } = Astro.props;
---

<div class:list={['bg-video', className]} {...rest}>
  <video class:list={['bg-video__media', { 'bg-video__media--desktop': mobile }]} autoplay muted loop playsinline preload="auto" poster={poster}>
    {webm && <source src={webm} type="video/webm" />}
    <source src={mp4} type="video/mp4" />
  </video>
  {mobile && (
    <video class="bg-video__media bg-video__media--mobile" autoplay muted loop playsinline preload="none" poster={mobile.poster}>
      {mobile.webm && <source src={mobile.webm} type="video/webm" />}
      <source src={mobile.mp4} type="video/mp4" />
    </video>
  )}
</div>

<style>
  .bg-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .bg-video__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .bg-video__media--mobile {
    display: none;
  }

  @media screen and (max-width: 479px) {
    .bg-video__media--desktop {
      display: none;
    }

    .bg-video__media--mobile {
      display: block;
    }
  }
</style>
