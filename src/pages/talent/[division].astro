---
// Talent division page: a frosted glass door over the division's picture, which clears wherever the
// pointer goes (talent/DivisionDoor), then the shared menu with its creators and the other divisions.
// Divisions marked coming-soon (all five today, Q24) get a short, honest holding page that the navigation
// can link to: noindex, no invented members or copy, with routes to the full roster and the application form.
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import DivisionDoor from '@/components/talent/DivisionDoor.astro';
import Deck from '@/components/experience/Deck.astro';
import DraftTag from '@/components/core/DraftTag.astro';
import { getRoster } from '@/lib/roster';
import { routes } from '@/lib/routes';
import { chunks, paragraphs } from '@/lib/experience';
import type { Card } from '@/lib/experience';

export async function getStaticPaths() {
  const divisions = await getCollection('talentDivisions');
  return divisions.map((division) => ({ params: { division: division.id }, props: { division, divisions } }));
}

const { division, divisions } = Astro.props;
const d = division.data;
const active = d.status === 'active';
const body = d.copyStatus !== 'needed' ? paragraphs(division.body).flatMap((p) => chunks(p)) : [];
const members = (await getRoster()).filter((c) => c.data.divisions.some((x) => x.id === division.id));
const categories = Object.fromEntries((await getCollection('categories')).map((c) => [c.id, c.data.label]));
const description = active && d.tagline ? d.tagline : `${d.name}, a specialist division of Stride Talent.`;
const holding = 'A specialist division of Stride Talent. Until it opens, explore the full roster or apply for representation.';

const memberCards: Card[] = members
  .filter((c) => c.data.portrait)
  .slice(0, 12)
  .map((c) => ({ name: c.data.name, text: c.data.mainCategory ? categories[c.data.mainCategory.id] : undefined, href: routes.creator(c.id), image: c.data.portrait, direct: true }));
const otherCards: Card[] = divisions
  .filter((x) => x.id !== division.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((x) => ({ name: x.data.name, text: x.data.status === 'active' ? x.data.tagline : 'Coming soon', href: `/talent/${x.id}`, image: x.data.hero, direct: true }));
---

<SiteLayout title={`${d.name} | Stride Talent`} description={description} division="talent" noindex={!active} look="deep" headerOverlay>
  <DivisionDoor
    name={d.name}
    tagline={active ? d.tagline : 'Coming soon'}
    text={active ? body : [holding]}
    image={d.hero}
    crumbs={[{ label: 'Stride Talent', href: '/talent' }, { label: 'Divisions', href: '/talent#divisions' }, { label: d.name }]}
    actions={[{ label: 'Apply For Management', href: '/talent/apply' }, { label: 'Explore Our Roster', href: '/talent/roster' }]}
  >
    <DraftTag status={d.copyStatus === 'approved' ? 'approved' : 'draft'} />
  </DivisionDoor>

  <Deck
    id="division-menu"
    label={`More from ${d.name}`}
    tone="talent"
    look="deep"
    tabs={[
      { key: 'creators', label: 'Creators', icon: 'people', cards: memberCards },
      { key: 'divisions', label: 'Other Divisions', icon: 'star', cards: otherCards },
    ]}
    link={{ label: 'Apply For Management', href: '/talent/apply' }}
  />
</SiteLayout>
