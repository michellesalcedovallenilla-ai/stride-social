---
// Homepage section A2 "THREE SIDES OF STRIDE.": three large editorial panels, one per division.
// Desktop: equal full-height columns; the hovered panel widens and the others dim.
// Mobile: substantial stacked sections (image, then text on the division surface).
import Media from '../core/Media.astro';
import Eyebrow from '../core/Eyebrow.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';

type Panel = {
  division: 'social' | 'talent' | 'education';
  audience: string;
  name: string;
  copy: string;
  cta: string;
  href: string;
  image: { src: string; alt: string; position?: string };
  video?: { mp4: string; webm?: string; poster: string; label: string };
  interim?: boolean;
};

export interface Props {
  eyebrow: string;
  headline: string;
  panels: Panel[];
}

const { eyebrow, headline, panels } = Astro.props;
---

<section class="sides" aria-labelledby="sides-title">
  <header class="sides__head">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="sides__title" id="sides-title" data-reveal-lines>{headline}</h2>
  </header>

  <ul class="sides__panels" role="list">
    {panels.map((p, i) => (
      <li class={`side side--${p.division}`} data-media-hover>
        <a class="side__link" href={p.href}>
          <div class="side__visual">
            <Media
              image={p.video ? undefined : { src: p.image.src, alt: p.image.alt }}
              video={p.video}
              play="hover"
              position={p.image.position}
              class="side__media"
            />
            {p.interim && <PlaceholderNotice label="Interim image" />}
          </div>
          <div class="side__body">
            <Eyebrow number={String(i + 1).padStart(2, '0')} tone="dark" as="span" class="side__eyebrow">{p.audience}</Eyebrow>
            <h3 class="side__name">
              <span class="side__stride">Stride</span>
              <span class="side__division">{p.name}</span>
            </h3>
            <p class="side__copy">{p.copy}</p>
            <span class="side__cta">
              {p.cta}
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .sides {
    position: relative;
    z-index: 1;
    background: var(--navy-900);
    color: var(--white);
  }

  .sides__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
    gap: var(--gutter);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: var(--section-pad) var(--margin) var(--space-7);
  }

  .sides__head :global(.eyebrow) {
    grid-column: 1 / 4;
    align-self: end;
    padding-bottom: 0.6em;
    color: rgb(255 255 255 / 0.7);
  }

  .sides__title {
    grid-column: 4 / -1;
    justify-self: end;
    text-align: right;
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* ---------- Panels ---------- */
  .sides__panels {
    display: flex;
    gap: 2px;
    height: 92vh;
    min-height: 640px;
    max-height: 980px;
    background: var(--navy-900);
  }

  .side {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    container-type: inline-size;
    transition: flex-grow var(--dur-slow) var(--ease-out);
  }

  .side__link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    color: var(--white);
  }

  .side__visual {
    position: absolute;
    inset: 0;
  }

  .side :global(.side__media .media__el) {
    transition:
      transform var(--dur-reveal) var(--ease-out),
      filter var(--dur-slow) var(--ease-out);
  }

  /* Distinct photographic treatment per division (design system §7) */
  .side--social :global(.media__el) {
    filter: saturate(0.85) contrast(1.08);
  }

  .side--talent :global(.media__el) {
    filter: sepia(0.18) saturate(0.9) contrast(1.02);
  }

  .side--education :global(.media__el) {
    filter: saturate(1.08) brightness(1.04);
  }

  .side__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(6 20 43 / 0.92) 0%, rgb(6 20 43 / 0.45) 38%, rgb(6 20 43 / 0.05) 70%);
    transition: background-color var(--dur-slow) var(--ease-out);
  }

  .side__body {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-7) clamp(var(--space-5), 2.6vw, var(--space-7));
  }

  /* Short accent bar in the division colour above the label */
  .side__body::before {
    content: '';
    justify-self: start;
    width: 40px;
    height: 4px;
    background: var(--side-accent);
  }

  .side--social {
    --side-accent: var(--ice);
  }

  .side--talent {
    --side-accent: var(--peach);
  }

  .side--education {
    --side-accent: var(--sun);
  }

  .side__name {
    display: grid;
    font-family: var(--font-display);
    font-weight: 850;
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .side__stride {
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    font-stretch: 112%;
    letter-spacing: 0.02em;
    color: var(--side-accent);
  }

  /* Sized to the panel (container query units) so the longest name, EDUCATION, always fits
     on one line, including while a neighbouring panel is expanded. */
  .side__division {
    font-size: clamp(2.25rem, 11.5cqi, 5rem);
    font-stretch: 116%;
  }

  .side__copy {
    max-width: 30ch;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.86);
  }

  .side__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    justify-self: start;
    font-weight: 500;
    border-bottom: 1px solid var(--side-accent);
  }

  .side__cta svg {
    width: 16px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .side :global(.ph-tag) {
    top: var(--space-4);
    right: var(--space-4);
  }

  /* Desktop hover: widen the hovered panel, dim the others */
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .sides__panels:hover .side {
      flex-grow: 0.86;
    }

    .sides__panels .side:hover,
    .sides__panels .side:focus-within {
      flex-grow: 1.28;
    }

    .sides__panels:hover .side:not(:hover) .side__visual::after {
      background-color: rgb(6 20 43 / 0.35);
    }

    .side:hover :global(.media__el),
    .side:focus-within :global(.media__el) {
      transform: scale(1.04);
    }

    .side:hover .side__cta svg {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side {
      transition: none;
    }
  }

  /* ---------- Tablet / mobile: stacked editorial sections ---------- */
  @media (max-width: 1023px) {
    .sides__head {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .sides__head :global(.eyebrow),
    .sides__title {
      grid-column: 1;
      justify-self: start;
      text-align: left;
    }

    .sides__panels {
      flex-direction: column;
      height: auto;
      max-height: none;
      gap: 0;
    }

    .side__link {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      min-height: 85svh;
    }

    .side__visual {
      position: relative;
      inset: auto;
      min-height: 52svh;
    }

    .side__visual::after {
      background: linear-gradient(to top, rgb(6 20 43 / 0.25), transparent 40%);
    }

    .side__body {
      position: relative;
      padding: var(--space-6) var(--margin) var(--space-7);
    }

    .side--social .side__body {
      background: var(--navy-900);
    }

    .side--talent .side__body {
      background: var(--paper);
      color: var(--navy-900);
    }

    .side--education .side__body {
      background: var(--white);
      color: var(--navy-900);
    }

    .side--talent :global(.eyebrow),
    .side--education :global(.eyebrow) {
      color: var(--slate);
    }

    .side--talent .side__copy,
    .side--education .side__copy {
      color: var(--slate);
    }

    .side--talent .side__stride {
      color: var(--peach-deep);
    }

    .side--education .side__stride {
      color: var(--sun-deep);
    }

    .side--talent .side__link,
    .side--education .side__link {
      color: var(--navy-900);
    }

    .side__division {
      font-size: clamp(2.5rem, 12cqi, 4.5rem);
    }
  }
</style>
