---
// About page: "Who are Stride Social?" block — lead paragraph, key figures and the two
// founder portraits (they fade up as they scroll into view, see reveal.ts).
import MonoLabel from '../ui/MonoLabel.astro';
import InfoRows from '../ui/InfoRows.astro';

export interface Founder {
  name: string;
  role: string;
  image: string;
  alt: string;
}

export interface Props {
  label: string;
  /** Bold opening lines; `\n` becomes a line break. */
  leadStrong: string;
  lead: string;
  rows: { label: string; value: string }[];
  /** In visual order (left to right on desktop, top to bottom on phones). */
  founders: Founder[];
}

const { label, leadStrong, lead, rows, founders } = Astro.props;
const strongLines = leadStrong.split('\n');
---

<section class="about-who">
  <div class="about-who__inner container-wide">
    <MonoLabel tone="light">{label}</MonoLabel>
    <div class="about-who__grid">
      <div class="about-who__copy">
        <p class="about-who__lead" data-split="letters-fade-in">
          <strong>{strongLines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</strong>{' '}<br /><br />{lead}
        </p>
      </div>
      <InfoRows class="about-who__rows" rows={rows} />
    </div>
    <div class="about-who__founders">
      {founders.map((f, i) => (
        <figure class="founder" data-reveal style={`--reveal-delay: ${i * 0.2}s`}>
          <div class="founder__image">
            <img class="cover-image" src={f.image} alt={f.alt} loading="lazy" decoding="async" />
          </div>
          <figcaption class="founder__caption">
            <h3 class="founder__name">{f.name}</h3>
            <p class="founder__role">{f.role}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .about-who {
    position: relative;
    z-index: 1;
    background-color: var(--color-smoke-2);
  }

  .about-who__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  .about-who__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .about-who__copy {
    display: flex;
    flex-direction: column;
  }

  .about-who__lead {
    width: 90%;
    font-family: var(--font-sans);
    font-size: 2.5em;
    font-weight: 200;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .about-who__lead strong {
    font-weight: 700;
  }

  .about-who__grid :global(.about-who__rows) {
    align-self: start;
  }

  .about-who__founders {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    height: 60vh;
  }

  .founder {
    margin: 0;
  }

  .founder__image {
    position: relative;
    height: 100%;
    max-height: 60vh;
    overflow: hidden;
  }

  .founder__caption {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .founder__name {
    font-size: 1rem;
    font-weight: 600;
  }

  .founder__role {
    font-size: 0.9rem;
    font-weight: 300;
  }

  /* Fade up when scrolled into view (Webflow IX2 "scroll into view"). */
  :global(.js) [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 100px, 0);
    transition:
      opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--reveal-delay, 0s),
      transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--reveal-delay, 0s);
  }

  :global(.js) [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 991px) {
    .about-who__copy {
      font-size: 12px;
    }

    .about-who__lead {
      font-size: 2em;
    }
  }

  @media screen and (max-width: 767px) {
    .about-who__founders {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 479px) {
    .about-who__grid {
      grid-template-columns: 1fr;
    }

    .about-who__lead {
      font-size: 1.4em;
      line-height: 1.4;
    }

    .about-who__founders {
      gap: 3rem;
    }

    .founder__image {
      width: 100%;
      max-height: 40vh;
    }

    .founder__name,
    .founder__role {
      font-size: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>

