---
// Homepage A5 "Our work": asymmetric mosaic of featured case studies (work entries with
// featuredOn: home, in featuredOrder). Brands named in the brief without an approved case study
// appear as labelled placeholder tiles in preview builds only. Result figures are shown only
// when verified; otherwise the tile shows the services.
import { getCollection, getEntries } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import Button from '../core/Button.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { routes } from '@/lib/routes';
import { isPreview } from '@/lib/env';

export interface Props {
  copy: { eyebrow?: string; headline?: string; cta?: { label: string; href: string }; awaiting?: string[] };
}

const { copy } = Astro.props;
const featured = (await getCollection('work', (w) => w.data.visible && w.data.featuredOn.includes('home'))).sort(
  (a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99),
);

type Tile = { kind: 'work'; href: string; title: string; image: { src: string; alt: string }; meta: string; result?: string } | { kind: 'awaiting'; title: string };
const tiles: Tile[] = [
  ...(isPreview ? (copy.awaiting ?? []).map((title) => ({ kind: 'awaiting' as const, title })) : []),
  ...(await Promise.all(
    featured.map(async (w) => {
      const services = await getEntries(w.data.services);
      const verified = w.data.results.find((r) => r.status === 'verified');
      return {
        kind: 'work' as const,
        href: routes.caseStudy(w.id),
        title: w.data.title,
        image: w.data.hero ?? w.data.card,
        meta: services.map((s) => s.data.name).join(' · '),
        result: verified ? `${verified.value} ${verified.label.toLowerCase()}` : undefined,
      };
    }),
  )),
];
// Layout pattern by tile count: sizes cycle so neighbouring tiles never match.
const sizes = tiles.length >= 5 ? ['xl', 'm', 'm', 'm', 'l'] : tiles.length === 4 ? ['xl', 'm', 'm', 'wide'] : tiles.length === 3 ? ['xl', 'm', 'm'] : ['l', 'l'];
---

<section class="work" aria-labelledby="work-title">
  <header class="work__head">
    <div>
      <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
      <h2 class="work__title" id="work-title" data-reveal-lines>{copy.headline}</h2>
    </div>
    {copy.cta && <Button href={copy.cta.href} variant="text" tone="dark">{copy.cta.label}</Button>}
  </header>

  <ul class={`work__grid work__grid--${tiles.length}`} role="list">
    {tiles.map((t, i) => (
      <li class={`tile tile--${sizes[i % sizes.length]}`} data-reveal="rise" style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
        {t.kind === 'work' ? (
          <a class="tile__link" href={t.href}>
            <span class="tile__media">
              <img src={t.image.src} alt={t.image.alt} loading="lazy" decoding="async" />
            </span>
            <span class="tile__info">
              <span class="tile__meta">{t.meta}</span>
              <span class="tile__name">{t.title}</span>
              {t.result && <span class="tile__result">{t.result}</span>}
            </span>
            <svg class="tile__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
          </a>
        ) : (
          <div class="tile__awaiting">
            <span class="tile__name">{t.title}</span>
            <PlaceholderNotice variant="block" label="Awaiting case study">
              <p>Named in the brief for this section. Needs approved imagery, brief, execution and verified results (Q6).</p>
            </PlaceholderNotice>
          </div>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .work {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--navy-900);
    color: var(--white);
  }

  .work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: 0 var(--margin) var(--space-8);
  }

  .work__head > div {
    display: grid;
    gap: var(--space-4);
  }

  .work__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(220px, 22vw, 360px);
    gap: var(--gutter);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  /* Tile sizes */
  .tile--xl { grid-column: span 8; grid-row: span 2; }
  .tile--l { grid-column: span 7; grid-row: span 2; }
  .tile--m { grid-column: span 4; grid-row: span 1; }
  .tile--wide { grid-column: span 12; grid-row: span 1; }
  .work__grid--5 .tile:nth-child(4) { grid-column: span 5; grid-row: span 2; }
  .work__grid--5 .tile:nth-child(5) { grid-column: span 7; }

  .tile {
    position: relative;
    min-height: 0;
  }

  .tile__link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--navy-700);
  }

  .tile__media,
  .tile__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tile__media img {
    max-width: none;
    object-fit: cover;
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .tile__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(6 20 43 / 0.85), rgb(6 20 43 / 0) 55%);
  }

  .tile__info {
    position: absolute;
    left: var(--space-5);
    right: var(--space-9);
    bottom: var(--space-5);
    z-index: 1;
    display: grid;
    gap: var(--space-2);
  }

  .tile__meta {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tile__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 3.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .tile--xl .tile__name,
  .tile--l .tile__name {
    font-size: clamp(2.25rem, 4.6vw, 5rem);
  }

  .tile__result {
    font-size: var(--type-small);
    color: rgb(255 255 255 / 0.85);
  }

  .tile__arrow {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 1;
    width: 22px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .tile__link:hover img {
    transform: scale(1.04);
  }

  .tile__link:hover .tile__arrow {
    transform: translateX(4px);
  }

  .tile__awaiting {
    display: grid;
    align-content: space-between;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-5);
    border: 1px dashed rgb(255 255 255 / 0.35);
    color: rgb(255 255 255 / 0.85);
  }

  .tile__awaiting :global(.ph-block) {
    border-color: rgb(255 255 255 / 0.35);
    color: var(--white);
    background: none;
  }

  @media (max-width: 1023px) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: auto;
    }

    .tile,
    .work__grid .tile:nth-child(n) {
      grid-column: span 1;
      grid-row: auto;
      aspect-ratio: 3 / 2;
    }

    .tile:first-child {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }

    .tile__awaiting {
      aspect-ratio: auto;
    }
  }

  @media (max-width: 599px) {
    .work__grid {
      grid-template-columns: 1fr;
    }

    .tile:first-child {
      aspect-ratio: 4 / 5;
    }
  }
</style>
