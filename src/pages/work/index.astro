---
// Our Work: every visible case study on a wall you can move (experience/Wall). Scroll it, drag it, throw
// it; filter by industry and service (URL-synced: /work?industry=technology) and the tiles fly to their
// new places. A tile grows into a big card with the case in short (verified results only), which leads to
// its page. Only industries and services that have case studies get a filter. Tags are proposed until
// Stride approves the Gate 2 mapping.
import { getCollection, getEntries, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Wall from '@/components/experience/Wall.astro';
import EnquiryClose from '@/components/social/EnquiryClose.astro';
import { routes } from '@/lib/routes';
import { workPreviews } from '@/lib/previews';

const work = (await getCollection('work', (w) => w.data.visible)).sort((a, b) => a.data.order - b.data.order);
const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.number - b.data.number);
const facet = (ids: (w: (typeof work)[number]) => string[]) => (id: string) => work.filter((w) => ids(w).includes(id)).length;
const industryCount = facet((w) => w.data.industries.map((r) => r.id));
const serviceCount = facet((w) => w.data.services.map((r) => r.id));
const groups = [
  { key: 'industry', label: 'Industry', options: industries.map((i) => ({ id: i.id, label: i.data.label, n: industryCount(i.id) })).filter((o) => o.n > 0) },
  { key: 'service', label: 'Service', options: services.map((s) => ({ id: s.id, label: s.data.name, n: serviceCount(s.id) })).filter((o) => o.n > 0) },
];

const items = await Promise.all(
  work.map(async (w) => {
    const name = (await getEntry(w.data.client))?.data.name ?? w.data.title;
    const tagged = await getEntries(w.data.services);
    const labels = (await getEntries(w.data.industries)).map((i) => i.data.label);
    return {
      key: w.id,
      name,
      meta: tagged.map((s) => s.data.name).join(' · '),
      image: w.data.card,
      href: routes.caseStudy(w.id),
      video: workPreviews[w.id],
      filters: { industry: w.data.industries.map((i) => i.id).join(' '), service: w.data.services.map((s) => s.id).join(' ') },
      card: {
        name,
        text: w.data.summary,
        href: routes.caseStudy(w.id),
        image: w.data.hero ?? w.data.card,
        chips: [...labels, ...w.data.markets, ...(w.data.year ? [String(w.data.year)] : [])],
        stats: w.data.results.filter((r) => r.status === 'verified').slice(0, 3),
        action: { label: 'View case study', href: routes.caseStudy(w.id) },
      },
    };
  }),
);

const copy = (await getEntry('pages', 'work'))?.data.sections.hero;
const final = (await getEntry('pages', 'social'))?.data.sections.final;
if (!copy) throw new Error('Missing src/content/pages/work.yaml');
---

<SiteLayout title="Our Work | Stride Social case studies" description={copy.body} division="social" look="ice" headerOverlay>
  <Wall items={items} groups={groups} copy={copy} noun="case study|case studies" tone="social" look="ice" surprise showcase crumbs={[{ label: 'Our Work' }]} eyebrow="Case study" />
  <EnquiryClose headline={final?.headline ?? ''} label={final?.cta?.label ?? ''} tone="social" look="ice" />
</SiteLayout>
