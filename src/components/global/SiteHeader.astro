---
// Site chrome: the Stride logo, Contact and a Menu button, the division sub-bar, the camera mode
// dial docked at the left edge (desktop) and the full-screen menu, where a larger dial chooses a
// mode and shows its pages. The dial replaced the mega menus (docs/phase-3/homepage-magazine.md).
// Behaviour: src/scripts/system/header.ts and src/scripts/system/mode-dial.ts.
import StrideLogo from '../core/StrideLogo.astro';
import ModeDial from './ModeDial.astro';
import { contactLink, divisionBars, modes, modeOf, type DivisionKey } from '@/config/navigation';
import { socials } from '@/config/site';

export interface Props {
  division: DivisionKey;
  path: string;
  /** Transparent header with light text over a full-bleed dark hero. */
  overlay?: boolean;
}

const { division, path, overlay = false } = Astro.props;
const bar = division !== 'group' ? divisionBars[division] : null;
const mode = modeOf(path);
const modeIndex = Math.max(0, modes.findIndex((m) => m.key === mode));
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class:list={['chrome', { 'chrome--overlay': overlay, 'chrome--with-bar': bar }]} data-chrome>
  <header class="header">
    <div class="header__bar">
      <a class="header__logo" href="/" aria-label="Stride home">
        <StrideLogo tone="dark" class="header__logo-mark" />
      </a>

      <div class="header__actions">
        {/* The current mode, like a camera's mode display. */}
        <span class="header__mode"><span class="header__mode-dot" aria-hidden="true"></span><span class="visually-hidden">Mode: </span>{modes[modeIndex].label}</span>
        <a class="header__contact" href={contactLink.href} data-magnetic>{contactLink.label}</a>
        <button class="header__menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle data-magnetic>
          <span class="header__menu-label">Menu</span>
          <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </div>
  </header>

  {bar && (
    <nav class="division-bar" aria-label={`${bar.name} sections`}>
      <span class="division-bar__name">{bar.name}</span>
      <ul class="division-bar__links" role="list">
        {bar.links.map((l) => <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
      <a class="division-bar__cta" href={bar.cta.href}>{bar.cta.label}</a>
    </nav>
  )}
</div>

{/* Open only on the home page, whose hero is composed around it; tucked everywhere else. */}
<ModeDial current={mode} variant="dock" openAtTop={path === '/'} />

<div class="menu" id="site-menu" data-menu hidden role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="menu__top">
    <a href="/" aria-label="Stride home"><StrideLogo tone="dark" /></a>
    <button class="menu__close" type="button" data-menu-close aria-label="Close menu">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2 2 14" stroke="currentColor" stroke-width="1.6"></path></svg>
    </button>
  </div>

  {/* One panel per mode; the dial below decides which one shows. */}
  <div class="menu__panels">
    {modes.map((m, i) => (
      <section class="menu__panel" data-mode-panel={i} hidden={i !== modeIndex} aria-labelledby={`menu-mode-${i}`}>
        <p class="menu__index" aria-hidden="true">{pad(i + 1)} / {pad(modes.length)}</p>
        <h2 class="menu__mode" id={`menu-mode-${i}`}>
          <a href={m.href} aria-current={mode === m.key ? 'page' : undefined}>
            {m.label}
            <svg class="menu__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
          </a>
        </h2>
        <ul class="menu__links" role="list">
          {m.links.map((link) => (
            <li><a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="menu__foot">
    <a class="menu__contact" href={contactLink.href}>{contactLink.label}</a>
    <ul class="menu__social" role="list">
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul>
  </div>

  <ModeDial current={mode} variant="menu" />
</div>

<style>
  /* ---------- Chrome container (header + division bar move together) ---------- */
  .chrome {
    --chrome-bg: var(--navy-900);
    --chrome-ink: var(--white);
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: transform var(--dur-slow) var(--ease-out);
    view-transition-name: site-chrome;
  }

  .chrome.is-hidden {
    transform: translateY(-100%);
  }

  .header {
    position: relative;
    background: var(--chrome-bg);
    color: var(--chrome-ink);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  /* Over a full-bleed hero the bar is see-through until the page scrolls. */
  .chrome--overlay:not(.is-scrolled) .header {
    background: transparent;
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-h);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .header__logo {
    color: var(--chrome-ink);
  }

  .header__logo :global(.logo) {
    color: inherit;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  .header__contact,
  .header__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: 0 var(--space-5);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .header__contact {
    background: var(--white);
    color: var(--navy-900);
  }

  .header__menu-btn {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    color: var(--chrome-ink);
  }

  .header__contact:hover,
  .header__menu-btn:hover {
    background: var(--ice);
    color: var(--navy-900);
  }

  .header__burger {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .header__burger span {
    height: 1.5px;
    background: currentColor;
  }

  .header__mode {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
  }

  .header__mode-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ice);
  }

  /* ---------- Division sub-bar ---------- */
  .division-bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--division-bar-h);
    padding-inline: var(--margin);
    background: var(--accent);
    color: var(--navy-900);
  }

  .division-bar__name {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .division-bar__links {
    display: flex;
    gap: var(--space-5);
    font-size: var(--type-small);
    font-weight: 500;
  }

  .division-bar__links a:hover,
  .division-bar__links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .division-bar__cta {
    margin-left: auto;
    padding: 6px var(--space-4);
    border-radius: var(--radius);
    background: var(--navy-900);
    color: var(--white);
    font-size: var(--type-small);
    font-weight: 500;
    white-space: nowrap;
  }

  /* ---------- Below desktop ---------- */
  @media (max-width: 1023px) {
    .header__contact {
      display: none;
    }

    .division-bar {
      gap: var(--space-5);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .division-bar__name {
      display: none;
    }

    .division-bar__links {
      flex: none;
    }
  }

  @media (max-width: 479px) {
    .header__menu-btn {
      padding: 0 var(--space-4);
    }

    .division-bar__cta {
      display: none;
    }
  }

  /* ---------- Full-screen menu ----------
     The selected mode's name and pages fill the top; the dial sits in the bottom half. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0 var(--margin);
    background:
      radial-gradient(120% 70% at 50% 110%, rgb(195 242 251 / 0.08), transparent 60%),
      var(--navy-900);
    color: var(--white);
    animation: menu-in 420ms var(--ease-out);
  }

  .menu[hidden] {
    display: none;
  }

  /* Wipes down from the top, like a shutter. */
  @keyframes menu-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  .menu__top {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .menu__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .menu__close:hover {
    background: var(--ice);
    color: var(--navy-900);
  }

  .menu__close svg {
    width: 14px;
  }

  .menu__panels {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-top: clamp(var(--space-4), 4vh, var(--space-7));
    padding-bottom: min(40vh, 300px);
  }

  .menu__panel[hidden] {
    display: none;
  }

  .menu__panel {
    display: grid;
    gap: var(--space-5);
    animation: panel-in 380ms var(--ease-out);
  }

  /* Each mode slides in from the side it turned from, slightly blurred. */
  @keyframes panel-in {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateX(24px);
    }
  }

  .menu__index {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    color: rgb(255 255 255 / 0.55);
  }

  .menu__mode {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8.6vw, 8.5rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.86;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .menu__mode a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.12em;
  }

  .menu__arrow {
    width: 0.4em;
    height: 0.4em;
    color: var(--ice);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .menu__mode a:hover .menu__arrow,
  .menu__mode a:focus-visible .menu__arrow {
    transform: translateX(0.12em);
  }

  .menu__links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-1) var(--gutter);
    max-width: 960px;
  }

  .menu__links a {
    display: inline-block;
    padding: 6px 0;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: rgb(255 255 255 / 0.82);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .menu__links a:hover,
  .menu__links a[aria-current='page'] {
    color: var(--ice);
  }

  .menu__foot {
    position: absolute;
    top: calc(var(--header-h) + var(--space-2));
    right: var(--margin);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-right: 60px;
  }

  .menu__contact {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-5);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy-900);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .menu__social {
    display: flex;
    gap: var(--space-4);
    font-size: var(--type-small);
    color: rgb(255 255 255 / 0.7);
  }

  .menu__social a:hover {
    color: var(--ice);
  }

  @media (max-width: 1023px) {
    /* Contact sits in the top bar, beside the close button. */
    .menu__foot {
      top: calc((var(--header-h) - 40px) / 2);
      margin-right: 56px;
    }
  }

  /* Phones: the dial is the main control, so the panel is compact and the mode name is big. */
  @media (max-width: 767px) {
    .menu__mode {
      font-size: clamp(2.75rem, 15vw, 4.5rem);
      font-stretch: 112%;
    }

    .menu__links {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-5);
    }

    .menu__links a {
      font-size: 0.9375rem;
    }

    .menu__panels {
      padding-bottom: calc(min(116vw, 620px) * 0.56);
    }

    .menu__social {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__panel {
      animation: none;
    }
  }
</style>

<script>
  import { initHeader } from '@/scripts/system/header';
  import { initModeDials } from '@/scripts/system/mode-dial';
  initHeader();
  initModeDials();
</script>
