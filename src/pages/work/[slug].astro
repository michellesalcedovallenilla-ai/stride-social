---
// Case study: the campaign's own reels in a carousel you can spin, the story in a glass card beside them
// (social/CaseReel). Then the shared menu: Results (verified figures only, with source), Creators, More
// Work. Missing parts show a labelled note in preview and are left out in production; unverified figures
// and the previous site's original copy appear only in preview, because they may contain figures nobody
// has confirmed.
import { getCollection, getEntries, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import CaseReel from '@/components/social/CaseReel.astro';
import Deck from '@/components/experience/Deck.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { routes } from '@/lib/routes';
import { rewriteLegacyLinks } from '@/lib/legacy-links';
import { workPreviews } from '@/lib/previews';
import { isPreview } from '@/lib/env';
import { site } from '@/config/site';
import { chunks, htmlParagraphs, paragraphs } from '@/lib/experience';
import type { Card, Media } from '@/lib/experience';

export async function getStaticPaths() {
  const work = (await getCollection('work', (w) => w.data.visible)).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, work, at: i } }));
}

const { entry, work, at } = Astro.props;
const d = entry.data;
const client = await getEntry(d.client);
const clientName = client?.data.name ?? d.title;
const services = await getEntries(d.services);
const industries = await getEntries(d.industries);
const creators = await getEntries(d.creators);
const verified = d.results.filter((r) => r.status === 'verified');
const unverified = d.results.filter((r) => r.status !== 'verified');
const image = d.hero ?? d.card;
const final = (await getEntry('pages', 'social'))?.data.sections.final;

// The story, in pieces that fit beside the phone.
const sections = [
  { label: 'The brief', text: d.brief },
  { label: 'The strategy', text: d.strategy },
  { label: 'The execution', text: d.execution },
].filter((s) => s.text?.trim());
// Entries never split into brief/strategy/execution keep the old page's copy, in preview only.
const legacyOnly = !sections.length;
const legacy = legacyOnly && isPreview ? [{ label: 'The story', parts: htmlParagraphs(rewriteLegacyLinks((entry.body ?? '').replace(/<!--[\s\S]*?-->/g, ''))) }] : [];
const story = [
  ...sections.map((s) => ({ label: s.label, parts: paragraphs(s.text) })),
  ...legacy,
]
  .flatMap((s) => {
    const pieces = s.parts.flatMap((p) => chunks(p)).slice(0, 4);
    return pieces.map((text, i) => ({ label: pieces.length > 1 ? `${s.label} · ${i + 1}` : s.label, heading: i === 0 ? s.label : undefined, text }));
  })
  .slice(0, 8);

const frames: (Media & { caption?: string })[] = d.videos.length
  ? d.videos.map((v) => ({ video: v.src, poster: d.card.src, caption: v.caption ?? undefined }))
  : workPreviews[entry.id]
    ? [{ video: workPreviews[entry.id], poster: d.card.src }, { image: d.card }]
    : [{ image }, ...(d.hero && d.card.src !== d.hero.src ? [{ image: d.card }] : [])];
const facts = [...industries.map((i) => i.data.label), ...d.markets, ...(d.year ? [String(d.year)] : [])];
const chapters = [
  { label: 'The campaign', title: services.map((s) => s.data.name).join(' · ') || 'The campaign', text: d.summary, links: services.map((s) => ({ label: s.data.name, href: routes.service(s.id) })) },
  ...story.map((s) => ({ label: s.label, title: s.heading, text: s.text })),
  // Results join the story only once they're verified.
  ...(verified.length ? [{ label: 'The results', title: 'The results', text: d.resultsSummary ?? '', stats: verified.map((r) => ({ label: r.label, value: r.value })) }] : []),
];

// The menu.
const resultCards: Card[] = verified.map((r) => ({ name: r.value, text: r.label, href: '#results', html: `<p>Source: ${r.source.replace(/</g, '&lt;')}</p>`, stats: [{ label: r.label, value: r.value }] }));
const creatorCards: Card[] = creators.map((c) => ({
  name: c.data.name,
  href: routes.creator(c.id),
  image: c.data.portrait,
  direct: true,
}));
const others = await Promise.all(
  [1, 2, 3, 4].map(async (n) => {
    const w = work[(at + n) % work.length];
    return { name: (await getEntry(w.data.client))?.data.name ?? w.data.title, text: w.data.summary, href: routes.caseStudy(w.id), image: w.data.card, direct: true } as Card;
  }),
);
const quote = d.quote?.status === 'verified' ? d.quote.text : null;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.seo?.title ?? `${clientName} campaign by Stride Social`,
    description: d.summary,
    image: new URL(image.src, site.url).href,
    creator: { '@type': 'Organization', name: 'Stride Social', url: site.url },
    about: { '@type': 'Organization', name: clientName },
  },
];
---

<SiteLayout title={d.seo?.title ?? `${clientName} case study | Stride Social`} description={d.seo?.description ?? d.summary} division="social" ogImage={image.src} jsonLd={jsonLd} look="ice" headerOverlay>
  <CaseReel name={clientName} facts={facts.slice(0, 5)} frames={frames} chapters={chapters} crumbs={[{ label: 'Our Work', href: '/work' }, { label: clientName }]}>
    {isPreview && legacyOnly && <PlaceholderNotice label="Original copy">— from the previous site, awaiting the brief / strategy / execution rewrite (Q6)</PlaceholderNotice>}
    {isPreview && !legacyOnly && unverified.length > 0 && <PlaceholderNotice label="Results awaiting verification">{unverified.map((r) => `${r.label} ${r.value}`).join(' · ')}</PlaceholderNotice>}
  </CaseReel>

  <Deck
    id="case-menu"
    label={`More about ${clientName}`}
    tone="social"
    look="ice"
    tabs={[
      { key: 'results', label: 'Results', icon: 'target', anchor: 'results', cards: resultCards },
      { key: 'quote', label: 'In Their Words', icon: 'quote', cards: quote ? [{ name: clientName, href: '#case-menu', quote, attribution: clientName }] : [] },
      { key: 'creators', label: 'Creators', icon: 'people', cards: creatorCards },
      { key: 'more', label: 'More Work', icon: 'grid', cards: others },
    ]}
    link={{ label: final?.cta?.label ?? 'Talk To Stride Social', href: services[0] ? `/social/enquire?service=${services[0].id}` : '/social/enquire' }}
  />
</SiteLayout>
