---
// Grid of square TalentCards for the case study and creator listings.
// `hero` = featured 2-up row, `four` = 4-up list, `three` = "more campaigns" row.
// Put each card in an <li> in the slot.
export interface Props {
  layout?: 'hero' | 'four' | 'three';
  label?: string;
  class?: string;
}

const { layout = 'four', label, class: className } = Astro.props;
---

<div class:list={['card-grid', `card-grid--${layout}`, className]}>
  <ul class="card-grid__list" aria-label={label}>
    <slot />
  </ul>
</div>

<style>
  .card-grid {
    width: 100%;
  }

  .card-grid--hero {
    padding: 0 45px 1rem;
  }

  .card-grid--four {
    padding: 0 45px 8rem;
  }

  .card-grid__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-grid--hero .card-grid__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card-grid--three .card-grid__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media screen and (max-width: 991px) {
    .card-grid--four .card-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .card-grid--four .card-grid__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media screen and (max-width: 479px) {
    .card-grid--hero,
    .card-grid--four {
      padding-left: 15px;
      padding-right: 15px;
    }

    .card-grid--hero .card-grid__list,
    .card-grid--three .card-grid__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
