---
// Site chrome: header with mega-menu panels, division sub-bar and full-screen mobile menu.
// Spec: docs/phase-2/03-sitemap.md §2. Behaviour: src/scripts/system/header.ts.
import { getCollection } from 'astro:content';
import StrideLogo from '../core/StrideLogo.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { primaryNav, contactLink, divisionBars, type DivisionKey, type MegaMenu } from '@/config/navigation';
import { socials } from '@/config/site';
import { routes } from '@/lib/routes';
import { getRoster } from '@/lib/roster';

export interface Props {
  division: DivisionKey;
  path: string;
  /** Transparent header with light text over a full-bleed dark hero. */
  overlay?: boolean;
}

const { division, path, overlay = false } = Astro.props;

// Feature tiles shown on the right of each mega panel.
const latest = (await getCollection('insights', (p) => p.data.visible && p.data.date !== null)).sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime())[0];
const featuredCase = (await getCollection('work', (w) => w.data.visible && w.data.featuredOn.includes('home'))).sort((a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99))[0];
// Roster tile: a published creator with a portrait (src/lib/roster.ts), so it never links to a profile that isn't built.
const roster = (await getRoster()).filter((c) => c.data.portrait);
const rosterPick = roster.find((c) => c.id === 'aqsaxiqbal') ?? roster[0];
const features: Record<MegaMenu['feature'], { href: string; image: string; eyebrow: string; title: string; interim?: boolean }> = {
  'latest-article': { href: routes.article(latest.id), image: latest.data.cover.src, eyebrow: 'Latest insight', title: latest.data.title },
  'featured-case-study': { href: routes.caseStudy(featuredCase.id), image: (featuredCase.data.hero ?? featuredCase.data.card).src, eyebrow: 'Featured work', title: featuredCase.data.title },
  'roster-portrait': rosterPick
    ? { href: routes.creator(rosterPick.id), image: rosterPick.data.portrait!.src, eyebrow: 'From the roster', title: rosterPick.data.name, interim: rosterPick.data.consent.status !== 'confirmed' }
    : { href: '/talent/roster', image: '/assets/site/b9208d92-stride-social.webp', eyebrow: 'Stride Talent', title: 'Explore the roster' },
  education: { href: '/education', image: '/assets/site/b9208d92-stride-social.webp', eyebrow: 'Stride Education', title: 'Every creator starts somewhere.', interim: true },
};

const groupPaths = ['/about', '/history', '/team', '/sponsorships', '/careers', '/insights'];
const isActive = (item: (typeof primaryNav)[number]) =>
  item.division ? item.division === division : item.label === 'Our Group' ? groupPaths.some((p) => path.startsWith(p)) : path === item.href;
const bar = division !== 'group' ? divisionBars[division] : null;
---

<div class:list={['chrome', { 'chrome--overlay': overlay, 'chrome--with-bar': bar }]} data-chrome>
  <header class="header">
    <div class="header__bar">
      <a class="header__logo" href="/" aria-label="Stride home">
        <StrideLogo tone={overlay ? 'dark' : 'light'} class="header__logo-mark" />
      </a>

      <nav class="header__nav" aria-label="Main">
        <ul class="header__list" role="list">
          {primaryNav.map((item, i) => (
            <li class="header__item">
              {item.menu ? (
                <button
                  class:list={['header__link', { 'is-active': isActive(item) }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`mega-${i}`}
                  data-mega-trigger
                >
                  {item.label}
                  <svg class="header__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
                </button>
              ) : (
                <a class:list={['header__link', { 'is-active': isActive(item) }]} href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <a class="header__contact" href={contactLink.href}>{contactLink.label}</a>
      {bar && <span class="header__chip">{bar.name.replace('Stride ', '')}</span>}
      <button class="header__menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle>
        <span class="header__menu-label">Menu</span>
        <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>

    {primaryNav.map((item, i) => item.menu && (
      <div class="mega" id={`mega-${i}`} data-mega-panel hidden>
        <div class="mega__inner">
          <p class="mega__title">{item.label}</p>
          <div class="mega__cols">
            {item.menu.columns.map((col, c) => (
              <div class:list={['mega__col', { 'mega__col--primary': c === 0 }]}>
                {col.title && <p class="mega__col-title">{col.title}</p>}
                <ul role="list">
                  {col.links.map((link) => (
                    <li>
                      <a class="mega__link" href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                        <span class="mega__link-label">{link.label}</span>
                        {link.description && <span class="mega__link-desc">{link.description}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          {(() => {
            const f = features[item.menu!.feature];
            return (
              <a class="mega__feature" href={f.href}>
                <span class="mega__feature-media">
                  <img src={f.image} alt="" loading="lazy" decoding="async" />
                  {f.interim && <PlaceholderNotice label="Interim image" />}
                </span>
                <span class="mega__feature-eyebrow">{f.eyebrow}</span>
                <span class="mega__feature-title">{f.title}</span>
              </a>
            );
          })()}
        </div>
      </div>
    ))}
  </header>

  {bar && (
    <nav class="division-bar" aria-label={`${bar.name} sections`}>
      <span class="division-bar__name">{bar.name}</span>
      <ul class="division-bar__links" role="list">
        {bar.links.map((l) => <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
      <a class="division-bar__cta" href={bar.cta.href}>{bar.cta.label}</a>
    </nav>
  )}
</div>
<div class="mega-scrim" data-mega-scrim hidden></div>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="mobile-menu__top">
    <a href="/" aria-label="Stride home"><StrideLogo tone="dark" /></a>
    <button class="mobile-menu__close" type="button" data-mobile-close aria-label="Close menu">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2 2 14" stroke="currentColor" stroke-width="1.6"></path></svg>
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label="Main">
    <ul role="list">
      {primaryNav.map((item, i) => (
        <li class="mobile-menu__item">
          {item.menu ? (
            <>
              <button class="mobile-menu__link" type="button" aria-expanded="false" aria-controls={`mobile-sub-${i}`} data-accordion-trigger>
                {item.label}
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.6"></path></svg>
              </button>
              <ul class="mobile-menu__sub" id={`mobile-sub-${i}`} role="list" hidden>
                {item.menu.columns.flatMap((c) => c.links).map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </>
          ) : (
            <a class="mobile-menu__link" href={item.href}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a class="mobile-menu__contact" href={contactLink.href}>{contactLink.label}</a>
    <ul class="mobile-menu__social" role="list">
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul>
  </div>
</div>

<style>
  /* ---------- Chrome container (header + division bar move together) ---------- */
  .chrome {
    --chrome-bg: var(--paper);
    --chrome-ink: var(--navy-900);
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  :global([data-division='social']) .chrome {
    --chrome-bg: var(--navy-900);
    --chrome-ink: var(--white);
  }

  .chrome.is-hidden {
    transform: translateY(-100%);
  }

  .header {
    position: relative;
    background: var(--chrome-bg);
    color: var(--chrome-ink);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .chrome--overlay:not(.is-scrolled):not(.is-open) .header {
    --chrome-ink: var(--white);
    background: linear-gradient(rgb(6 20 43 / 0.45), rgb(6 20 43 / 0));
  }

  .chrome.is-open .header {
    --chrome-bg: var(--navy-900);
    --chrome-ink: var(--white);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-h);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .header__logo {
    color: var(--chrome-ink);
  }

  .header__logo :global(.logo) {
    color: inherit;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 2vw, var(--space-6));
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--chrome-ink);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__link:hover::after,
  .header__link[aria-expanded='true']::after {
    transform: scaleX(1);
  }

  /* Current division / section indicator */
  .header__link.is-active::after {
    background: var(--accent);
    transform: scaleX(1);
    height: 3px;
  }

  .chrome:not(.chrome--overlay) .header__link.is-active::after,
  .chrome.is-scrolled .header__link.is-active::after {
    background: var(--accent-ink);
  }

  :global([data-division='social']) .header__link.is-active::after {
    background: var(--accent) !important;
  }

  .header__chev {
    width: 12px;
    height: 12px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__link[aria-expanded='true'] .header__chev {
    transform: rotate(180deg);
  }

  .header__contact {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius);
    background: var(--chrome-ink);
    color: var(--chrome-bg);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .chrome--overlay:not(.is-scrolled):not(.is-open) .header__contact {
    background: var(--white);
    color: var(--navy-900);
  }

  .header__contact:hover {
    opacity: 0.85;
  }

  .header__chip,
  .header__menu-btn {
    display: none;
  }

  /* ---------- Mega panels ---------- */
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--navy-900);
    color: var(--white);
    border-top: 1px solid var(--line-dark);
    animation: mega-in var(--dur-base) var(--ease-out);
  }

  .mega[hidden] {
    display: none;
  }

  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mega__inner {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: var(--space-7) var(--margin) var(--space-8);
  }

  .mega__title {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }

  .mega__cols {
    grid-column: 1 / 9;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-7);
  }

  .mega__col-title {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }

  .mega__link {
    display: grid;
    gap: 2px;
    padding: 6px 0;
  }

  .mega__link-label {
    font-size: 1rem;
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .mega__col--primary .mega__link-label {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2.125rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .mega__link-desc {
    max-width: 36ch;
    font-size: var(--type-small);
    color: rgb(255 255 255 / 0.7);
  }

  .mega__link:hover .mega__link-label,
  .mega__link[aria-current='page'] .mega__link-label {
    color: var(--accent);
  }

  .mega__feature {
    grid-column: 9 / -1;
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .mega__feature-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--navy-700);
  }

  .mega__feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .mega__feature:hover img {
    transform: scale(1.04);
  }

  .mega__feature-eyebrow {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }

  .mega__feature-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .mega-scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgb(6 20 43 / 0.45);
    animation: fade-in var(--dur-base) var(--ease-out);
  }

  .mega-scrim[hidden] {
    display: none;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  /* ---------- Division sub-bar ---------- */
  .division-bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--division-bar-h);
    padding-inline: var(--margin);
    background: var(--accent);
    color: var(--navy-900);
  }

  .division-bar__name {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .division-bar__links {
    display: flex;
    gap: var(--space-5);
    font-size: var(--type-small);
    font-weight: 500;
  }

  .division-bar__links a:hover,
  .division-bar__links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .division-bar__cta {
    margin-left: auto;
    padding: 6px var(--space-4);
    border-radius: var(--radius);
    background: var(--navy-900);
    color: var(--white);
    font-size: var(--type-small);
    font-weight: 500;
    white-space: nowrap;
  }

  /* ---------- Compact header (below desktop) ---------- */
  @media (max-width: 1119px) {
    .header__nav,
    .header__contact,
    .mega {
      display: none !important;
    }

    .header__chip {
      display: inline-flex;
      margin-left: auto;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--accent);
      color: var(--navy-900);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .header__menu-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      min-height: 44px;
      margin-left: auto;
      color: var(--chrome-ink);
      font-size: 0.9375rem;
      font-weight: 500;
    }

    .header__chip + .header__menu-btn {
      margin-left: var(--space-4);
    }

    .header__burger {
      display: grid;
      gap: 6px;
      width: 22px;
    }

    .header__burger span {
      height: 2px;
      background: currentColor;
    }

    .division-bar {
      gap: var(--space-5);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .division-bar__name {
      display: none;
    }

    .division-bar__links {
      flex: none;
    }
  }

  @media (max-width: 479px) {
    /* Hidden visually on small phones, but kept as the button's accessible name. */
    .header__menu-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .division-bar__cta {
      display: none;
    }
  }

  /* ---------- Mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 0 var(--margin) var(--space-6);
    background: var(--navy-900);
    color: var(--white);
    animation: fade-in var(--dur-base) var(--ease-out);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    flex: none;
  }

  .mobile-menu__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }

  .mobile-menu__close svg {
    width: 18px;
  }

  .mobile-menu__nav {
    flex: 1;
    padding-top: var(--space-5);
  }

  .mobile-menu__item {
    border-bottom: 1px solid var(--line-dark);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1.05;
    text-align: left;
    text-transform: uppercase;
  }

  .mobile-menu__link svg {
    width: 18px;
    flex: none;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .mobile-menu__link[aria-expanded='true'] svg {
    transform: rotate(45deg);
  }

  .mobile-menu__sub {
    display: grid;
    gap: var(--space-1);
    padding: 0 0 var(--space-5);
  }

  .mobile-menu__sub[hidden] {
    display: none;
  }

  .mobile-menu__sub a {
    display: block;
    padding: 10px 0;
    font-size: 1.0625rem;
    color: rgb(255 255 255 / 0.85);
  }

  .mobile-menu__foot {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  .mobile-menu__contact {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--navy-900);
    font-weight: 600;
  }

  .mobile-menu__social {
    display: flex;
    gap: var(--space-5);
    font-size: var(--type-small);
    color: rgb(255 255 255 / 0.75);
  }
</style>

<script>
  import { initHeader } from '@/scripts/system/header';
  initHeader();
</script>
