---
// "Your career. Our commitment.": the eight services the visitor switches on, building their own plan. On
// desktop they're a wall of big outlined words, like a sign before it's lit: the words nearest the pointer
// brighten, the one under it explains itself on the left, and a click lights it. Elsewhere they're glass tiles
// with switches. What they pick goes with them to the application form (/talent/apply?needs=...), where it
// starts their introduction. Behaviour: src/scripts/system/career.ts.

export interface Props {
  headline?: string;
  eyebrow?: string;
  body?: string;
  items: { label: string; copy?: string }[];
  planTitle: string;
  planEmpty: string;
  apply: { label: string; href: string };
}

const { headline, eyebrow, body, items, planTitle, planEmpty, apply } = Astro.props;
---

<section class="career" aria-labelledby="career-title" data-career data-tone="talent" data-look="deep" data-apply={apply.href}>
  <div class="career__inner container-wide">
    <div class="career__side">
      {eyebrow && <p class="exp-label">{eyebrow}</p>}
      <h2 class="career__title exp-title" id="career-title">{headline}</h2>
      <div class="career__say">
        {body && <p class="career__body">{body}</p>}
        <p class="career__peek desk-only" aria-hidden="true" data-career-peek></p>
      </div>
      <div class="career__plan glass" aria-live="polite">
        <p class="career__plan-head"><span class="exp-label">{planTitle}</span><span class="exp-label" data-career-count>0 / {items.length}</span></p>
        <div class="career__bar" aria-hidden="true"><span></span></div>
        <p class="career__empty" data-career-empty>{planEmpty}</p>
        <ol class="career__list" role="list" data-career-list></ol>
        <a class="exp-pill" href={apply.href} data-career-apply>
          {apply.label}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.5M13 6.5 18.5 12 13 17.5"></path></svg>
        </a>
      </div>
    </div>

    <ul class="career__tiles" role="list" data-career-tiles>
      {items.map((item) => (
        <li>
          <button class="career__tile glass" type="button" aria-pressed="false" data-career-tile={item.label} data-copy={item.copy}>
            <span class="career__dot" aria-hidden="true"></span>
            <span class="career__switch" aria-hidden="true"><span></span></span>
            <span class="career__name">{item.label}</span>
            {item.copy && <span class="career__copy">{item.copy}</span>}
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .career {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-6);
    overflow: hidden;
    color: rgb(var(--ink));
  }

  .career__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-6) var(--gutter);
    align-items: center;
    width: 100%;
  }

  .career__side {
    display: grid;
    gap: var(--space-4);
    container-type: inline-size;
  }

  .career__title {
    font-size: clamp(2rem, 11cqi, 4rem);
  }

  .career__body {
    color: rgb(var(--ink) / 0.84);
  }

  .career__plan {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: clamp(18px, 1.8vw, 28px);
  }

  .career__plan-head {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .career__bar {
    width: 100%;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / calc(0.14 * var(--fill-k)));
  }

  .career__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: rgb(var(--tone-lit));
    box-shadow: 0 0 14px rgb(var(--tone-glow) / 0.9);
    transform: scaleX(var(--plan, 0));
    transform-origin: left;
    transition: transform 600ms cubic-bezier(0.2, 1.3, 0.35, 1);
  }

  .career__empty {
    font-size: 0.9375rem;
    color: rgb(var(--ink) / 0.74);
  }

  .career__empty[hidden] {
    display: none;
  }

  .career__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .career__list :global(li) {
    padding: 5px 11px;
    border-radius: 999px;
    background: rgb(var(--tone-lit));
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(var(--tone-on));
    animation: career-pop 480ms cubic-bezier(0.2, 1.6, 0.35, 1);
  }

  @keyframes career-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  .career__tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: clamp(10px, 1.1vw, 16px);
  }

  .career__tile {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    width: 100%;
    height: 100%;
    min-height: clamp(150px, 24svh, 210px);
    padding: clamp(14px, 1.3vw, 20px);
    border-radius: 22px;
    text-align: left;
    color: rgb(var(--ink));
    transition:
      translate 400ms cubic-bezier(0.2, 1.4, 0.35, 1),
      box-shadow 400ms var(--ease-out);
  }

  .career__tile:hover {
    translate: 0 -4px;
  }

  .career__tile:focus-visible {
    outline: 2px solid rgb(var(--tone-lit));
    outline-offset: 3px;
  }

  .career__tile[aria-pressed='true'] {
    box-shadow:
      inset 0 0 0 1.5px rgb(var(--tone-lit) / 0.95),
      0 0 28px -4px rgb(var(--tone-glow) / 0.7),
      0 24px 50px -30px rgb(var(--shade) / 0.8);
  }

  /* A little switch, like the phone's. */
  .career__switch {
    position: relative;
    width: 38px;
    height: 22px;
    margin-bottom: var(--space-2);
    border-radius: 999px;
    background: rgb(var(--ink) / 0.2);
    transition: background-color 300ms var(--ease-out);
  }

  .career__switch span {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 1px 4px rgb(var(--shade) / 0.4);
    transition:
      translate 360ms cubic-bezier(0.2, 1.5, 0.35, 1),
      background-color 300ms var(--ease-out);
  }

  .career__tile[aria-pressed='true'] .career__switch {
    background: rgb(var(--tone-lit));
  }

  .career__tile[aria-pressed='true'] .career__switch span {
    translate: 16px 0;
    background: rgb(var(--tone-on));
  }

  .career__name {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 1.15vw, 1.15rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .career__copy {
    font-size: 0.8125rem;
    line-height: 1.36;
    color: rgb(var(--ink) / 0.78);
  }

  @media (max-width: 1023px) {
    .career__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .career__say {
    display: grid;
  }

  .career__say > * {
    grid-area: 1 / 1;
  }

  .career__dot {
    display: none;
  }

  /* ---------- Desktop: the sign ----------
     No boxes: every service is a line of big outlined type. --near (0 to 1, career.ts) is how close the
     pointer is, and lifts the outline; pressed, the line is lit. */
  @media (min-width: 1024px) {
    :global(.js) .career__inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--gutter);
    }

    :global(.js) .career__say {
      min-height: 6.6em;
      align-content: start;
    }

    :global(.js) .career__body,
    :global(.js) .career__peek {
      font-size: 1.0625rem;
      line-height: 1.45;
      transition:
        opacity 260ms var(--ease-out),
        translate 360ms var(--ease-out);
    }

    :global(.js) .career__peek {
      opacity: 0;
      translate: 0 8px;
      color: var(--white);
    }

    :global(.js) .career.is-peeking .career__body {
      opacity: 0;
      translate: 0 -8px;
    }

    :global(.js) .career.is-peeking .career__peek {
      opacity: 1;
      translate: 0 0;
    }

    /* The plan: no panel, just the count, a hairline filling up, and the button. */
    :global(.js) .career__plan.glass {
      gap: var(--space-4);
      padding: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    :global(.js) .career__bar {
      height: 1px;
      overflow: visible;
      background: rgb(255 255 255 / 0.22);
    }

    :global(.js) .career__bar span {
      height: 2px;
      margin-top: -0.5px;
    }

    :global(.js) .career__empty,
    :global(.js) .career__list {
      display: none;
    }

    :global(.js) .career__tiles {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-left: 30px;
    }

    /* The wire the lines hang from. */
    :global(.js) .career__tiles::before {
      content: '';
      position: absolute;
      inset: 14px auto 14px 5px;
      width: 1px;
      background: linear-gradient(to bottom, transparent, rgb(255 255 255 / 0.24) 8%, rgb(255 255 255 / 0.24) 92%, transparent);
    }

    :global(.js) .career__tile.glass {
      --near: 0;
      display: block;
      min-height: 0;
      height: auto;
      padding: clamp(7px, 1.25svh, 13px) 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      transform: translateX(calc(var(--near) * 16px));
      transition: transform 340ms cubic-bezier(0.2, 1.1, 0.35, 1);
    }

    :global(.js) .career__tile.glass:hover {
      translate: none;
    }

    :global(.js) .career__tile.glass:focus-visible {
      outline: 2px solid var(--white);
      outline-offset: 2px;
    }

    :global(.js) .career__tile.glass[aria-pressed='true'] {
      box-shadow: none;
    }

    :global(.js) .career__switch {
      display: none;
    }

    :global(.js) .career__dot {
      position: absolute;
      top: calc(clamp(7px, 1.25svh, 13px) + 0.72em);
      left: -30px;
      display: block;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--navy-900);
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.5);
      transition:
        background-color 260ms var(--ease-out),
        box-shadow 320ms var(--ease-out);
    }

    :global(.js) .career__tile[aria-pressed='true'] .career__dot {
      background: var(--white);
      box-shadow: 0 0 16px 3px rgb(207 237 248 / 0.75);
    }

    :global(.js) .career__name {
      display: block;
      font-size: min(2.25vw, 4.3svh);
      font-weight: 850;
      font-stretch: var(--stretch-wide);
      line-height: 1.02;
      letter-spacing: -0.015em;
      text-transform: uppercase;
      color: transparent;
      -webkit-text-stroke: 1px rgb(255 255 255 / calc(0.46 + var(--near) * 0.5));
      transition:
        color 220ms var(--ease-out),
        text-shadow 420ms var(--ease-out);
    }

    :global(.js) .career__tile:hover .career__name,
    :global(.js) .career__tile:focus-visible .career__name {
      color: rgb(255 255 255 / 0.14);
    }

    :global(.js) .career__tile[aria-pressed='true'] .career__name {
      color: var(--white);
      -webkit-text-stroke: 1px var(--white);
      text-shadow:
        0 0 26px rgb(207 237 248 / 0.55),
        0 0 70px rgb(207 237 248 / 0.25);
      animation: career-lit 520ms steps(1) 1;
    }

    /* It catches like a sign does: a flicker, then on. */
    @keyframes career-lit {
      0% { opacity: 0.35; }
      18% { opacity: 1; }
      34% { opacity: 0.5; }
      52% { opacity: 1; }
      68% { opacity: 0.78; }
      100% { opacity: 1; }
    }

    /* The words stay for screen readers; on screen they appear on the left. */
    :global(.js) .career__copy {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career__bar span,
    .career__tile,
    .career__switch span {
      transition: none;
    }

    :global(.js) .career__tile.glass {
      transform: none;
    }

    :global(.js) .career__tile[aria-pressed='true'] .career__name {
      animation: none;
    }

    .career__list :global(li) {
      animation: none;
    }

    .career__tile:hover {
      translate: none;
    }
  }
</style>

<script>
  import { initCareers } from '@/scripts/system/career';
  initCareers();
</script>
