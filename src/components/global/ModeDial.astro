---
// The camera mode dial: the site's main navigation selector, styled as a matte, knurled control
// with engraved mode names and a fixed marker. Two placements share one behaviour
// (src/scripts/system/mode-dial.ts):
// - `dock` (desktop, every page): half the dial at the left edge, the marker at 3 o'clock. Turning
//   it (drag, wheel, swipe, arrow keys) snaps to a mode; resting on a new mode goes to its page.
// - `menu` (inside the full-screen menu, every width): half the dial at the bottom, the marker at
//   12 o'clock. Turning it previews that mode's pages; choosing the active mode goes there.
// Every mode is a real link, so clicking a name or tabbing to it works without dragging.
import { modes, type ModeKey } from '@/config/navigation';

export interface Props {
  current: ModeKey;
  variant: 'dock' | 'menu';
  /** Dock only: start open at the top of the page (the home hero leaves room for it); otherwise it rests tucked. */
  openAtTop?: boolean;
}

const { current, variant, openAtTop = false } = Astro.props;
const index = Math.max(0, modes.findIndex((m) => m.key === current));
const id = `dial-${variant}`;
---

<nav
  class:list={['dial', `dial--${variant}`]}
  aria-label={variant === 'dock' ? 'Modes' : 'Choose a mode'}
  data-dial={variant}
  data-current={index}
  data-open-at-top={openAtTop ? '' : undefined}
  data-lenis-prevent
  style={`--count: ${modes.length}; --index: ${index}`}
>
  <div class="dial__body" data-dial-body>
    <div class="dial__disc" data-dial-disc>
      <span class="dial__knurl" aria-hidden="true"></span>
      <span class="dial__face" aria-hidden="true"></span>
      <ol class="dial__modes" role="list">
        {modes.map((m, i) => (
          <li class="dial__mode" style={`--i: ${i}`}>
            <a
              class="dial__label"
              href={m.href}
              data-dial-mode={i}
              data-mode-key={m.key}
              aria-current={i === index ? 'page' : undefined}
              aria-describedby={`${id}-hint`}
              tabindex={i === index ? 0 : -1}
            >{m.label}</a>
          </li>
        ))}
      </ol>
    </div>
    {/* The fixed index mark the modes turn to; it fills while a new mode is about to open. */}
    <span class="dial__marker" aria-hidden="true"><span class="dial__marker-fill" data-dial-commit></span></span>
  </div>
  <p class="dial__hint" id={`${id}-hint`}>
    {variant === 'dock' ? 'Turn or use the arrow keys; Enter opens' : 'Swipe to turn; tap the highlighted mode to open'}
  </p>
  <p class="dial__status" aria-live="polite" data-dial-status></p>
</nav>

<style>
  /* ---------- Shared geometry ----------
     Modes sit around the disc every --step degrees; the disc turns by --angle (set by the script,
     starting on the current page's mode) so the selected mode faces the marker. */
  .dial {
    --step: 26deg;
    --size: 360px;
    --angle: calc(var(--index) * var(--step) * -1);
    --metal: #0c0f15;
    --metal-hi: #262b35;
    --engrave: rgb(255 255 255 / 0.62);
    position: fixed;
    z-index: 95;
    color: var(--white);
    font-family: var(--font-mono);
    -webkit-tap-highlight-color: transparent;
  }

  .dial__body {
    position: relative;
    width: var(--size);
    height: var(--size);
  }

  .dial__disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform: rotate(var(--angle));
    touch-action: none;
    cursor: grab;
    user-select: none;
  }

  .dial.is-dragging .dial__disc {
    cursor: grabbing;
  }

  /* Knurled rim: fine radial ridges, lit from the top left. */
  .dial__knurl {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      repeating-conic-gradient(from 0deg, rgb(255 255 255 / 0.14) 0deg 0.9deg, rgb(0 0 0 / 0.5) 0.9deg 3deg),
      radial-gradient(circle at 30% 25%, var(--metal-hi), var(--metal) 70%);
    box-shadow:
      0 18px 40px rgb(0 0 0 / 0.45),
      inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  /* Matte face inside the rim, with a soft machined sheen. */
  .dial__face {
    position: absolute;
    inset: 7%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 26%, rgb(255 255 255 / 0.07), transparent 46%),
      repeating-radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 3px),
      var(--metal);
    box-shadow:
      inset 0 2px 3px rgb(255 255 255 / 0.06),
      inset 0 -6px 14px rgb(0 0 0 / 0.6);
  }

  .dial__modes {
    position: absolute;
    inset: 0;
  }

  .dial__mode {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
  }

  /* Engraved type: light from above, a dark cut below. */
  .dial__label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 10px;
    border-radius: 999px;
    color: var(--engrave);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow:
      0 -1px 0 rgb(0 0 0 / 0.85),
      0 1px 0 rgb(255 255 255 / 0.08);
    opacity: 0.5;
    transition:
      opacity var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  /* The selected mode: full strength, on a white pill, straight to the reader. */
  .dial__label.is-selected {
    opacity: 1;
    background: var(--white);
    color: var(--navy-900);
    text-shadow: none;
  }

  .dial__label:focus-visible {
    outline: 2px solid var(--ice);
    outline-offset: 2px;
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .dial__label:not(.is-selected):hover {
      opacity: 0.9;
      color: var(--ice);
    }
  }

  /* The marker: a small cyan index notch that never turns. */
  .dial__marker {
    position: absolute;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(195 242 251 / 0.35);
    transition: transform 120ms var(--ease-out);
  }

  .dial__marker-fill {
    position: absolute;
    inset: 0;
    background: var(--ice);
    transform-origin: left;
    transform: scaleX(var(--commit, 1));
  }

  /* Detent "click": the marker nudges for a beat each time a mode passes it. */
  .dial.is-ticking .dial__marker {
    transform: var(--tick-shift);
  }

  .dial__hint,
  .dial__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- Dock: left edge, marker at 3 o'clock ----------
     Labels run outward along the radius, so the one at the marker reads level. */
  .dial--dock {
    --size: 380px;
    top: 50%;
    left: 0;
    translate: calc(var(--size) * -0.62) -50%;
    transition: translate var(--dur-slow) var(--ease-out);
    view-transition-name: mode-dial;
  }

  /* Pivot on the disc centre: move out along the radius, then turn to the mode's angle. */
  .dial--dock .dial__label {
    top: 0;
    left: 0;
    transform-origin: 0 0;
    transform: rotate(calc(var(--i) * var(--step))) translate(calc(var(--size) * 0.15), -50%);
  }

  .dial--dock .dial__marker {
    top: calc(50% - 1.5px);
    left: calc(100% + 6px);
    width: 18px;
    height: 3px;
    --tick-shift: translateX(3px);
  }

  /* Tucked to its rim and marker while you read; hover or keyboard focus brings the whole dial out. */
  .dial--dock.is-tucked:not(:hover):not(:focus-within):not(.is-dragging) {
    translate: calc(var(--size) * -0.94) -50%;
  }

  /* ---------- Menu: bottom centre, marker at 12 o'clock ----------
     Labels follow the rim, so the one at the marker sits upright. */
  .dial--menu {
    --size: min(116vw, 620px);
    --step: 30deg;
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 48%;
  }

  /* Pivot on the disc centre: centre on the radius, move up to the rim, then turn. */
  .dial--menu .dial__label {
    top: 0;
    left: 0;
    min-height: 40px;
    padding: 0 16px;
    font-size: clamp(0.8125rem, 3.4vw, 1rem);
    transform-origin: 0 0;
    transform: rotate(calc(var(--i) * var(--step))) translate(-50%, calc(-50% - var(--size) * 0.39));
  }

  .dial--menu .dial__marker {
    top: -18px;
    left: calc(50% - 1.5px);
    width: 3px;
    height: 14px;
    --tick-shift: translateY(-3px);
  }

  .dial--menu .dial__marker-fill {
    transform-origin: bottom;
    transform: scaleY(var(--commit, 1));
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .dial--dock,
    .dial__marker {
      transition: none;
    }
  }

  /* The dock is a desktop control; smaller screens use the menu's dial. */
  @media (max-width: 1023px) {
    .dial--dock {
      display: none;
    }
  }
</style>
