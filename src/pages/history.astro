---
// Our History (brief §7: a timeline beginning with the founding, with verified milestones and
// photography): a road you travel sideways (group/HistoryRoad). Milestones: src/content/history; only
// verified ones in production, preview also shows the previous site's until Stride confirms them (Q1).
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import HistoryRoad from '@/components/group/HistoryRoad.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { paragraphs } from '@/lib/experience';
import { isPreview } from '@/lib/env';

const s = (await getEntry('pages', 'history'))?.data.sections;
if (!s) throw new Error('Missing src/content/pages/history.yaml');
const copy = s.hero;
const more = (await getEntry('pages', 'about'))?.data.sections.more?.items ?? [];
const milestones = (await getCollection('milestones', (m) => m.data.status === 'verified' || isPreview))
  .sort((a, b) => a.data.order - b.data.order)
  .map((m) => ({ id: m.id, year: m.data.year, title: m.data.title, body: paragraphs(m.data.body), image: m.data.image }));
const next = more.filter((m) => m.href !== '/history').map((m) => ({ label: m.label, copy: m.copy, href: m.href ?? '/' }));
---

<SiteLayout title="Our History | Stride" description={copy.body} headerOverlay>
  <HistoryRoad copy={copy} milestones={milestones} next={next} hint={s.road?.body ?? 'Scroll or drag along the road'} crumbs={[{ label: 'About', href: '/about' }, { label: 'Our History' }]}>
    {isPreview && <PlaceholderNotice variant="inline" label="Founding year to reconcile">— the brief says 2022; the previous site's timeline starts in 2018 and names 2020 (Q1)</PlaceholderNotice>}
  </HistoryRoad>
</SiteLayout>
