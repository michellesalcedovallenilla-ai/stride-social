---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CreatorProfile from '@/components/portfolio/CreatorProfile.astro';
import { creatorLd } from '@/components/portfolio/jsonld';
import { footerCtas } from '@/config/site';

export async function getStaticPaths() {
  const creators = await getCollection('creators', (c) => c.data.profile);
  return creators.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'creators'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const photo = data.image;
---

<BaseLayout
  title={data.seo?.title ?? `${data.name} is managed by Stride Social`}
  description={data.seo?.description}
  ogImage={data.seo?.ogImage ?? photo}
  nav="solid"
  background="smoke"
  footerCta={footerCtas.standard}
  jsonLd={[creatorLd(entry, photo)]}
>
  <CreatorProfile
    name={data.name}
    image={photo}
    type={data.type}
    category={data.category}
    followers={data.followers}
    biggestChannel={data.biggestChannel}
    relationship={data.relationship}
    socials={data.socials}
  >
    <Content />
  </CreatorProfile>
</BaseLayout>
