---
// Two-column story section on a smoke panel: a sticky media column whose image card flips
// into place the first time it scrolls into view, beside a column of tagged blocks and
// sticky StoryItem cards (default slot). Used by Our services, Influencer seeding and
// Influencer strategies.
export interface Props {
  image: { src: string; alt: string };
  /** Background of the media panel. */
  media?: 'navy' | 'light' | 'clear';
  /** `wide`: 70% card at 100:81; `full`: full-width square card (90% on phones). */
  card?: 'wide' | 'full';
  /** Column split: equal halves or 1fr / 1.5fr. */
  columns?: 'equal' | 'list-wide';
  /** 45px inset before the media column. */
  inset?: boolean;
  /** Space above the panel content: 9rem (huge) or 4rem (regular). */
  top?: 'huge' | 'regular';
  /** Smaller top padding for the list column (strategies accordion). */
  tightList?: boolean;
}

const { image, media = 'navy', card = 'wide', columns = 'equal', inset = true, top = 'huge', tightList = false } = Astro.props;
---

<section class:list={['story', `story--top-${top}`]}>
  <div class:list={['story__grid', `story__grid--${columns}`, { 'story__grid--inset': inset }]}>
    <div class="story__aside">
      <div class:list={['story__media', `story__media--${media}`]} data-reveal>
        <div class:list={['rotate-card', `rotate-card--${card}`]}>
          <div class="rotate-card__item">
            <div class="rotate-card__image">
              <img class="cover-image" src={image.src} alt={image.alt} loading="lazy" decoding="async" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class:list={['story__list', { 'story__list--tight': tightList }]}>
      <slot />
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    z-index: 1;
    padding-bottom: 4.5rem;
    background-color: var(--color-smoke);
  }

  .story--top-huge {
    padding-top: 9rem;
  }

  .story--top-regular {
    padding-top: 4rem;
  }

  .story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    row-gap: 16px;
    margin-top: -1rem;
  }

  .story__grid--list-wide {
    grid-template-columns: 1fr 1.5fr;
  }

  .story__grid--inset {
    padding-left: 45px;
  }

  .story__aside {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: 100vh;
    padding: 1rem 0;
  }

  .story__media {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .story__media--navy {
    background-color: var(--color-navy);
  }

  .story__media--light {
    background-color: var(--color-smoke-2);
  }

  .story__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    padding: 5rem 0 4rem 4.5rem;
  }

  .story__list--tight {
    padding-top: 1rem;
  }

  /* Image card */
  .rotate-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 70%;
    height: 100%;
  }

  .rotate-card--full {
    width: 100%;
  }

  .rotate-card__item {
    display: flex;
    flex-direction: column;
    width: 100%;
    perspective: 200vw;
  }

  .rotate-card__image {
    position: relative;
    width: 100%;
    aspect-ratio: 100 / 81;
    overflow: hidden;
  }

  .rotate-card--full .rotate-card__image {
    aspect-ratio: 1;
  }

  /* Flip-in entrance (Webflow IX2 "scroll into view"): slides up from 85% while the inner
     card scales up from 65% and unwinds from rotateY(180deg) rotateZ(25deg). */
  :global(.js) .rotate-card {
    opacity: 0;
    transform: translate3d(0, 85%, 0);
    transition:
      opacity 0.6s ease,
      transform 1.6s var(--ease-out);
  }

  :global(.js) .rotate-card__item {
    transform: scale3d(0.65, 0.65, 1) rotateY(180deg) rotateZ(25deg);
    transition: transform 1.8s var(--ease-out);
  }

  :global(.js) .is-revealed .rotate-card {
    opacity: 1;
    transform: none;
  }

  :global(.js) .is-revealed .rotate-card__item {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .rotate-card,
    :global(.js) .rotate-card__item {
      opacity: 1;
      transform: none;
    }
  }

  @media screen and (max-width: 991px) {
    .story__grid,
    .story__grid--list-wide {
      grid-template-columns: 1fr;
    }

    .story__aside {
      position: relative;
    }

    .story__media--navy,
    .story__media--light,
    .story__media--clear {
      padding: 2rem 0;
    }

    .story__list {
      padding: 2rem 0 2rem 2rem;
    }

    .story__list--tight {
      padding-top: 1rem;
    }
  }

  @media screen and (max-width: 767px) {
    .story {
      padding-inline: 22px;
    }

    .story__grid,
    .story__grid--inset {
      row-gap: 0;
      padding-left: 0;
    }

    .story__list {
      padding: 1.25rem 0 1.5rem;
    }

    .story__list--tight {
      padding-top: 1rem;
    }
  }

  @media screen and (max-width: 479px) {
    .story {
      padding-inline: 15px;
    }

    .story--top-huge {
      padding-top: 2rem;
    }

    .rotate-card--full .rotate-card__item {
      width: 90%;
    }
  }
</style>

