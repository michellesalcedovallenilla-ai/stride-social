{
  "name": "stride-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Independent rebuild of stride-social.com, structured for the Stride Social / Talent / Education divisions.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/checks/links.mjs",
    "check:placeholders": "node scripts/checks/placeholders.mjs",
    "check:content": "node scripts/checks/content.mjs",
    "ci": "npm run check && npm run build && npm run check:links && npm run check:placeholders && npm run check:content",
    "migrate:content": "node scripts/migrate/extract-content.mjs",
    "migrate:assets": "node scripts/migrate/download-assets.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^5.18.2",
    "lenis": "^1.3.27",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "cheerio": "^1.2.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
