---
// Flag dropdown mirroring Webflow Localization. Locales not migrated yet link to the live site.
import { locales } from '@/config/site';

export interface Props {
  path: string;
  current?: string;
}

const { path, current = 'en' } = Astro.props;
const active = locales.find((l) => l.code === current) ?? locales[0];
---

<div class="locale" data-dropdown>
  <button class="locale__toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Change language" data-dropdown-toggle>
    <img class="locale__flag" src={active.flag} alt="" width="27" height="27" />
    <svg class="locale__chevron" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 5.25 7 8.75l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
  </button>
  <ul class="locale__list" data-dropdown-list>
    {locales.map((l) => (
      <li>
        <a class:list={['locale__link', { 'is-current': l.code === active.code }]} href={l.href(path)} hreflang={l.code} lang={l.code}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .locale {
    position: absolute;
    top: 15px;
    right: 110px;
    /* Stays above the open menu panel, as on the live site. */
    z-index: 3;
    font-family: var(--font-sans);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .locale__toggle {
    display: flex;
    align-items: center;
    height: 4rem;
    padding: 14px 30px 14px 20px;
    color: var(--color-navy);
  }

  .locale__flag {
    width: 1.7rem;
    margin-right: 10px;
  }

  .locale__chevron {
    position: absolute;
    right: 20px;
    width: 14px;
    height: 14px;
  }

  .navbar--transparent .locale__chevron {
    color: #222;
  }

  .locale__list {
    position: absolute;
    top: 100%;
    left: 0;
    display: none;
    min-width: 100%;
    margin: 0;
    padding: 0 20px;
    list-style: none;
    background-color: var(--color-smoke-2);
  }

  .locale.is-open .locale__list,
  .locale:hover .locale__list {
    display: block;
  }

  .locale__link {
    display: block;
    padding: 10px 0;
    white-space: nowrap;
    color: var(--color-navy);
  }

  @media screen and (max-width: 479px) {
    .locale {
      right: 66px;
    }

    .locale__toggle {
      height: 3.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dd) => {
    const toggle = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    toggle?.addEventListener('click', () => {
      const open = !dd.classList.contains('is-open');
      dd.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) dd.classList.remove('is-open');
    });
  });
</script>
