---
// Full-height ice-blue call to action that sits behind the page (sticky bottom, z-index 0)
// and is revealed as the last section scrolls away.
export type FooterCtaProps = {
  /** Lines of the heading; rendered with a blank line between them like the live site. */
  heading: readonly string[];
  links: readonly { readonly label: string; readonly href: string }[];
};

export interface Props extends FooterCtaProps {}

const { heading, links } = Astro.props;
---

<section class="footer-cta" aria-label="Get in touch">
  <div class="footer-cta__inner">
    <div class="footer-cta__content">
      <p class="footer-cta__heading">
        {heading.map((line, i) => (
          <>
            {i > 0 && (
              <>
                <br />
                <br />
              </>
            )}
            {line}
          </>
        ))}
      </p>
      <div class="footer-cta__buttons">
        {links.map((l) => (
          <a class="footer-cta__button" href={l.href} target={/^https?:/.test(l.href) ? '_blank' : undefined} rel={/^https?:/.test(l.href) ? 'noopener' : undefined}>
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .footer-cta {
    position: sticky;
    bottom: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    padding-top: 5rem;
    background-color: var(--accent);
  }

  .footer-cta__inner {
    position: sticky;
    top: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-inline: 45px;
  }

  .footer-cta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3em;
    max-width: 1580px;
  }

  .footer-cta__heading {
    font-family: var(--font-sans);
    font-size: 11dvh;
    font-weight: 900;
    line-height: 0.85;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .footer-cta__buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2rem;
  }

  .footer-cta__button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.2em 35px;
    border-radius: var(--radius-button);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-white);
    background-color: var(--color-navy);
    transition: background-color 0.2s;
  }

  .footer-cta__button:hover {
    color: #616161;
    background-color: #efffa6;
  }

  @media screen and (max-width: 991px) {
    .footer-cta__heading {
      font-size: 8dvh;
    }

    .footer-cta__button {
      padding: 18px 40px;
    }
  }

  @media screen and (max-width: 767px) {
    .footer-cta__heading {
      font-size: 7dvh;
    }

    .footer-cta__button {
      width: 100%;
      font-size: 16px;
    }
  }

  @media screen and (max-width: 479px) {
    .footer-cta {
      min-height: 90vh;
    }

    .footer-cta__heading {
      font-size: 12vw;
      line-height: 1;
    }

    .footer-cta__button {
      padding-inline: 25px;
    }
  }
</style>
