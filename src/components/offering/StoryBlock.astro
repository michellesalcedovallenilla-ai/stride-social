---
// Tagged heading block in the story column.
//   intro   – tag, heading and a short paragraph in a narrow column (Our services)
//   block   – tag + heading, then copy and a tall spacer (Influencer seeding "What we do")
//   heading – tag + heading only (lead-in to a list of StoryItem steps)
// `spaced` adds the large gap the live page leaves before the first sticky item.
import TitleTag from './TitleTag.astro';
import StoryCopy from './StoryCopy.astro';

export interface Props {
  label: string;
  heading: string;
  html?: string;
  variant?: 'intro' | 'block' | 'heading';
  spaced?: boolean;
}

const { label, heading, html, variant = 'intro', spaced = false } = Astro.props;
---

{variant === 'block' ? (
  <div class:list={['story-block', 'story-block--block', { 'story-block--spaced': spaced }]}>
    <div class="story-block__head">
      <div class="story-block__tag"><TitleTag>{label}</TitleTag></div>
      <h2 class="story-block__heading" data-split="letters-slide-up">{heading}</h2>
    </div>
    <div class="story-block__body">
      {html && <StoryCopy html={html} />}
      <div class="story-block__spacer"></div>
    </div>
  </div>
) : (
  <div class:list={['story-block', `story-block--${variant}`, { 'story-block--spaced': spaced }]}>
    <div class="story-block__tag"><TitleTag>{label}</TitleTag></div>
    <div class="story-block__top">
      <h2 class="story-block__heading" data-split="letters-slide-up">{heading}</h2>
      {variant === 'intro' && html && (
        <div class="story-block__copy">
          <StoryCopy html={html} />
        </div>
      )}
    </div>
  </div>
)}

<style>
  .story-block--spaced {
    margin-bottom: 5.5rem;
  }

  .story-block__tag {
    padding-bottom: 3rem;
  }

  .story-block__top {
    max-width: 30rem;
  }

  .story-block__heading {
    font-family: var(--font-sans);
    font-size: 3.6rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .story-block__copy {
    padding-top: 2rem;
  }

  .story-block--block {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    max-width: 36rem;
  }

  .story-block__head {
    margin-bottom: 3rem;
  }

  .story-block__body {
    max-width: 30rem;
    padding-bottom: 2rem;
  }

  .story-block__spacer {
    height: 8rem;
  }

  @media screen and (max-width: 991px) {
    .story-block__top {
      max-width: 25rem;
    }
  }

  @media screen and (max-width: 767px) {
    .story-block__top {
      max-width: 20rem;
    }

    .story-block__heading {
      font-size: 2.8rem;
    }
  }

  @media screen and (max-width: 479px) {
    .story-block__heading {
      font-size: 2.2rem;
      color: var(--color-navy);
    }
  }
</style>
