---
// Stride Education landing; the page's content is shared with the homepage's Education card
// (components/education/EducationPage.astro).
import { getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import EducationPage from '@/components/education/EducationPage.astro';

const page = await getEntry('pages', 'education');
if (!page) throw new Error('Missing src/content/pages/education.yaml');
---

<SiteLayout title="Stride Education | Creator Development" description={page.data.sections.hero.body} division="education" look="slate" headerOverlay>
  <EducationPage />
</SiteLayout>
