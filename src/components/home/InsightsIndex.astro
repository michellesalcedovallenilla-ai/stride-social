---
// Homepage section 5 "Insights": the contents page of the latest articles. The newest sits on the
// left as the lead (cover, meta, headline); the next four run down the right as numbered rows.
import Eyebrow from '../core/Eyebrow.astro';
import Button from '../core/Button.astro';
import { getArticles, categoryLabels } from '@/lib/insights';
import { routes } from '@/lib/routes';

export interface Props {
  copy: { eyebrow?: string; headline?: string; cta?: { label: string; href: string } };
}

const { copy } = Astro.props;

// The migrated archive re-published a few articles under the same title; show each title once.
const titleKey = (t: string) => t.trim().toLowerCase();
const articles = (await getArticles())
  .filter((p, i, all) => all.findIndex((q) => titleKey(q.data.title) === titleKey(p.data.title)) === i)
  .slice(0, 5);
const [lead, ...list] = articles;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---

{lead && (
  <section class="insights" aria-labelledby="insights-title">
    <div class="insights__inner container-wide">
      <header class="insights__head">
        <div class="insights__running">
          <Eyebrow tone="dark">{copy.eyebrow}</Eyebrow>
          <h2 class="insights__title" id="insights-title" data-reveal-lines>{copy.headline}</h2>
        </div>
        {copy.cta && <Button href={copy.cta.href} variant="text" tone="dark">{copy.cta.label}</Button>}
      </header>

      <div class="insights__spread">
        <article class="insights__lead" data-reveal="rise">
          {/* The headline below is the accessible link; the cover repeats it, so it is hidden from AT. */}
          <a class="insights__frame" href={routes.article(lead.id)} aria-hidden="true" tabindex="-1">
            <img src={lead.data.cover.src} alt="" sizes="(max-width: 1023px) 100vw, 50vw" loading="lazy" decoding="async" />
          </a>
          <p class="insights__meta">
            <span>{categoryLabels[lead.data.category]}</span>
            {lead.data.date && <time datetime={isoDate(lead.data.date)}>{fmt.format(lead.data.date)}</time>}
          </p>
          <h3 class="insights__lead-title"><a href={routes.article(lead.id)}><span class="insights__lead-text">{lead.data.title}</span></a></h3>
        </article>

        {list.length > 0 && (
          <ol class="insights__list" role="list">
            {list.map((p, i) => (
              <li class="insights__row" data-reveal="rise" style={`--reveal-delay: ${(i + 1) * 0.08}s`}>
                <article class="insights__entry">
                  {/* Visual folio only: the list already conveys position, and the lead is 01. */}
                  <span class="insights__index" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
                  <div class="insights__entry-body">
                    <p class="insights__meta">
                      <span>{categoryLabels[p.data.category]}</span>
                      {p.data.date && <time datetime={isoDate(p.data.date)}>{fmt.format(p.data.date)}</time>}
                    </p>
                    <h3 class="insights__row-title"><a href={routes.article(p.id)}>{p.data.title}</a></h3>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .insights {
    position: relative;
    z-index: 1;
    padding-block: clamp(56px, 7vw, 128px);
    background: var(--navy-900);
    color: var(--white);
  }

  /* Folio rule: the section opens on a hairline, with the running head beneath it. */
  .insights__inner {
    border-top: 1px solid var(--line-dark);
  }

  /* ---------- Running head ---------- */
  .insights__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .insights__running {
    display: grid;
    gap: var(--space-4);
  }

  .insights__title {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: 750;
    font-stretch: var(--stretch-normal);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* ---------- Spread ---------- */
  .insights__spread {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--gutter);
    align-items: start;
  }

  .insights__lead {
    grid-column: 1 / 7;
  }

  .insights__list {
    grid-column: 7 / -1;
  }

  .insights__frame {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy-700);
  }

  .insights__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .insights__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }

  .insights__meta time::before {
    content: '·';
    margin-right: 0.6em;
  }

  .insights__lead .insights__meta {
    margin-top: var(--space-4);
  }

  /* The two-line clamp sits on an inner span, so the link's focus ring is never clipped. */
  .insights__lead-text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .insights__lead-title {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 800;
    font-stretch: var(--stretch-normal);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* ---------- Numbered rows ---------- */
  .insights__entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--line-dark);
  }

  .insights__row:last-child .insights__entry {
    border-bottom: 1px solid var(--line-dark);
  }

  .insights__index {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }

  .insights__entry-body {
    display: grid;
    gap: var(--space-2);
  }

  .insights__row-title {
    font-family: var(--font-text);
    font-size: var(--type-h3);
    font-weight: 600;
    line-height: 1.2;
  }

  .insights__lead-title a,
  .insights__row-title a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  /* ---------- Hover (fine pointers) ---------- */
  @media (hover: hover) and (pointer: fine) {
    .insights__lead:has(a:hover) img,
    .insights__lead:has(a:focus-visible) img {
      transform: scale(1.04);
    }

    .insights__lead:has(a:hover) .insights__lead-title a,
    .insights__row-title a:hover {
      text-decoration: underline;
      text-decoration-color: var(--ice);
    }
  }

  /* Same selectors as the hover rule so this one wins and the cover stays still. */
  @media (prefers-reduced-motion: reduce) {
    .insights__lead:has(a:hover) img,
    .insights__lead:has(a:focus-visible) img {
      transform: none;
    }
  }

  /* ---------- Tablet / phone: lead above the list ---------- */
  @media (max-width: 1023px) {
    .insights__lead,
    .insights__list {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .insights__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      margin-bottom: var(--space-7);
    }

    .insights__spread {
      row-gap: var(--space-6);
    }

    .insights__lead-title {
      font-size: clamp(1.5rem, 7vw, 2rem);
    }
  }
</style>
