---
// About Stride (brief §7: company, business model, mission, values, international presence): the story
// on a dial you can drag through time (group/TimeDial), then the shared menu: Our Team, Three Sides,
// More. Milestones are verified only in production. Mission and values must be Stride's own:
// nothing is drafted, and only a preview note stands in for them.
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import TimeDial from '@/components/group/TimeDial.astro';
import Deck from '@/components/experience/Deck.astro';
import PlaceholderNotice from '@/components/core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';
import { asHtml, chunks, paragraphs } from '@/lib/experience';
import type { Card } from '@/lib/experience';

const page = await getEntry('pages', 'about');
const home = await getEntry('pages', 'home');
if (!page || !home) throw new Error('Missing src/content/pages/about.yaml or home.yaml');
const s = page.data.sections;
const sides = home.data.sections.sides.items ?? [];
const story = paragraphs(s.founders.body);
const markets = await getCollection('markets', (m) => m.data.status === 'verified');
const talentMarkets = markets.filter((m) => m.data.roles.includes('talent-market')).map((m) => m.data.label);
const team = (await getCollection('team', (m) => m.data.visible)).sort((a, b) => a.data.order - b.data.order);
const milestones = (await getCollection('milestones', (m) => m.data.status === 'verified' || isPreview)).sort((a, b) => a.data.order - b.data.order);
const more = s.more.items ?? [];

const steps = [
  { mark: 'Stride', title: s.hero.headline, text: s.hero.body },
  ...(milestones.length
    ? [
        { mark: s.founders.eyebrow ?? 'Our story', title: s.founders.headline, text: story[0] ? chunks(story[0], 360)[0] : undefined },
        ...milestones.map((m) => ({ mark: String(m.data.year), title: m.data.title, text: chunks(paragraphs(m.data.body)[0] ?? '', 360)[0], image: m.data.image })),
      ]
    : story.flatMap((p, i) => chunks(p, 360).map((text, k) => ({ mark: s.founders.eyebrow ?? 'Our story', title: i === 0 && k === 0 ? s.founders.headline : undefined, text })))),
  ...(talentMarkets.length ? [{ mark: s.presence.eyebrow ?? 'Where we work', title: s.presence.headline, chips: talentMarkets }] : []),
];

const teamCards: Card[] = [
  ...team.slice(0, 11).map((m) => ({
    name: m.data.name,
    text: m.data.role,
    href: '/team',
    image: m.data.photo,
    html: m.data.bio ? asHtml(paragraphs(m.data.bio)) : undefined,
    action: m.data.linkedin ? { label: 'LinkedIn', href: m.data.linkedin, external: true } : undefined,
  })),
  { name: more[1]?.label ?? 'Our Team', text: more[1]?.copy, href: more[1]?.href ?? '/team', direct: true },
];
const sideCards: Card[] = sides.map((side) => ({
  name: `Stride ${side.label}`,
  text: side.copy,
  href: side.href ?? '/',
  chips: [side.audience ?? ''].filter(Boolean),
  action: { label: side.cta ?? `Explore Stride ${side.label}`, href: side.href ?? '/' },
}));
const moreCards: Card[] = more.map((m) => ({ name: m.label, text: m.copy, href: m.href ?? '/', direct: true }));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Stride',
    description: s.hero.body,
  },
];
---

<SiteLayout title="About Stride | Creators, Brands and Education" description={s.hero.body} jsonLd={jsonLd} headerOverlay>
  <TimeDial steps={steps} crumbs={[{ label: 'About' }]}>
    {isPreview && <PlaceholderNotice label="Needed from Stride">{(s.mission.awaiting ?? []).join(' · ')}</PlaceholderNotice>}
  </TimeDial>

  <Deck
    id="about-menu"
    label="More about Stride"
    tone="group"
    look="frost"
    tabs={[
      { key: 'team', label: more[1]?.label ?? 'Our Team', icon: 'people', cards: teamCards },
      { key: 'sides', label: s.model.headline?.replace(/\.$/, '') ?? 'Three sides of Stride', icon: 'layers', cards: sideCards },
      { key: 'more', label: s.more.eyebrow ?? 'More about the group', icon: 'grid', cards: moreCards },
    ]}
    link={{ label: 'Contact', href: '/contact' }}
  />
</SiteLayout>
