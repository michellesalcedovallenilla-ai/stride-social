---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarqueeHero from '@/components/sections/MarqueeHero.astro';
import TalentCard from '@/components/cards/TalentCard.astro';
import CardGrid from '@/components/portfolio/CardGrid.astro';
import { caseStudiesListLd } from '@/components/portfolio/jsonld';
import { footerCtas } from '@/config/site';

const description =
  'Some of our latest user-generated content and social media marketing campaigns, our agency works with the best creators to produce the very best adverts';

const all = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((c) => c.data.featured);
const rest = all.filter((c) => !c.data.featured);
---

<BaseLayout
  title="Stride Social | Case Studies"
  description={description}
  nav="solid"
  background="smoke"
  footerCta={footerCtas.standard}
  jsonLd={[caseStudiesListLd(all, description)]}
>
  <MarqueeHero title="Case studies" intro="Check out how we’ve driven success for clients worldwide." />

  <section class="case-list" aria-label="Case studies">
    <CardGrid layout="hero" label="Featured case studies">
      {featured.map((c) => (
        <li>
          <TalentCard href={`/case-studies/${c.id}`} image={c.data.cardImage} name={c.data.title} tag={c.data.category} metric={c.data.cardMetric} metricLabel="views" />
        </li>
      ))}
    </CardGrid>
    <CardGrid layout="four" label="More case studies">
      {rest.map((c) => (
        <li>
          <TalentCard href={`/case-studies/${c.id}`} image={c.data.cardImage} name={c.data.title} tag={c.data.category} metric={c.data.cardMetric} metricLabel="views" />
        </li>
      ))}
    </CardGrid>
  </section>
</BaseLayout>

<style>
  .case-list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--color-smoke-2);
  }
</style>
