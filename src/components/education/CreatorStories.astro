---
// Stride Education D5 "Creator stories": a rail of real student or creator journeys (portrait,
// name, one-sentence journey). The brief asks for real stories "when provided", so the section is
// left out until a student testimonial with confirmed consent exists. Preview shows a labelled
// note in its place.
import { getCollection } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import PlaceholderNotice from '../core/PlaceholderNotice.astro';
import { isPreview } from '@/lib/env';

export interface Props {
  copy: { eyebrow?: string; headline?: string };
}

const { copy } = Astro.props;
const stories = await getCollection('testimonials', (t) => t.data.type === 'student' && t.data.consent.status === 'confirmed');
---

{(stories.length > 0 || isPreview) && (
  <section class="stories" id="stories" aria-labelledby="stories-title">
    <div class="stories__inner container-wide">
      <header class="stories__head">
        <Eyebrow tone="light">{copy.eyebrow}</Eyebrow>
        <h2 class="stories__title" id="stories-title">{copy.headline}</h2>
      </header>
      {stories.length > 0 ? (
        <ul class="stories__rail" role="list">
          {stories.map((s) => (
            <li class="story">
              {s.data.image && <img class="story__img" src={s.data.image.src} alt="" loading="lazy" />}
              <blockquote class="story__quote">“{s.data.quote}”</blockquote>
              <p class="story__who">{s.data.name}<span>{s.data.role}</span></p>
            </li>
          ))}
        </ul>
      ) : (
        <PlaceholderNotice variant="block" label="Hidden in production until stories exist">
          <p>Real student or creator stories with consent: portrait, name and a one-sentence journey from where they started to where they are now. Add them as testimonials of type "student".</p>
        </PlaceholderNotice>
      )}
    </div>
  </section>
)}

<style>
  .stories {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--white);
    color: var(--navy-900);
    scroll-margin-top: calc(var(--header-h) + var(--division-bar-h));
  }

  .stories__inner {
    display: grid;
    gap: var(--space-7);
  }

  .stories__head {
    display: grid;
    gap: var(--space-4);
  }

  .stories__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .stories__rail {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--gutter);
  }

  .story {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .story__img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .story__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.2;
  }

  .story__who {
    display: grid;
    font-weight: 700;
  }

  .story__who span {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 400;
    text-transform: uppercase;
  }
</style>
