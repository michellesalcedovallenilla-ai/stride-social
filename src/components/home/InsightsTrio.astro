---
// Homepage A8 "Insights": the three latest articles. One large on the left, two stacked on the right.
import { getCollection } from 'astro:content';
import Eyebrow from '../core/Eyebrow.astro';
import Button from '../core/Button.astro';
import { routes } from '@/lib/routes';
import { categoryLabels } from '@/lib/insights';

export interface Props {
  copy: { eyebrow?: string; headline?: string; cta?: { label: string; href: string } };
}

const { copy } = Astro.props;
const categoryLabel = categoryLabels;
const posts = (await getCollection('insights', (p) => p.data.visible && p.data.date !== null))
  .sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<section class="insights" aria-labelledby="insights-title">
  <header class="insights__head">
    <div>
      <Eyebrow>{copy.eyebrow}</Eyebrow>
      <h2 class="insights__title" id="insights-title" data-reveal-lines>{copy.headline}</h2>
    </div>
    {copy.cta && <Button href={copy.cta.href} variant="text">{copy.cta.label}</Button>}
  </header>

  <ul class="insights__grid" role="list">
    {posts.map((p, i) => (
      <li class:list={['article', { 'article--lead': i === 0 }]} data-reveal="rise" style={`--reveal-delay: ${i * 0.08}s`}>
        <a class="article__link" href={routes.article(p.id)}>
          <span class="article__media">
            <img src={p.data.cover.src} alt="" sizes="(max-width: 767px) 100vw, 50vw" loading="lazy" decoding="async" />
          </span>
          <span class="article__body">
            <span class="article__meta">
              <span>{categoryLabel[p.data.category]}</span>
              <time datetime={p.data.date!.toISOString().slice(0, 10)}>{fmt.format(p.data.date!)}</time>
            </span>
            <span class="article__title">{p.data.title}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .insights {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--white);
  }

  .insights__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding: 0 var(--margin) var(--space-8);
  }

  .insights__head > div {
    display: grid;
    gap: var(--space-4);
  }

  .insights__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .insights__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: var(--space-7) var(--gutter);
    max-width: calc(var(--container-wide) + 2 * var(--margin));
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .article {
    grid-column: 8 / -1;
  }

  .article--lead {
    grid-column: 1 / 8;
    grid-row: 1 / span 2;
  }

  .article__link {
    display: grid;
    gap: var(--space-4);
  }

  .article:not(.article--lead) .article__link {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .article__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--line);
  }

  .article--lead .article__media {
    aspect-ratio: 4 / 3;
  }

  .article__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform var(--dur-reveal) var(--ease-out);
  }

  .article__link:hover img {
    transform: scale(1.04);
  }

  .article__body {
    display: grid;
    gap: var(--space-3);
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .article__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: var(--type-h3);
    font-weight: 600;
    line-height: 1.2;
  }

  .article--lead .article__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.8vw, 2.75rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    -webkit-line-clamp: 2;
  }

  .article__link:hover .article__title {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 1023px) {
    .article,
    .article--lead {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 599px) {
    .article:not(.article--lead) .article__link {
      grid-template-columns: 1fr;
    }
  }
</style>
