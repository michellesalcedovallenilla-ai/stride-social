---
// Stride Education D3 "What creators can learn": the seven topics styled like a prospectus
// contents page: number, title, a one-line outcome, a dotted leader and the availability label.
// Topics show only once Stride confirms them (src/lib/education.ts).
import Eyebrow from '../core/Eyebrow.astro';
import DraftTag from '../core/DraftTag.astro';
import Availability from './Availability.astro';
import { getTopics } from '@/lib/education';

export interface Props {
  copy: { eyebrow?: string; headline?: string };
}

const { copy } = Astro.props;
const topics = await getTopics();
const draft = topics.some((t) => t.data.copyStatus !== 'approved');
---

{topics.length > 0 && (
  <section class="topics" id="learn" aria-labelledby="topics-title">
    <div class="topics__inner container-wide">
      <header class="topics__head">
        <Eyebrow tone="light">{copy.eyebrow}</Eyebrow>
        <h2 class="topics__title" id="topics-title" data-reveal-lines>{copy.headline}</h2>
        <DraftTag status={draft ? 'draft' : 'approved'} />
      </header>
      <ol class="topics__list" role="list">
        {topics.map((t, i) => (
          <li class="topic" data-reveal="rise" style={`--reveal-delay: ${(i % 4) * 0.05}s`}>
            <span class="topic__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="topic__text">
              <h3 class="topic__title">{t.data.title}</h3>
              {t.data.summary && <p class="topic__summary">{t.data.summary}</p>}
            </div>
            <span class="topic__leader" aria-hidden="true"></span>
            <span class="topic__status"><Availability status={t.data.status} /></span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .topics {
    position: relative;
    z-index: 1;
    padding: var(--section-pad) 0;
    background: var(--white);
    color: var(--navy-900);
    scroll-margin-top: calc(var(--header-h) + var(--division-bar-h));
  }

  .topics__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8) var(--gutter);
  }

  .topics__head {
    grid-column: 1 / 5;
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
    container-type: inline-size;
  }

  .topics__title {
    font-family: var(--font-display);
    font-size: min(14cqi, 6rem);
    font-weight: 850;
    font-stretch: var(--stretch-wide);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .topics__list {
    grid-column: 6 / -1;
    border-top: 2px solid var(--navy-900);
  }

  .topic {
    display: grid;
    grid-template-columns: 3rem minmax(0, auto) minmax(2rem, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }

  .topic__n {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    color: var(--sun-deep);
  }

  .topic__text {
    display: grid;
    gap: var(--space-1);
  }

  .topic__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.875rem);
    font-weight: 800;
    font-stretch: 108%;
    line-height: 1.1;
  }

  .topic__summary {
    max-width: 52ch;
    color: var(--navy-700);
  }

  /* Prospectus dotted leader between the title and the status. */
  .topic__leader {
    align-self: start;
    height: 1.1em;
    border-bottom: 2px dotted var(--line);
  }

  .topic__status {
    align-self: start;
  }

  @media (max-width: 1023px) {
    .topics__head,
    .topics__list {
      grid-column: 1 / -1;
    }

    .topics__title {
      font-size: min(11cqi, 5rem);
    }
  }

  @media (max-width: 599px) {
    .topic {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }

    .topic__leader {
      display: none;
    }

    .topic__status {
      grid-column: 2;
    }
  }
</style>
