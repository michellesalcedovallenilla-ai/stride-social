---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DetailHero from '@/components/sections/DetailHero.astro';
import CaseStudyBody from '@/components/portfolio/CaseStudyBody.astro';
import QuoteSection from '@/components/portfolio/QuoteSection.astro';
import CampaignVideos from '@/components/portfolio/CampaignVideos.astro';
import MoreCampaigns from '@/components/portfolio/MoreCampaigns.astro';
import { caseStudyLd } from '@/components/portfolio/jsonld';
import { footerCtas } from '@/config/site';

export async function getStaticPaths() {
  const all = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  all: CollectionEntry<'caseStudies'>[];
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// The live template lists the first three non-featured case studies (it also lists the
// current one when it is among them; here it is skipped).
const more = all
  .filter((c) => !c.data.featured && c.id !== entry.id)
  .slice(0, 3)
  .map((c) => ({ href: `/case-studies/${c.id}`, image: c.data.cardImage, name: c.data.title, tag: c.data.category, metric: c.data.cardMetric }));
---

<BaseLayout
  title={data.seo?.title ?? `${data.title} marketing campaign by Stride Social`}
  description={data.seo?.description ?? data.summary}
  ogImage={data.seo?.ogImage ?? data.cardImage}
  nav="solid"
  footerCta={footerCtas.standard}
  jsonLd={[caseStudyLd(entry)]}
>
  <DetailHero tag={data.category} title={data.title} summary={data.summary} />
  <CaseStudyBody image={data.heroImage ?? data.cardImage} stats={data.stats}>
    <Content />
  </CaseStudyBody>
  {data.quote && <QuoteSection quote={data.quote} />}
  {data.videos.length > 0 && <CampaignVideos videos={data.videos} />}
  <MoreCampaigns items={more} />
</BaseLayout>
